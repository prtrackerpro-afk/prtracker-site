---
import "../styles/global.css";
import BottomNav from "../components/admin/BottomNav.astro";
import {
  iconBell,
  iconBox,
  iconChartBar,
  iconGlobe,
  iconLayout,
  iconLogOut,
  iconShoppingBag,
} from "../components/admin/icons";

interface Props {
  title: string;
  active?: "overview" | "meta" | "ga4" | "sales" | "bling" | "tiktok" | "ml" | "alerts" | "settings";
  user?: { email: string };
  alertCount?: number;
}

const { title, active = "overview", user, alertCount = 0 } = Astro.props;

const navItems = [
  { id: "overview", label: "Overview", href: "/admin", icon: iconLayout },
  { id: "meta", label: "Meta Ads", href: "/admin/meta", icon: iconChartBar },
  { id: "ga4", label: "GA4 / Site", href: "/admin/ga4", icon: iconGlobe },
  { id: "sales", label: "Vendas", href: "/admin/sales", icon: iconShoppingBag },
  { id: "bling", label: "Bling", href: "/admin/bling", icon: iconBox },
  { id: "tiktok", label: "TikTok", href: "/admin/tiktok", icon: iconShoppingBag },
  { id: "ml", label: "Mercado Livre", href: "/admin/ml", icon: iconShoppingBag },
  { id: "alerts", label: "Alertas", href: "/admin/alerts", icon: iconBell },
] as const;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · PR Tracker Admin</title>
    <link rel="icon" type="image/png" href="/admin/icon-192.png?v=2" />
    {/* PWA — instalável como app no iPhone via "Adicionar à Tela de Início".
        ?v=N força iOS Safari a invalidar o cache do apple-touch-icon. */}
    <link rel="manifest" href="/admin/manifest.webmanifest?v=2" />
    <meta name="theme-color" content="#01002A" />
    <link rel="apple-touch-icon" href="/admin/apple-touch-icon.png?v=2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PR Admin" />
  </head>
  <body class="admin-shell min-h-screen bg-navy-900 text-white font-body antialiased">
    <div class="flex min-h-screen">
      {/* Desktop sidebar */}
      <aside class="hidden md:flex w-60 flex-col border-r border-navy-700 bg-navy-800/40 backdrop-blur-sm">
        <div class="px-6 pt-7 pb-8">
          <div class="font-display text-2xl tracking-tight text-brand-lime leading-none">PR Tracker</div>
          <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300 mt-1.5">Admin Console</div>
        </div>
        <nav class="flex-1 px-3 space-y-0.5">
          {
            navItems.map((item) => {
              const isActive = active === item.id;
              const showBadge = item.id === "alerts" && alertCount > 0;
              return (
                <a
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition",
                    isActive
                      ? "bg-brand-lime text-navy-900 font-semibold"
                      : "text-navy-200 hover:bg-navy-700/60 hover:text-white",
                  ]}
                >
                  <span class="inline-flex h-4 w-4 items-center justify-center [&>svg]:h-4 [&>svg]:w-4" set:html={item.icon} />
                  <span class="flex-1">{item.label}</span>
                  {showBadge && (
                    <span class="inline-flex min-w-[1.25rem] justify-center rounded-full bg-red-500 px-1.5 text-[10px] font-bold leading-4 text-white">
                      {alertCount > 9 ? "9+" : alertCount}
                    </span>
                  )}
                </a>
              );
            })
          }
        </nav>
        {
          user && (
            <div class="mt-auto border-t border-navy-700 p-4">
              <div class="text-[10px] uppercase tracking-wider text-navy-400 mb-1">Logado como</div>
              <div class="text-sm truncate" title={user.email}>{user.email}</div>
              <button
                id="admin-logout"
                class="mt-3 inline-flex items-center gap-1.5 text-xs text-navy-300 hover:text-brand-lime transition"
                aria-label="Sair"
              >
                <span class="[&>svg]:h-3.5 [&>svg]:w-3.5" set:html={iconLogOut} />
                <span>Sair</span>
              </button>
            </div>
          )
        }
      </aside>

      {/* Main content */}
      <main class="flex-1 min-w-0 flex flex-col pb-20 md:pb-0">
        {/* Mobile top bar — minimal, just the wordmark + alert pip */}
        <header
          class="md:hidden flex items-center justify-between px-4 py-3 border-b border-navy-700/80 bg-navy-900/95 backdrop-blur sticky top-0 z-20"
          style="padding-top: max(0.75rem, env(safe-area-inset-top));"
        >
          <div class="font-display text-lg leading-none tracking-tight text-brand-lime">PR Tracker</div>
          <div class="flex items-center gap-3">
            {alertCount > 0 && (
              <a href="/admin/alerts" class="relative inline-flex p-1 text-navy-200" aria-label={`${alertCount} alertas abertos`}>
                <span class="[&>svg]:h-5 [&>svg]:w-5" set:html={iconBell} />
                <span class="absolute -right-0.5 -top-0.5 inline-flex min-w-[1rem] justify-center rounded-full bg-red-500 px-1 text-[9px] font-bold leading-4 text-white">
                  {alertCount > 9 ? "9+" : alertCount}
                </span>
              </a>
            )}
            <button
              id="admin-logout-mobile"
              class="inline-flex p-1 text-navy-300 hover:text-brand-lime transition"
              aria-label="Sair"
            >
              <span class="[&>svg]:h-5 [&>svg]:w-5" set:html={iconLogOut} />
            </button>
          </div>
        </header>

        <div class="flex-1 px-4 py-5 md:px-8 md:py-8 max-w-[1600px] w-full mx-auto">
          <slot />
        </div>
      </main>
    </div>

    <BottomNav active={active} alertCount={alertCount} />

    <script>
      function bindLogout(id: string) {
        const btn = document.getElementById(id);
        if (!btn) return;
        btn.addEventListener("click", async () => {
          try {
            await fetch("/api/admin/logout", { method: "POST" });
          } catch {}
          window.location.href = "/admin/login";
        });
      }
      bindLogout("admin-logout");
      bindLogout("admin-logout-mobile");
    </script>

    <style is:global>
      /* Admin scope: brand global rule sets navy color + uppercase on h1-h6,
         which collides with the dark navy admin background. Reset to inherit
         from parent (white) and let Tailwind classes drive size/weight. */
      .admin-shell :is(h1, h2, h3, h4, h5, h6) {
        color: inherit;
        text-transform: none;
        letter-spacing: -0.01em;
        line-height: 1.25;
      }
    </style>
  </body>
</html>

<script>
  import { cart } from "~/scripts/cart";
  import { trackAddToCart } from "~/scripts/tracking";
  import { formatBRL, applyPix } from "~/lib/format";
  import type { PlateSpec, PlateId, BoardColorOption, BoardExerciseOption } from "~/lib/catalog";

  interface CfgData {
    slug: string;
    title: string;
    image: string;
    basePriceCents: number;
    exerciseCount: 2 | 3;
    defaultExercises: string[];
    category?: string;
    plates: PlateSpec[];
    exercises: BoardExerciseOption[];
    colors: BoardColorOption[];
    barbellWeightKg: number;
    maxSideSpaceMm: number;
  }

  const roots = document.querySelectorAll<HTMLElement>("[data-board-configurator]");
  roots.forEach((root) => init(root));

  function init(root: HTMLElement): void {
    if (root.dataset.cfgInit === "1") return;
    root.dataset.cfgInit = "1";

    const config = JSON.parse(root.dataset.config!) as CfgData;
    const platesById = new Map<string, PlateSpec>(config.plates.map((p) => [p.id, p]));

    // State
    let selectedColor = config.colors[0]!.value;
    const exercises: string[] = config.defaultExercises.slice(0, config.exerciseCount);
    // platesState[barbellIndex][plateId] = pairs
    const platesState: Array<Record<string, number>> = Array.from(
      { length: config.exerciseCount },
      () => Object.fromEntries(config.plates.map((p) => [p.id, 0])),
    );

    // --- Tabs (mobile) ---------------------------------------------------
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
    const cablesEl = root.querySelector<SVGSVGElement>(".bcfg__cables");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        maybeShowTour();
        const target = tab.dataset.tab;
        tabs.forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
        panels.forEach((p) => p.setAttribute("data-active", p.dataset.panel === target ? "true" : "false"));
        // Atualiza qual cabo de luz está aceso (sync com tab ativa)
        if (target) cablesEl?.setAttribute("data-cable-active", target);
      });
    });

    // --- Onboarding tour (uma vez por cliente) ---------------------------
    // Dispara no PRIMEIRO clique em tab OU dropdown de exercício. Persiste
    // em localStorage pra não repetir em visitas futuras.
    const TOUR_KEY = "bcfg-tour-seen";
    const tourEl = root.querySelector<HTMLElement>("[data-tour]");
    const tourDismiss = root.querySelector<HTMLButtonElement>("[data-tour-dismiss]");
    let tourSeen = false;
    try {
      tourSeen = localStorage.getItem(TOUR_KEY) === "1";
    } catch {
      // localStorage indisponível (private mode): trata como "já visto"
      // pra não bloquear o usuário com popup que não persiste.
      tourSeen = true;
    }
    function maybeShowTour(): void {
      if (tourSeen || !tourEl) return;
      tourEl.hidden = false;
      // Foca o botão dismiss pra acessibilidade (Enter fecha o popup).
      setTimeout(() => tourDismiss?.focus(), 50);
    }
    function dismissTour(): void {
      if (!tourEl) return;
      tourEl.hidden = true;
      tourSeen = true;
      try {
        localStorage.setItem(TOUR_KEY, "1");
      } catch {
        // Falha silenciosa — popup não vai persistir mas o usuário
        // não vai ver de novo nesta sessão.
      }
    }
    tourDismiss?.addEventListener("click", dismissTour);
    // Click no overlay (área escura, fora do card) também fecha
    tourEl?.addEventListener("click", (ev) => {
      if (ev.target === tourEl) dismissTour();
    });
    // ESC pra fechar
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && tourEl && !tourEl.hidden) dismissTour();
    });

    // --- Color picker ----------------------------------------------------
    const colorButtons = root.querySelectorAll<HTMLButtonElement>("[data-color]");
    const previewBg = root.querySelector<SVGRectElement>("[data-preview-bg]");
    const labelBgs = root.querySelectorAll<SVGRectElement>("[data-preview-label-bg]");

    colorButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const value = btn.dataset.color!;
        const opt = config.colors.find((c) => c.value === value)!;
        selectedColor = opt.value;
        colorButtons.forEach((b) => b.setAttribute("aria-checked", b === btn ? "true" : "false"));
        if (previewBg) previewBg.setAttribute("fill", opt.hex);
        labelBgs.forEach((bg) => {
          // Em fundos pretos: label bg permanece preto. Em outros: label bg
          // mais escuro/contraste alto. Mantém #111111 sempre — funciona em
          // cobre e rosa, e em preto vira moldura sutil.
          bg.setAttribute("fill", opt.value === "preto" ? "#000000" : "#111111");
        });
      });
    });

    // --- Exercise selectors ---------------------------------------------
    const exSelects = root.querySelectorAll<HTMLSelectElement>("[data-exercise-select]");

    function syncExerciseLabel(idx: number, value: string): void {
      const ex = config.exercises.find((e) => e.value === value);
      if (!ex) return;
      // Label físico (text dentro do retângulo preto na placa preview).
      // Label = value em ALL CAPS (cliente escolhe o termo que será
      // impresso). Crossfitter pega "Back Squat" → "BACK SQUAT" no board.
      // Halterofilista pega "Agachamento" → "AGACHAMENTO".
      const preview = root.querySelector<SVGTextElement>(`[data-preview-exercise="${idx}"]`);
      if (preview) preview.textContent = ex.value.toUpperCase();
      // Atualiza o nome do exercício na tab mobile correspondente.
      const tabEx = root.querySelector<HTMLElement>(`[data-tab-exercise="${idx}"]`);
      if (tabEx) tabEx.textContent = ex.value;
    }

    exSelects.forEach((sel) => {
      const idx = Number(sel.dataset.index);
      sel.addEventListener("change", () => {
        exercises[idx] = sel.value;
        syncExerciseLabel(idx, sel.value);
      });
      // Dispara o tour no primeiro toque/clique no dropdown ANTES do
      // picker nativo abrir, pra usuário ver as instruções primeiro.
      sel.addEventListener("pointerdown", maybeShowTour);
      sel.addEventListener("focus", maybeShowTour);
      // Initial sync (em caso de hidratação/SSR)
      syncExerciseLabel(idx, sel.value);
    });

    // --- Plate selectors --------------------------------------------------
    const plateSelects = root.querySelectorAll<HTMLSelectElement>("[data-plate-select]");
    plateSelects.forEach((sel) => {
      sel.addEventListener("change", () => {
        const bi = Number(sel.dataset.barbell);
        const pid = sel.dataset.plateId!;
        platesState[bi]![pid] = Math.max(
          0,
          Math.min(Number(sel.value), platesById.get(pid)!.maxPairs),
        );
        render();
      });
    });

    // --- Buttons ----------------------------------------------------------
    const totalPriceEl = root.querySelector<HTMLElement>("[data-total-price]")!;
    const pixPriceEl = root.querySelector<HTMLElement>("[data-pix-price]")!;
    const installmentPriceEl = root.querySelector<HTMLElement>("[data-installment-price]")!;
    const addBtn = root.querySelector<HTMLButtonElement>("[data-add-btn]")!;

    const NS = "http://www.w3.org/2000/svg";
    const platesOrderedDesc = [...config.plates].sort((a, b) => b.kg - a.kg);

    function renderPreviewPlates(barbellIdx: number): void {
      const leftGroup = root.querySelector<SVGGElement>(`[data-preview-plates-left="${barbellIdx}"]`);
      const rightGroup = root.querySelector<SVGGElement>(`[data-preview-plates-right="${barbellIdx}"]`);
      if (leftGroup && rightGroup) {
        drawPreviewSide(leftGroup, barbellIdx, "left");
        drawPreviewSide(rightGroup, barbellIdx, "right");
      }
      // Renderiza também o barbell SVG do painel (vista frontal da barra
      // com anilhas, separado da preview da placa inteira).
      const panelLeft = root.querySelector<SVGGElement>(`[data-panel-plates-left="${barbellIdx}"]`);
      const panelRight = root.querySelector<SVGGElement>(`[data-panel-plates-right="${barbellIdx}"]`);
      if (panelLeft && panelRight) {
        drawPanelSide(panelLeft, barbellIdx, "left");
        drawPanelSide(panelRight, barbellIdx, "right");
      }
    }

    /**
     * Renderiza as anilhas no barbell SVG do painel (vista frontal grande).
     * Escala diferente da preview da placa (mais espaço, mais detalhe).
     * Espelha o estilo do My PR Gym (TripleBarbellConfigurator).
     */
    function drawPanelSide(group: SVGGElement, barbellIdx: number, side: "left" | "right"): void {
      while (group.firstChild) group.removeChild(group.firstChild);
      // Escala generosa pro panel (viewBox 600x200, espaço pra plates):
      // 1mm = 3.2px → 25kg = 8mm = 25.6px wide. PLATE_DIAMETER 90px.
      const pxPerMm = 3.2;
      const PLATE_DIAMETER_PX = 90;
      const HUB_HEIGHT_PX = 12;
      const direction = side === "left" ? -1 : 1;
      let offset = 0;
      let cumulativeMm = 0;
      for (const p of platesOrderedDesc) {
        const pairs = platesState[barbellIdx]?.[p.id] ?? 0;
        if (!pairs) continue;
        for (let i = 0; i < pairs; i++) {
          if (cumulativeMm + p.thicknessMm > config.maxSideSpaceMm) break;
          const widthPx = p.thicknessMm * pxPerMm;
          const x = side === "left" ? offset - widthPx : offset;
          const rect = document.createElementNS(NS, "rect");
          rect.setAttribute("x", String(x));
          rect.setAttribute("y", String(-PLATE_DIAMETER_PX / 2));
          rect.setAttribute("width", String(widthPx));
          rect.setAttribute("height", String(PLATE_DIAMETER_PX));
          rect.setAttribute("rx", "3");
          rect.setAttribute("fill", p.color);
          rect.setAttribute("stroke", "#01002a");
          rect.setAttribute("stroke-width", "1");
          group.appendChild(rect);
          const hub = document.createElementNS(NS, "rect");
          hub.setAttribute("x", String(x));
          hub.setAttribute("y", String(-HUB_HEIGHT_PX / 2));
          hub.setAttribute("width", String(widthPx));
          hub.setAttribute("height", String(HUB_HEIGHT_PX));
          hub.setAttribute("fill", "#1a1c22");
          group.appendChild(hub);
          offset += direction * widthPx;
          cumulativeMm += p.thicknessMm;
        }
      }
    }

    function drawPreviewSide(group: SVGGElement, barbellIdx: number, side: "left" | "right"): void {
      while (group.firstChild) group.removeChild(group.firstChild);
      // Calibrado pelas fotos do produto real:
      //   Anilha física ~30mm diâmetro × 8mm espessura (25kg) → ratio ~3.75:1.
      //   No preview, mantemos ~4:1: PLATE_DIAMETER 32px, pxPerMm 1.0
      //   (25kg = 8mm = 8px wide). Hub 4px (mais fino que antes).
      const pxPerMm = 1.0;
      const PLATE_DIAMETER_PX = 32;
      const HUB_HEIGHT_PX = 3.5;
      const direction = side === "left" ? -1 : 1;
      let offset = 0;
      let cumulativeMm = 0;
      for (const p of platesOrderedDesc) {
        const pairs = platesState[barbellIdx]?.[p.id] ?? 0;
        if (!pairs) continue;
        for (let i = 0; i < pairs; i++) {
          if (cumulativeMm + p.thicknessMm > config.maxSideSpaceMm) break;
          const widthPx = p.thicknessMm * pxPerMm;
          const x = side === "left" ? offset - widthPx : offset;
          // Anilha (corpo colorido) — face circular vista de lado
          const rect = document.createElementNS(NS, "rect");
          rect.setAttribute("x", String(x));
          rect.setAttribute("y", String(-PLATE_DIAMETER_PX / 2));
          rect.setAttribute("width", String(widthPx));
          rect.setAttribute("height", String(PLATE_DIAMETER_PX));
          rect.setAttribute("rx", "1.2");
          rect.setAttribute("fill", p.color);
          rect.setAttribute("stroke", "#01002a");
          rect.setAttribute("stroke-width", "0.6");
          group.appendChild(rect);
          // Hub central (faixa escura onde a barra atravessa)
          const hub = document.createElementNS(NS, "rect");
          hub.setAttribute("x", String(x));
          hub.setAttribute("y", String(-HUB_HEIGHT_PX / 2));
          hub.setAttribute("width", String(widthPx));
          hub.setAttribute("height", String(HUB_HEIGHT_PX));
          hub.setAttribute("fill", "#1a1c22");
          group.appendChild(hub);
          offset += direction * widthPx;
          cumulativeMm += p.thicknessMm;
        }
      }
    }

    function render(): void {
      let platesCents = 0;
      let anyOverLimit = false;
      for (let i = 0; i < config.exerciseCount; i++) {
        let bbKg = config.barbellWeightKg;
        let bbSpace = 0;
        let bbCents = 0;
        for (const p of config.plates) {
          const pairs = platesState[i]![p.id] ?? 0;
          bbKg += pairs * 2 * p.kg;
          bbSpace += pairs * p.thicknessMm;
          bbCents += pairs * p.pricePerPairCents;
        }
        platesCents += bbCents;
        const overLimit = bbSpace > config.maxSideSpaceMm;
        anyOverLimit = anyOverLimit || overLimit;
        const kgText = bbKg % 1 === 0 ? `${bbKg}` : bbKg.toFixed(2);
        const kgEl = root.querySelector<HTMLElement>(`[data-barbell-kg="${i}"]`);
        const warnEl = root.querySelector<HTMLElement>(`[data-barbell-warn="${i}"]`);
        const tabWeight = root.querySelector<HTMLElement>(`[data-tab-weight="${i}"]`);
        if (kgEl) kgEl.textContent = kgText;
        if (warnEl) warnEl.hidden = !overLimit;
        if (tabWeight) tabWeight.textContent = `${kgText} kg`;
        renderPreviewPlates(i);
      }
      const total = config.basePriceCents + platesCents;
      totalPriceEl.textContent = formatBRL(total);
      pixPriceEl.textContent = formatBRL(applyPix(total));
      installmentPriceEl.textContent = formatBRL(Math.round(total / 3));
    }

    addBtn.addEventListener("click", () => {
      // Build cart payload
      const barbells = exercises.map((ex, i) => ({
        exercise: ex,
        plates: Object.entries(platesState[i]!)
          .filter(([, pairs]) => pairs > 0)
          .map(([plateId, pairs]) => ({ plateId: plateId as PlateId, pairs })),
      }));
      let platesCents = 0;
      for (const bb of barbells) {
        for (const p of bb.plates) {
          platesCents += p.pairs * platesById.get(p.plateId)!.pricePerPairCents;
        }
      }
      const unitPriceCents = config.basePriceCents + platesCents;

      const colorOpt = config.colors.find((c) => c.value === selectedColor)!;
      const exDesc = barbells.map((bb) => bb.exercise).join(" / ");
      const fullTitle = `${config.title} — ${colorOpt.label} · ${exDesc}`;

      const id = buildCartId(config.slug, selectedColor, barbells);
      cart.add({
        id,
        productSlug: config.slug,
        title: fullTitle,
        image: config.image,
        unitPriceCents,
        quantity: 1,
        boardColor: selectedColor as "cobre" | "preto" | "rosa",
        boardBarbells: barbells,
      });
      trackAddToCart({
        slug: config.slug,
        title: fullTitle,
        unitPriceCents,
        quantity: 1,
        category: config.category,
      });
    });

    render();
  }

  function buildCartId(
    slug: string,
    color: string,
    barbells: Array<{ exercise: string; plates: Array<{ plateId: string; pairs: number }> }>,
  ): string {
    const bbKey = barbells
      .map((bb) => {
        const pk = bb.plates
          .slice()
          .sort((a, b) => a.plateId.localeCompare(b.plateId))
          .map((p) => `${p.plateId}x${p.pairs}`)
          .join("|");
        return `${bb.exercise}@${pk}`;
      })
      .join(">>");
    return [slug, color, bbKey].filter(Boolean).join("::");
  }
</script>

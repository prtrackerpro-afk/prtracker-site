---
/**
 * Configurador do "PR Tracker Board" — 2 ou 3 exercícios independentes.
 *
 * UX:
 *   1. Color picker (Cobre/Preto/Rosa) — Cobre default. Aplica no preview.
 *   2. N dropdowns de exercício (`BOARD_EXERCISES`, com bilíngue para os
 *      termos PT-BR — Arranco/Arremesso). Defaults vêm de
 *      `boardDefaultExercises` no JSON do produto (top→bottom).
 *   3. N barras independentes (mesmo configurador do BarbellConfigurator,
 *      simplificado): selectors de pares por anilha, SVG da barra,
 *      preço por barra somado no preço total.
 *
 * Preço final = `priceBase` + soma das anilhas de todas as barras.
 * Limite físico (45mm por lado) aplicado por barra.
 */
import {
  PLATES,
  BOARD_EXERCISES,
  BOARD_COLORS,
  BARBELL_WEIGHT_KG,
  MAX_SIDE_SPACE_MM,
} from "~/lib/catalog";
import { formatBRL, applyPix } from "~/lib/format";

interface Props {
  slug: string;
  title: string;
  image: string;
  basePriceCents: number;
  exerciseCount: 2 | 3;
  defaultExercises: string[];
  category?: string;
  /**
   * Restringe o dropdown de cada slot a um subconjunto. Se omitido (ou
   * undefined para um slot), o slot usa a lista completa BOARD_EXERCISES.
   */
  exerciseChoices?: (string[] | undefined)[];
  /** Quando true, esconde os dropdowns — exercícios são fixos. */
  exercisesFixed?: boolean;
}

const {
  slug,
  title,
  image,
  basePriceCents,
  exerciseCount,
  defaultExercises,
  category,
  exerciseChoices,
  exercisesFixed = false,
} = Astro.props;

const indices = Array.from({ length: exerciseCount }, (_, i) => i);

/** Filtra BOARD_EXERCISES por `value` mantendo a ordem alfabética. */
function optionsForSlot(i: number) {
  const allowed = exerciseChoices?.[i];
  if (!allowed || allowed.length === 0) return BOARD_EXERCISES;
  return BOARD_EXERCISES.filter((ex) => allowed.includes(ex.value));
}

const CONFIG_JSON = JSON.stringify({
  slug,
  title,
  image,
  basePriceCents,
  exerciseCount,
  defaultExercises,
  category,
  plates: PLATES,
  exercises: BOARD_EXERCISES,
  colors: BOARD_COLORS,
  barbellWeightKg: BARBELL_WEIGHT_KG,
  maxSideSpaceMm: MAX_SIDE_SPACE_MM,
});
---

<div class="bcfg" data-board-configurator data-config={CONFIG_JSON}>
  <!-- Preview: placa colorida espelhando o produto real. Cada row é uma
       UNIDADE com label preto no TOPO + barbell horizontal EMBAIXO do
       label (não atrás). As anilhas estendem-se pra fora das bordas da
       placa, exatamente como na foto do produto físico. -->
  <div class="bcfg__preview">
    <svg
      viewBox="-32 0 384 380"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Preview do PR Tracker Board"
      data-preview-svg
    >
      <rect
        x="0"
        y="0"
        width="320"
        height="380"
        rx="14"
        fill="#B87333"
        data-preview-bg
      />
      <!-- Logo PR Tracker no topo da placa (asset oficial branco) -->
      <image
        href="/images/brand/logo-pr-tracker-branco.svg"
        x="100"
        y="22"
        width="120"
        height="34"
        preserveAspectRatio="xMidYMid meet"
      />
      <!-- Fallback: se o asset não carregar (env sem assets), o ::before
           do CSS desenha um placeholder. Em produção sempre carrega. -->


      {indices.map((i) => {
        // Posição Y do TOPO de cada row. Layout calibrado pela proporção
        // do produto real: label 28h + gap 24px + plates 32h = 84px por row.
        const rowTop = exerciseCount === 3 ? 90 + i * 95 : 112 + i * 120;
        const labelH = 28;
        // Centro vertical da barra abaixo do label.
        const barY = rowTop + labelH + 24;
        return (
          <g data-preview-row={String(i)}>
            {/* Label preto centralizado — só nome do exercício */}
            <rect
              x="60"
              y={rowTop}
              width="200"
              height={labelH}
              rx="2.5"
              fill="#111111"
              data-preview-label-bg={String(i)}
            />
            <text
              x="160"
              y={rowTop + 19.5}
              text-anchor="middle"
              font-family="Archivo Black, Inter, sans-serif"
              font-size="12"
              font-weight="900"
              fill="#FFFFFF"
              letter-spacing="0.7"
              data-preview-exercise={String(i)}
            >{(defaultExercises[i] ?? "EXERCÍCIO").toUpperCase()}</text>

            {/* Barbell shaft — fino, com gradient subtil pra dar volume */}
            <rect x="6"   y={barY - 1.2} width="308" height="2.4" rx="0.4" fill="#8e94a0" />
            <rect x="6"   y={barY - 1.2} width="308" height="0.8" fill="#c4c8cf" />
            {/* End caps (tip do bar) */}
            <rect x="2"   y={barY - 2.2} width="4"   height="4.4" rx="0.5" fill="#3e434b" />
            <rect x="314" y={barY - 2.2} width="4"   height="4.4" rx="0.5" fill="#3e434b" />
            {/* Collar/holder em PLA (preto) — segura a barra na placa, igual produto real */}
            <rect x="58"  y={barY - 5}   width="6"   height="10" fill="#1a1c22" />
            <rect x="256" y={barY - 5}   width="6"   height="10" fill="#1a1c22" />

            {/* Plate groups: esquerda ancorada x=58 (junto ao collar), direita x=262.
                Crescem em direção OPOSTA (pra fora). Anilhas além de x=0 ou x=320
                aparecem no canvas extra do viewBox (-32 a 352). */}
            <g data-preview-plates-left={String(i)}  transform={`translate(58, ${barY})`}></g>
            <g data-preview-plates-right={String(i)} transform={`translate(262, ${barY})`}></g>
          </g>
        );
      })}
    </svg>
  </div>

  <!-- Color picker -->
  <div class="bcfg__colors" role="radiogroup" aria-label="Cor da placa">
    <span class="bcfg__field-label">Cor</span>
    <div class="bcfg__colors-row">
      {BOARD_COLORS.map((c, i) => (
        <button
          type="button"
          class="bcfg__color"
          role="radio"
          aria-checked={i === 0 ? "true" : "false"}
          data-color={c.value}
          aria-label={c.label}
          title={c.label}
        >
          <span class="bcfg__color-swatch" style={`background:${c.hex}`}></span>
          <span class="bcfg__color-label">{c.label}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- MOBILE TABS — visíveis abaixo de 900 px (mesmo padrão do My PR Gym).
       Cada linha é UMA BARRA configurável. Cliente toca pra abrir o
       painel daquela barra e editar exercício + anilhas. -->
  <div class="bcfg__tabs-block">
    <div class="bcfg__tabs-header">
      <span class="bcfg__field-label bcfg__field-label--light">
        Suas {exerciseCount} barras
      </span>
      <span class="bcfg__tabs-hint">Toque para editar cada uma</span>
    </div>
    <div class="bcfg__tabs-wrap">
      {/* Cabos físicos — SVG estende ABAIXO dos tabs e entra na área do
          painel (overflow visible + height extra). Cada cabo sai do left
          edge da tab, curva pra esquerda na lane, desce vertical, curva
          de volta no topo do painel. Só o ATIVO está aceso (lime + neon
          glow); inativos ficam navy translúcido com stroke mais grosso. */}
      <svg
        class="bcfg__cables"
        viewBox={exerciseCount === 3 ? "0 0 100 305" : "0 0 100 290"}
        preserveAspectRatio="none"
        data-cable-active="0"
        aria-hidden="true"
      >
        <defs>
          <filter id="bcfg-cable-glow" x="-150%" y="-150%" width="400%" height="400%">
            <feGaussianBlur stdDeviation="4.5" result="blur-outer" />
            <feGaussianBlur in="SourceGraphic" stdDeviation="1.8" result="blur-inner" />
            <feMerge>
              <feMergeNode in="blur-outer" />
              <feMergeNode in="blur-outer" />
              <feMergeNode in="blur-inner" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        {exerciseCount === 3 ? (
          <>
            {/* Cabos 3 ex — convergem em y=295 (panel head / badge area).
                Cabo 1 lane externa (x=12), 2 meio (x=30), 3 interna (x=48). */}
            <path class="bcfg__cable" data-cable="0" d="M 100 35 L 35 35 Q 12 35 12 55 L 12 275 Q 12 295 35 295 L 100 295" />
            <path class="bcfg__cable" data-cable="1" d="M 100 105 L 50 105 Q 30 105 30 125 L 30 275 Q 30 295 50 295 L 100 295" />
            <path class="bcfg__cable" data-cable="2" d="M 100 175 L 70 175 Q 48 175 48 195 L 48 275 Q 48 295 70 295 L 100 295" />
            {/* Plugs: cada cabo termina num círculo "lâmpada" na borda direita.
                Apenas o do cabo ativo brilha lime; outros ficam navy translúcido. */}
            <circle class="bcfg__cable-tip" data-cable-tip="0" cx="98" cy="295" r="5" />
            <circle class="bcfg__cable-tip" data-cable-tip="1" cx="98" cy="295" r="5" />
            <circle class="bcfg__cable-tip" data-cable-tip="2" cx="98" cy="295" r="5" />
          </>
        ) : (
          <>
            <path class="bcfg__cable" data-cable="0" d="M 100 55 L 35 55 Q 12 55 12 75 L 12 260 Q 12 280 35 280 L 100 280" />
            <path class="bcfg__cable" data-cable="1" d="M 100 145 L 60 145 Q 35 145 35 165 L 35 260 Q 35 280 60 280 L 100 280" />
            <circle class="bcfg__cable-tip" data-cable-tip="0" cx="98" cy="280" r="5" />
            <circle class="bcfg__cable-tip" data-cable-tip="1" cx="98" cy="280" r="5" />
          </>
        )}
      </svg>

      <div class="bcfg__tabs" role="tablist" aria-label="Selecionar barra">
        {indices.map((i) => (
          <button
            type="button"
            role="tab"
            class="bcfg__tab"
            data-tab={String(i)}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`bcfg-panel-${i}`}
            id={`bcfg-tab-${i}`}
          >
            <span class="bcfg__tab-pos">{i + 1}</span>
            <span class="bcfg__tab-meta">
              <span class="bcfg__tab-exercise" data-tab-exercise={String(i)}>{defaultExercises[i] ?? `Barra ${i + 1}`}</span>
              <span class="bcfg__tab-weight" data-tab-weight={String(i)}>{BARBELL_WEIGHT_KG} kg</span>
            </span>
            {/* Indicador visual: chevron quando inativo, "editando" quando ativo */}
            <span class="bcfg__tab-action" aria-hidden="true">
              <span class="bcfg__tab-action-edit">editando</span>
              <svg class="bcfg__tab-action-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- PANELS: 1 por barra. Cada panel contém:
       1. Dropdown do exercício no topo
       2. Barbell SVG com anilhas dinâmicas
       3. Grade de seletores de anilhas
       Desktop: panels empilhados verticalmente.
       Mobile: só o panel ativo aparece (controlado pelos tabs acima). -->
  <div class="bcfg__panels">
    {indices.map((i) => (
      <section
        class="bcfg__panel"
        data-panel={String(i)}
        id={`bcfg-panel-${i}`}
        role="tabpanel"
        aria-labelledby={`bcfg-tab-${i}`}
        data-active={i === 0 ? "true" : "false"}
      >
        <header class="bcfg__panel-head">
          <span class="bcfg__panel-pos">{i + 1}</span>
          {exercisesFixed ? (
            <span class="bcfg__panel-exercise-fixed">
              {defaultExercises[i] ?? `Barra ${i + 1}`}
            </span>
          ) : (
            <select
              class="bcfg__panel-exercise-select"
              data-exercise-select
              data-index={String(i)}
              aria-label={`Exercício ${i + 1}`}
            >
              {optionsForSlot(i).map((ex) => (
                <option
                  value={ex.value}
                  selected={ex.value === defaultExercises[i] ? true : undefined}
                >{ex.label}</option>
              ))}
            </select>
          )}
          <p class="bcfg__panel-weight">
            <span data-barbell-kg={String(i)}>{BARBELL_WEIGHT_KG}</span><span class="bcfg__panel-weight-unit"> kg</span>
          </p>
        </header>

        <!-- Barbell SVG da barra dessa seção (separado da preview da placa).
             Plates renderizados dinamicamente via JS. -->
        <div class="bcfg__panel-barbell">
          <svg
            viewBox="0 0 600 200"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label={`Barra olímpica configurada para barra ${i + 1}`}
            data-panel-svg={String(i)}
          >
            <defs>
              <linearGradient id={`bcfg-shaft-${i}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#E4E8ED" />
                <stop offset="50%" stop-color="#B0B6BF" />
                <stop offset="100%" stop-color="#7A7F88" />
              </linearGradient>
              <linearGradient id={`bcfg-sleeve-${i}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#D5D9E0" />
                <stop offset="50%" stop-color="#9AA0AA" />
                <stop offset="100%" stop-color="#5A5F68" />
              </linearGradient>
            </defs>
            <rect x="156" y="94" width="288" height="12" rx="3" fill={`url(#bcfg-shaft-${i})`} />
            <rect x="36"  y="89" width="120" height="22" rx="3" fill={`url(#bcfg-sleeve-${i})`} />
            <rect x="444" y="89" width="120" height="22" rx="3" fill={`url(#bcfg-sleeve-${i})`} />
            <rect x="152" y="85" width="8" height="30" rx="1.5" fill="#3E434B" />
            <rect x="440" y="85" width="8" height="30" rx="1.5" fill="#3E434B" />
            <rect x="30"  y="90" width="8" height="20" rx="1.5" fill="#2C3036" />
            <rect x="562" y="90" width="8" height="20" rx="1.5" fill="#2C3036" />
            <g data-panel-plates-left={String(i)}  transform="translate(156, 100)"></g>
            <g data-panel-plates-right={String(i)} transform="translate(444, 100)"></g>
          </svg>
        </div>

        <div class="bcfg__plates" role="group" aria-label={`Anilhas — barra ${i + 1}`}>
          {PLATES.map((plate) => (
            <label class="bcfg__plate">
              <span class="bcfg__plate-dot" style={`background:${plate.color}`} aria-hidden="true"></span>
              <span class="bcfg__plate-kg">{plate.label}</span>
              <select
                class="bcfg__plate-select"
                data-plate-select
                data-barbell={String(i)}
                data-plate-id={plate.id}
                aria-label={`${plate.label} na barra ${i + 1}`}
              >
                {Array.from({ length: plate.maxPairs + 1 }, (_, n) => (
                  <option value={n}>{n}p</option>
                ))}
              </select>
            </label>
          ))}
        </div>

        <p class="bcfg__warn" data-barbell-warn={String(i)} hidden>Espaço esgotado nesta barra</p>
      </section>
    ))}
  </div>

  <!-- Buy block -->
  <div class="bcfg__buy">
    <div class="bcfg__price">
      <div class="bcfg__price-main" data-total-price>{formatBRL(basePriceCents)}</div>
      <div class="bcfg__price-pix">
        <span class="pix-badge">Pix</span>
        <span data-pix-price class="bcfg__price-pix-value">{formatBRL(applyPix(basePriceCents))}</span>
        <span class="bcfg__price-pix-label">5 % OFF</span>
      </div>
      <div class="bcfg__price-installments">
        ou 3× de <span data-installment-price>{formatBRL(Math.round(basePriceCents / 3))}</span> sem juros
      </div>
    </div>
    <button type="button" class="btn btn-primary btn-lg w-full" data-add-btn>
      Adicionar ao carrinho
    </button>
    <p class="bcfg__ship">Envio para todo o Brasil com rastreio</p>
  </div>

  <!-- Onboarding tour — dispara no PRIMEIRO clique em tab ou dropdown
       de exercício. Persiste em localStorage (bcfg-tour-seen=1) pra não
       repetir. Card centralizado com 3 instruções curtas + dismiss. -->
  <div class="bcfg__tour" data-tour hidden role="dialog" aria-modal="true" aria-labelledby="bcfg-tour-title">
    <div class="bcfg__tour-card" role="document">
      <span class="bcfg__tour-kicker">Como configurar</span>
      <h3 id="bcfg-tour-title" class="bcfg__tour-title">
        Monte cada barra<br />do seu jeito
      </h3>
      <ol class="bcfg__tour-steps">
        <li>
          <span class="bcfg__tour-step-n">1</span>
          <div class="bcfg__tour-step-text">
            <strong>Escolha o exercício</strong>
            <span>Português ou inglês — o nome vai impresso na placa.</span>
          </div>
        </li>
        <li>
          <span class="bcfg__tour-step-n">2</span>
          <div class="bcfg__tour-step-text">
            <strong>Monte a barra</strong>
            <span>Adicione anilhas — o peso atualiza ao vivo.</span>
          </div>
        </li>
        <li>
          <span class="bcfg__tour-step-n">3</span>
          <div class="bcfg__tour-step-text">
            <strong>Repita</strong>
            <span>Toque nas outras barras pra editar cada uma.</span>
          </div>
        </li>
      </ol>
      <button type="button" class="bcfg__tour-dismiss" data-tour-dismiss>
        Entendi
      </button>
    </div>
  </div>
</div>

<style>
  .bcfg {
    /* `position: relative` ancora o tour popup dentro do componente
       (overlay cobre só a viewport relativa do componente, não a tela
       inteira — fica menos invasivo). */
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid rgb(1 0 42 / 0.1);
    border-radius: var(--radius-card);
    background: var(--color-paper);
  }
  @media (min-width: 640px) { .bcfg { padding: 2rem; } }

  .bcfg__preview {
    background: var(--color-brand-white);
    border: 1px solid rgb(1 0 42 / 0.08);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    justify-content: center;
  }
  .bcfg__preview svg {
    width: 100%;
    max-width: 280px;
    height: auto;
    display: block;
  }

  .bcfg__field-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-brand-navy);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }
  .bcfg__field-label::before { content: "// "; color: var(--color-brand-gray); }
  /* Variante leve do label, usada no header dos tabs (mais sutil que o normal) */
  .bcfg__field-label--light {
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .bcfg__colors-row {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .bcfg__color {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem 0.4rem 0.4rem;
    border: 1.5px solid rgb(1 0 42 / 0.15);
    border-radius: var(--radius-card);
    background: var(--color-brand-white);
    cursor: pointer;
    transition: border-color 150ms ease, transform 120ms ease, box-shadow 120ms ease;
  }
  .bcfg__color:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 0 var(--color-brand-navy);
  }
  .bcfg__color[aria-checked="true"] {
    border-color: var(--color-brand-navy);
    box-shadow: 2px 2px 0 0 var(--color-brand-navy);
  }
  .bcfg__color-swatch {
    display: inline-block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid #ffffff;
    box-shadow: 0 0 0 1px rgb(1 0 42 / 0.25);
  }
  .bcfg__color-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-brand-navy);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ===================== TABS (mobile) =====================
     Visíveis abaixo de 900 px. Mesma lógica do My PR Gym: cliente
     clica numa tab pra ver o painel daquela barra. Affordances de
     "clicável" reforçados: header explicativo + chevron pros tabs
     inativos + selo "editando" pro ativo. */
  .bcfg__tabs-block {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .bcfg__tabs-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0.15rem;
  }
  .bcfg__tabs-hint {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-gray);
    opacity: 0.85;
  }
  /* Wrap: reserva lane na ESQUERDA pros cabos SVG */
  .bcfg__tabs-wrap {
    position: relative;
    padding-left: 38px;
  }
  .bcfg__cables {
    position: absolute;
    left: 0;
    top: 0;
    width: 38px;
    /* SVG estende ABAIXO dos tabs (calc(100% + 70px)) pra que a parte
       inferior dos cabos chegue exatamente na badge "1" do panel head.
       overflow:visible garante que o glow do cabo aceso não seja cortado. */
    height: calc(100% + 70px);
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }
  .bcfg__cable {
    fill: none;
    /* Cabo DESLIGADO: navy translúcido + stroke 3.2 pra dar peso visual */
    stroke: rgb(1 0 42 / 0.4);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 280ms ease, stroke-width 240ms ease, filter 280ms ease;
  }
  /* Cabo ACESO — lime brilhando + neon glow duplo (outer + inner) */
  .bcfg__cables[data-cable-active="0"] [data-cable="0"],
  .bcfg__cables[data-cable-active="1"] [data-cable="1"],
  .bcfg__cables[data-cable-active="2"] [data-cable="2"] {
    stroke: var(--color-brand-lime);
    stroke-width: 3.8;
    filter: url(#bcfg-cable-glow);
  }
  /* "Lâmpada" no fim do cabo — círculo que serve de plug visual.
     Apenas o do cabo ATIVO acende lime + glow; outros ficam navy
     translúcido (combinando com o stroke dos cabos desligados). */
  .bcfg__cable-tip {
    fill: rgb(1 0 42 / 0.4);
    stroke: rgb(1 0 42 / 0.6);
    stroke-width: 0.8;

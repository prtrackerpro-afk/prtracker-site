---
/**
 * GA4 + Meta Pixel. IDs públicos (aparecem no HTML client-side), hardcoded
 * pra manter o build simples.
 *
 * GA4 Measurement ID: stream "prtracker.com.br" (ID 13664841350) da propriedade
 * prtracker.com.br. O stream "PR Tracker v2" (G-B2EPJXKSPZ) foi descontinuado —
 * estava configurado pro domínio de preview do Vercel e o gtag.js retornava 404
 * em produção, derrubando o tracking client-side.
 *
 * Meta Pixel: mesmo ID do WP atual, preserva audiência e conversões.
 */
const GA4_MEASUREMENT_ID = "G-5TQCL0R0RE";
const META_PIXEL_ID = "1278981700843845";

const isDev = import.meta.env.DEV;
---

{
  !isDev && (
    <>
      {/*
        LGPD opt-out: se o visitante rejeitou cookies em pageload anterior,
        sinalizamos via window.__noTracking. Os blocos GA4 e Meta Pixel
        abaixo checam essa flag antes de carregar. A flag é setada o mais
        cedo possível (antes dos scripts de tracking) pra garantir que o
        gate funcione mesmo se a tag de script async resolver primeiro.
      */}
      <script is:inline>
        (function () {
          try {
            if (localStorage.getItem("prtracker_consent") === "rejected") {
              window.__noTracking = true;
            }
          } catch (e) {}
        })();
      </script>

      {/*
        UTM capture (first-touch, 30d cookie).
        Roda no pageload de qualquer rota — se a URL trouxer utm_*, grava
        cookie `pr_utm` com tudo encodado em JSON compacto. First-touch:
        se já existe cookie, não sobrescreve (mantém o canal que trouxe
        o usuário, não o último). Servidor lê esse cookie no checkout
        e propaga pra metadata MP → webhook → CAPI custom_data + GA4 MP.
      */}
      <script is:inline>
        (function () {
          if (window.__noTracking) return;
          try {
            var qs = new URLSearchParams(window.location.search);
            var has = qs.get("utm_source") || qs.get("utm_medium") || qs.get("utm_campaign");
            if (!has) return;
            // First-touch: não sobrescreve.
            if (document.cookie.indexOf("pr_utm=") !== -1) return;
            var payload = {
              s: qs.get("utm_source") || "",
              m: qs.get("utm_medium") || "",
              c: qs.get("utm_campaign") || "",
              t: qs.get("utm_term") || "",
              n: qs.get("utm_content") || "",
              landing: window.location.pathname,
              ts: Date.now(),
            };
            var value = encodeURIComponent(JSON.stringify(payload));
            var maxAge = 60 * 60 * 24 * 30; // 30 dias
            document.cookie =
              "pr_utm=" + value + "; path=/; max-age=" + maxAge + "; SameSite=Lax";
          } catch (e) {}
        })();
      </script>

      {/* Google Analytics 4 (gtag.js) */}
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
      />
      <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
        if (!window.__noTracking) {
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", GA4_MEASUREMENT_ID);
        }
      </script>

      {/*
        Meta Pixel — deferred until browser idle (or after load) so the
        ~130KB fbevents.js download + execution doesn't steal main-thread
        time during the LCP window. PageView still fires before most
        users leave: requestIdleCallback runs within 1-2s of load in
        typical mobile conditions, and a 3s setTimeout backs it up for
        browsers without rIC (Safari < 16).
      */}
      <script is:inline define:vars={{ META_PIXEL_ID }}>
        function loadMetaPixel() {
          if (window.__noTracking) return;
          if (window.fbq) return;
          !(function (f, b, e, v, n, t, s) {
            n = f.fbq = function () {
              n.callMethod
                ? n.callMethod.apply(n, arguments)
                : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = "2.0";
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(
            window,
            document,
            "script",
            "https://connect.facebook.net/en_US/fbevents.js"
          );
          // Disable autoConfig BEFORE init: kills Meta's microdata-based
          // automatic AddToCart/SubscribedButtonClick (`es=automatic`,
          // `est_source=...`) that fires from button-text heuristics with
          // no Event ID and no params, polluting CTR/CPA. We send our own
          // events with full custom_data + eventID for CAPI dedup.
          fbq("set", "autoConfig", "false", META_PIXEL_ID);
          fbq("init", META_PIXEL_ID);
          fbq("track", "PageView");
        }
        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadMetaPixel, { timeout: 3000 });
        } else {
          setTimeout(loadMetaPixel, 2500);
        }
      </script>
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
          alt=""
        />
      </noscript>
    </>
  )
}

---
/**
 * Banner promocional do topo + countdown do cupom de campanha `prlovers`
 * (Dia dos Namorados — 10 % OFF + frete grátis acima de R$ 100, expira 12/06).
 *
 * Visual alinhado ao FreteGratisPopup: paleta coral/rosé, hearts Lucide
 * com heartbeat. Não é lime — é a faixa temática de Dia dos Namorados.
 */
import Heart from "@lucide/astro/icons/heart";
---

<aside
  class="fg-banner"
  data-fretegratis-banner
  role="region"
  aria-label="Cupom de frete grátis"
>
  <div class="container-page fg-banner__inner">
    <div class="fg-banner__lead">
      <span class="fg-banner__heart fg-banner__heart--beat" aria-hidden="true">
        <Heart size={14} />
      </span>
      <span class="fg-banner__tag" aria-hidden="true">CUPOM</span>
      <strong class="fg-banner__code">PRLOVERS</strong>
    </div>

    <span class="fg-banner__copy" data-fg-copy>10 % OFF + FRETE GRÁTIS</span>

    <div class="fg-banner__countdown" data-fg-countdown hidden>
      <span class="fg-banner__countdown-value" data-fg-countdown-value>02:00:00</span>
    </div>

    <div class="fg-banner__secondary" aria-hidden="true">
      <span>PIX 5 % OFF</span>
      <span class="fg-banner__sep">·</span>
      <span>3× SEM JUROS</span>
    </div>
  </div>
</aside>

<style>
  /* Paleta de campanha PRLOVERS (Dia dos Namorados) — alinhada ao
     FreteGratisPopup. Vive só enquanto a campanha está no ar. */
  .fg-banner {
    --prlovers-coral: #ff6b8a;
    --prlovers-coral-soft: #ffd9e2;
    --prlovers-coral-deep: #d9405f;

    background:
      linear-gradient(
        90deg,
        var(--prlovers-coral-deep) 0%,
        var(--prlovers-coral) 50%,
        var(--prlovers-coral-deep) 100%
      );
    color: #fff;
    border-bottom: 1px solid rgb(1 0 42 / 0.25);
    box-shadow: 0 2px 12px rgb(217 64 95 / 0.25);
  }
  .fg-banner__inner {
    display: grid;
    /* Desktop: lead | copy | countdown | secondary numa única linha.
       Coluna de countdown e secondary têm largura mínima fixa pelo conteúdo;
       o copy (1fr) absorve a folga e os spacers (1fr) ao redor centralizam
       o badge. */
    grid-template-columns: auto auto 1fr auto 1fr auto;
    grid-template-areas: "lead copy . countdown . secondary";
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding-block: 0.5rem;
    font-family: var(--font-display, "Inter"), sans-serif;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fg-banner__lead {
    grid-area: lead;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .fg-banner__heart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }
  .fg-banner__heart svg { fill: currentColor; stroke: none; }
  .fg-banner__heart--beat {
    animation: fg-banner-heartbeat 1.6s ease-in-out infinite;
    transform-origin: center;
  }

  .fg-banner__copy {
    grid-area: copy;
    font-weight: 700;
    justify-self: start;
    color: #fff;
  }
  .fg-banner__copy::before {
    content: "· ";
    opacity: 0.55;
    margin-right: 0.15em;
  }

  .fg-banner__tag {
    display: inline-block;
    padding: 0.18rem 0.45rem;
    background: var(--color-brand-navy, #01002a);
    color: var(--prlovers-coral-soft);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    line-height: 1;
    border-radius: 3px;
  }
  .fg-banner__code {
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #fff;
  }
  .fg-banner__sep { opacity: 0.55; }

  .fg-banner__countdown {
    grid-area: countdown;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.7rem;
    background: var(--color-brand-navy, #01002a);
    color: var(--prlovers-coral-soft);
    border-radius: 4px;
    line-height: 1;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .fg-banner__countdown-value {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .fg-banner__secondary {
    grid-area: secondary;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: end;
    font-weight: 700;
    font-size: 0.74rem;
    color: #fff;
  }

  @keyframes fg-banner-heartbeat {
    0%, 100% { transform: scale(1); }
    14%      { transform: scale(1.25); }
    28%      { transform: scale(1); }
    42%      { transform: scale(1.18); }
    70%      { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fg-banner__heart--beat { animation: none; }
  }

  /* Tablet: ainda em 1 linha (copy cabe), mas esconde secondary */
  @media (max-width: 899px) {
    .fg-banner__inner {
      grid-template-columns: auto auto 1fr auto;
      grid-template-areas: "lead copy . countdown";
      gap: 0.4rem 0.7rem;
      padding-block: 0.45rem;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
    }
    .fg-banner__secondary { display: none; }
    .fg-banner__countdown { padding: 0.2rem 0.55rem; }
    .fg-banner__countdown-value { font-size: 0.85rem; }
  }

  /* Mobile estreito: copy quebra pra 2ª linha quando timer ativo.
     Sem timer, mantém em 1 linha mesmo (copy cabe sozinha com lead). */
  @media (max-width: 480px) {
    .fg-banner__inner {
      grid-template-columns: 1fr auto;
      /* Rows explicit pra evitar bug de auto-flow + sticky no iOS. */
      grid-template-rows: auto auto;
      /* Countdown ocupa as 2 linhas — fica verticalmente centralizado
         entre o "CUPOM PRLOVERS" (linha 1) e o "10 % OFF + FRETE GRÁTIS"
         (linha 2). */
      grid-template-areas:
        "lead countdown"
        "copy countdown";
      gap: 0.15rem 0.7rem;
      padding-block: 0.45rem;
    }
    .fg-banner__lead { justify-self: start; }
    .fg-banner__copy {
      justify-self: start;
      font-size: 0.7rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
    /* Na 2ª linha o "·" inicial fica solto sem o code antes — esconder. */
    .fg-banner__copy::before { display: none; }
    /* Timer maior e centralizado nas 2 linhas. */
    .fg-banner__countdown {
      align-self: center;
      padding: 0.32rem 0.75rem;
    }
    .fg-banner__countdown-value { font-size: 1.05rem; }
    /* Sem timer (estado inicial): copy vira inline com lead pra economizar
       altura, e a 2ª linha do grid não é usada porque copy ocupa cell 2. */
    .fg-banner:not(.is-counting) .fg-banner__inner {
      grid-template-columns: auto 1fr;
      grid-template-areas: "lead copy";
    }
    .fg-banner:not(.is-counting) .fg-banner__copy::before { display: inline; }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = "prt_prlovers_started_at";
    const DURATION_MS = 2 * 60 * 60 * 1000;

    function pad(n) { return n.toString().padStart(2, "0"); }
    function format(ms) {
      const total = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(total / 3600);
      const m = Math.floor((total % 3600) / 60);
      const s = total % 60;
      return pad(h) + ":" + pad(m) + ":" + pad(s);
    }

    function init() {
      const banner = document.querySelector("[data-fretegratis-banner]");
      if (!banner) return;
      const countdownEl = banner.querySelector("[data-fg-countdown]");
      const countdownValueEl = banner.querySelector("[data-fg-countdown-value]");
      const copyEl = banner.querySelector("[data-fg-copy]");
      if (!countdownEl || !countdownValueEl || !copyEl) return;

      let timer = null;

      function tick() {
        let raw = null;
        try { raw = localStorage.getItem(STORAGE_KEY); } catch (e) {}
        const startedAt = raw ? parseInt(raw, 10) : NaN;
        if (!Number.isFinite(startedAt)) {
          if (timer) { clearInterval(timer); timer = null; }
          countdownEl.hidden = true;
          banner.classList.remove("is-counting");
          copyEl.textContent = "10 % OFF + FRETE GRÁTIS";
          return;
        }
        const remaining = startedAt + DURATION_MS - Date.now();
        if (remaining <= 0) {
          try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
          if (timer) { clearInterval(timer); timer = null; }
          countdownEl.hidden = true;
          banner.classList.remove("is-counting");
          copyEl.textContent = "10 % OFF + FRETE GRÁTIS";
          document.dispatchEvent(new CustomEvent("prlovers:expired"));
          return;
        }
        countdownEl.hidden = false;
        banner.classList.add("is-counting");
        copyEl.textContent = "10 % OFF + FRETE GRÁTIS";
        countdownValueEl.textContent = format(remaining);
      }

      function start() {
        tick();
        if (timer) clearInterval(timer);
        timer = setInterval(tick, 1000);
      }

      start();
      window.addEventListener("storage", function (e) {
        if (e.key === STORAGE_KEY) tick();
      });
      document.addEventListener("prlovers:started", function () { start(); });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

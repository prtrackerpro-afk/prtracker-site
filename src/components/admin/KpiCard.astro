---
import Sparkline from "./Sparkline";
import {
  iconActivity,
  iconArrowDown,
  iconArrowUp,
  iconChartBar,
  iconClick,
  iconDollar,
  iconEye,
  iconTarget,
  iconTrendingUp,
  iconUsers,
} from "./icons";

const ICONS: Record<string, string> = {
  spend: iconDollar,
  revenue: iconChartBar,
  roas: iconTrendingUp,
  conversions: iconTarget,
  impressions: iconEye,
  clicks: iconClick,
  cpm: iconActivity,
  cpa: iconTarget,
  cpc: iconActivity,
  reach: iconUsers,
  sessions: iconActivity,
  users: iconUsers,
  ctr: iconTrendingUp,
};

interface Props {
  label: string;
  value: string;
  /** Pick an icon from `ICONS`; defaults to a generic chart bar. */
  icon?: keyof typeof ICONS | "default";
  /** % delta vs comparison period — drives an arrow + emerald/red color. */
  delta?: { value: string; positive?: boolean };
  /** Optional secondary line under the value (e.g. "CTR 5.93%"). */
  hint?: string;
  /** Numeric series for the inline sparkline. */
  spark?: number[];
  accent?: "lime" | "navy" | "default";
}

const { label, value, icon = "default", delta, hint, spark, accent = "default" } = Astro.props;

const accentClass =
  accent === "lime"
    ? "border-brand-lime/30 bg-brand-lime/5"
    : accent === "navy"
      ? "border-navy-600/60 bg-navy-800/60"
      : "border-navy-700 bg-navy-800/40";

const iconSvg = ICONS[icon as string] ?? iconChartBar;
const sparkData = spark && spark.length > 1 ? spark.map((v) => ({ v })) : undefined;
const sparkColor = accent === "lime" ? "#d8ff2c" : delta && !delta.positive ? "#f87171" : "#d8ff2c";
---

<div
  class:list={[
    "group relative min-w-0 overflow-hidden rounded-2xl border p-4 md:p-5",
    "transition hover:border-brand-lime/40 hover:bg-navy-800/60",
    accentClass,
  ]}
>
  <div class="flex items-center gap-2 mb-2 text-navy-300">
    <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-navy-700/60 text-brand-lime [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={iconSvg} />
    <span class="text-[10px] md:text-[11px] uppercase tracking-[0.12em] truncate" title={label}>{label}</span>
  </div>

  <div class="text-2xl md:text-3xl font-semibold leading-none text-white truncate" title={value}>{value}</div>

  {
    (hint || delta) && (
      <div class="mt-2 flex items-center gap-2 text-xs text-navy-300">
        {delta && (
          <span
            class:list={[
              "inline-flex items-center gap-0.5 rounded-md px-1.5 py-0.5 font-medium",
              delta.positive
                ? "bg-emerald-500/15 text-emerald-400"
                : "bg-red-500/15 text-red-400",
            ]}
          >
            <span class="[&>svg]:h-3 [&>svg]:w-3" set:html={delta.positive ? iconArrowUp : iconArrowDown} />
            <span>{delta.value}</span>
          </span>
        )}
        {hint && <span class="truncate" title={hint}>{hint}</span>}
      </div>
    )
  }

  {
    sparkData && (
      <div class="mt-3 -mx-1">
        <Sparkline client:only="react" data={sparkData} color={sparkColor} height={32} />
      </div>
    )
  }
</div>

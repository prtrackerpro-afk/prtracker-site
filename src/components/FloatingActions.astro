---
/**
 * Floating action stack — bottom-right of the viewport.
 *
 * Two buttons:
 *   1. Chatbot (top)   — opens the in-page assistant (`Chatbot.astro`).
 *   2. WhatsApp (bottom) — direct hand-off to the partner's phone.
 *
 * Hidden on /admin/* via the layout (AdminLayout doesn't render this).
 * Hidden on /checkout via a CSS rule (set on <body>) to avoid distracting
 * the buyer at the most fragile step of the funnel.
 */
import Chatbot from "./Chatbot.astro";

const WHATSAPP_NUMBER = "5551982061914";
const WHATSAPP_PREFILL = encodeURIComponent(
  "Olá! Vim do site da PR Tracker e gostaria de tirar uma dúvida.",
);
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_PREFILL}`;
---

<div class="fab-stack" data-floating-actions>
  <Chatbot />

  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="fab fab--whatsapp"
    aria-label="Falar no WhatsApp (51) 98206-1914"
    data-track="whatsapp-fab"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.768.966-.941 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.85 12.85 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.695.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
    </svg>
    <span class="fab__tooltip">WhatsApp</span>
  </a>
</div>

<style>
  .fab-stack {
    position: fixed;
    right: clamp(12px, 3vw, 24px);
    bottom: clamp(12px, 3vw, 24px);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    pointer-events: none;
  }
  .fab-stack > :global(*) {
    pointer-events: auto;
  }

  /*
   * .fab and .fab__tooltip are :global() so the same base styles reach
   * the chatbot button (rendered from Chatbot.astro). Astro normally
   * scopes class rules to the file they're declared in.
   */
  :global(.fab) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    color: #fff;
    text-decoration: none;
    box-shadow:
      0 8px 24px rgb(0 0 0 / 0.18),
      0 2px 6px rgb(0 0 0 / 0.12);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }
  :global(.fab:hover) {
    transform: translateY(-2px);
    box-shadow:
      0 14px 32px rgb(0 0 0 / 0.22),
      0 4px 10px rgb(0 0 0 / 0.14);
  }
  :global(.fab:focus-visible) {
    outline: 3px solid var(--color-brand-lime);
    outline-offset: 3px;
  }

  .fab--whatsapp {
    background: #25d366;
  }
  .fab--whatsapp:hover {
    background: #1ebe5b;
  }

  :global(.fab__tooltip) {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: var(--color-brand-navy);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }
  :global(.fab:hover .fab__tooltip),
  :global(.fab:focus-visible .fab__tooltip) {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }
  @media (max-width: 720px) {
    :global(.fab__tooltip) {
      display: none;
    }
  }
</style>

---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProductGallery from "~/components/ProductGallery.astro";
import SpecsTable from "~/components/SpecsTable.astro";
import FAQAccordion from "~/components/FAQAccordion.astro";
import AddToCartSimple from "~/components/AddToCartSimple.astro";
import BarbellConfigurator from "~/components/BarbellConfigurator.astro";
import TripleBarbellConfigurator from "~/components/TripleBarbellConfigurator.astro";
import MeusRPsConfigurator from "~/components/MeusRPsConfigurator.astro";
import MeusRPsPlaquinhaConfigurator from "~/components/MeusRPsPlaquinhaConfigurator.astro";
import BoardConfigurator from "~/components/BoardConfigurator.astro";
import GiftCardConfigurator from "~/components/GiftCardConfigurator.astro";
import NotifyMeForm from "~/components/NotifyMeForm.astro";
import TrackViewContent from "~/components/TrackViewContent.astro";
import { formatBRL, centsToReaisString } from "~/lib/format";
import { CATEGORY_LABELS } from "~/lib/catalog";
import ChevronRight from "@lucide/astro/icons/chevron-right";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const {
  slug,
  title,
  tagline,
  category,
  priceBase,
  priceFrom,
  shortDescription,
  longDescriptionHtml,
  images,
  specs,
  faq,
  sizes,
  configurator,
  comingSoon,
  seo,
} = product.data;

const categoryLabel = CATEGORY_LABELS[category] ?? category;
const primary = images[0]!;
const SITE_URL = (import.meta.env.PUBLIC_SITE_URL ?? "https://prtracker.com.br").replace(/\/$/, "");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: title,
  description: shortDescription,
  image: images.map((img) => `${SITE_URL}${img.src}`),
  brand: { "@type": "Brand", name: "PR Tracker" },
  offers: {
    "@type": "Offer",
    priceCurrency: "BRL",
    price: centsToReaisString(priceBase),
    availability: comingSoon
      ? "https://schema.org/PreOrder"
      : "https://schema.org/InStock",
    url: `${SITE_URL}/product/${slug}`,
    seller: { "@type": "Organization", name: "PR Tracker" },
    // Pré-requisitos do Google Merchant Center pra eligibilidade em
    // Shopping ads / Performance Max sem fallback de "merchant-default".
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: {
        "@type": "MonetaryAmount",
        value: "0",
        currency: "BRL",
      },
      shippingDestination: {
        "@type": "DefinedRegion",
        addressCountry: "BR",
      },
      deliveryTime: {
        "@type": "ShippingDeliveryTime",
        handlingTime: {
          "@type": "QuantitativeValue",
          minValue: 5,
          maxValue: 10,
          unitCode: "DAY",
        },
        transitTime: {
          "@type": "QuantitativeValue",
          minValue: 3,
          maxValue: 10,
          unitCode: "DAY",
        },
      },
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "BR",
      returnPolicyCategory:
        "https://schema.org/MerchantReturnFiniteReturnWindow",
      merchantReturnDays: 7,
      returnMethod: "https://schema.org/ReturnByMail",
      returnFees: "https://schema.org/ReturnShippingFees",
    },
  },
};

const metaTitle = seo.metaTitle ?? `${title} — PR Tracker`;
const metaDescription = seo.metaDescription ?? shortDescription;

// OG image dedicada (1200×630) só pros produtos da linha PR Runners e
// PR Tracker Boards — gerada via scripts/gen-product-og.mjs. Demais
// produtos caem no primary.src (foto + dimensões erradas no preview de
// link, mas funciona — versão futura: gerar OG pra todos). Ver
// .claude/v12-* pra referência.
const PRODUCTS_WITH_DEDICATED_OG = new Set([
  "meus-rps",
  "pr-tracker-board-2",
  "pr-tracker-board-2-snatch-cj",
  "pr-tracker-board-3",
]);
const ogImagePath = PRODUCTS_WITH_DEDICATED_OG.has(slug)
  ? `/images/og/${slug}.jpg`
  : primary.src;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImagePath}
  ogType="product"
  jsonLd={jsonLd}
>
  <TrackViewContent
    slug={slug}
    title={title}
    priceCents={priceBase}
    category={category}
  />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="breadcrumb container-page">
    <ol>
      <li><a href="/">Início</a></li>
      <ChevronRight size={14} aria-hidden="true" />
      {category === "camisetas" ? (
        <>
          <li><a href="/product-category/camisetas">Camisetas</a></li>
          <ChevronRight size={14} aria-hidden="true" />
        </>
      ) : (
        <>
          <li><a href="/#produtos">{categoryLabel}</a></li>
          <ChevronRight size={14} aria-hidden="true" />
        </>
      )}
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <!-- Product main -->
  <section class="product">
    <div class="container-page product__grid">
      <div class="product__gallery">
        <ProductGallery images={images} title={title} />
      </div>

      <div class="product__info">
        <p class="product__category">{categoryLabel}</p>
        {comingSoon && <span class="product__coming-soon">EM BREVE</span>}
        <h1 class="product__title">{title}</h1>
        {tagline && <p class="product__tagline">{tagline}</p>}
        <p class="product__short">{shortDescription}</p>

        <div class="product__buy">
          {configurator.isGiftCard ? (
            <GiftCardConfigurator
              slug={slug}
              title={title}
              image={primary.src}
              category={category}
              denominationsCents={configurator.giftCardDenominationsCents}
            />
          ) : configurator.isMeusRPs ? (
            <MeusRPsConfigurator
              slug={slug}
              title={title}
              image={primary.src}
              basePriceCents={priceBase}
              category={category}
            />
          ) : configurator.isMeusRPsPlaquinha ? (
            <MeusRPsPlaquinhaConfigurator
              slug={slug}
              title={title}
              image={primary.src}
              basePriceCents={priceBase}
              category={category}
            />
          ) : configurator.isBoard ? (
            <BoardConfigurator
              slug={slug}
              title={title}
              image={primary.src}
              basePriceCents={priceBase}
              exerciseCount={(configurator.boardExerciseCount ?? 3) as 2 | 3}
              defaultExercises={configurator.boardDefaultExercises ?? []}
              exerciseChoices={configurator.boardExerciseChoices}
              exercisesFixed={configurator.boardExercisesFixed}
              category={category}
            />
          ) : configurator.isTripleBarbell ? (
            <TripleBarbellConfigurator
              slug={slug}
              title={title}
              basePriceCents={priceBase}
            />
          ) : configurator.enabled ? (
            <BarbellConfigurator
              slug={slug}
              title={title}
              image={primary.src}
              basePriceCents={configurator.isAnilhasOnly ? 0 : priceBase}
              isAnilhasOnly={configurator.isAnilhasOnly}
              hasExerciseSelector={configurator.hasExerciseSelector}
              category={category}
            />
          ) : (
            <AddToCartSimple
              slug={slug}
              title={title}
              image={primary.src}
              priceCents={priceBase}
              sizes={sizes}
              category={category}
            />
          )}
        </div>
      </div>
    </div>
  </section>

  {comingSoon && <NotifyMeForm />}

  <!-- Long description + specs + FAQ -->
  <section class="product-details">
    <div class="container-page product-details__grid">
      <div class="product-details__main">
        <section class="prose" aria-labelledby="desc-title">
          <h2 id="desc-title">Sobre este produto</h2>
          <div class="prose-body" set:html={longDescriptionHtml} />
        </section>

        <SpecsTable specs={specs} />
      </div>

      <aside class="product-details__aside">
        <FAQAccordion items={faq} />
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    padding: 1.25rem 1.25rem 0.5rem;
  }
  @media (min-width: 768px) { .breadcrumb { padding: 1.5rem 2rem 0.75rem; } }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-brand-gray);
  }
  .breadcrumb a {
    color: var(--color-brand-gray);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .breadcrumb a:hover { color: var(--color-brand-navy); }
  .breadcrumb [aria-current="page"] {
    color: var(--color-brand-navy);
    font-weight: 600;
  }

  .product {
    padding: 1.5rem 0 3rem;
  }
  .product__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .product__grid { grid-template-columns: 1.15fr 1fr; gap: 3.5rem; }
  }
  @media (min-width: 900px) {
    .product__gallery {
      position: sticky;
      top: 8rem;
      align-self: start;
    }
  }

  .product__category {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-gray);
    margin: 0 0 0.75rem;
  }
  .product__coming-soon {
    display: inline-block;
    margin: 0 0 0.65rem;
    padding: 0.28rem 0.7rem;
    background: var(--color-brand-lime);
    color: var(--color-brand-navy);
    border: 1px solid var(--color-brand-navy);
    border-radius: 3px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
  }
  .product__title {
    font-size: clamp(1.875rem, 2.5vw + 1rem, 2.75rem);
    margin: 0 0 0.5rem;
    line-height: 1;
  }
  .product__tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-brand-navy);
    opacity: 0.75;
    margin: 0 0 0.85rem;
  }
  .product__short {
    color: var(--color-brand-gray);
    line-height: 1.6;
    font-size: 1rem;
    margin: 0 0 1.5rem;
    max-width: 44ch;
  }
  .product__buy {
    margin-top: 0.5rem;
  }

  .product-details {
    padding: 3rem 0 4rem;
    border-top: 1px solid rgb(1 0 42 / 0.08);
    background: var(--color-paper);
  }
  .product-details__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .product-details__grid { grid-template-columns: 1.5fr 1fr; gap: 3.5rem; }
  }

  .prose h2 {
    font-size: 1.6rem;
    margin: 0 0 1rem;
  }
  .prose-body {
    color: var(--color-brand-gray);
    line-height: 1.7;
    font-size: 1.0625rem;
  }
  .prose-body :global(p) { margin: 0 0 1rem; }
  .prose-body :global(strong) { color: var(--color-brand-navy); font-weight: 700; }
  .prose-body :global(ul) {
    margin: 0 0 1rem 1.25rem;
    padding: 0;
  }
  .prose-body :global(ul li) { margin-bottom: 0.35rem; }
</style>

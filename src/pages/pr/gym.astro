---
export const prerender = false;
import "../../styles/global.css";
import { getServerSupabase } from "../../lib/supabase/server";
import { listBestLifts } from "../../lib/pr/db";
import { exerciseLabel, type ExerciseId } from "../../lib/pr/exercises";
import { summarize, tierColor, tierLabel, TIER_META, type Tier } from "../../lib/pr/strength-score";
import VirtualGym, { type GymTrophy } from "../../components/pr/VirtualGym";
import BottomNav from "../../components/pr/BottomNav.astro";

const athlete = Astro.locals.athlete!;

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

const bestLifts = (await listBestLifts(supabase, athlete.userId)) as Partial<Record<ExerciseId, number>>;
const summary = summarize({
  bodyWeightKg: athlete.bodyWeightKg,
  sex: athlete.sex,
  bestLifts,
});

// Build the trophies for the gym scene — sorted by tier rank desc, then weight desc.
const sorted = [...summary.lifts].sort((a, b) => {
  const r = TIER_META[b.tier].rank - TIER_META[a.tier].rank;
  return r !== 0 ? r : b.weightKg - a.weightKg;
});

const trophies: GymTrophy[] = sorted.map((l) => ({
  color: tierColor(l.tier),
  weightKg: l.weightKg,
  shortLabel: shortName(exerciseLabel(l.exerciseId)),
  exerciseId: l.exerciseId,
  exerciseLabel: exerciseLabel(l.exerciseId),
}));

// Fallback when athlete has no body data — show records with lime accent
const fallbackTrophies: GymTrophy[] =
  trophies.length === 0
    ? Object.entries(bestLifts)
        .slice(0, 12)
        .map(([id, kg]) => ({
          color: "#D8FF2C",
          weightKg: Number(kg),
          shortLabel: shortName(exerciseLabel(id as ExerciseId)),
          exerciseId: id as ExerciseId,
          exerciseLabel: exerciseLabel(id as ExerciseId),
        }))
    : trophies;

const accent = summary.hasBodyData ? tierColor(summary.overallTier) : "#D8FF2C";
const tierName = summary.hasBodyData ? tierLabel(summary.overallTier) : "Atleta";

// === STREAK Duolingo-style: dias consecutivos com PR registrado ===
// Buscamos as datas dos PRs do atleta e calculamos a maior sequência
// que termina em "hoje" (ou ontem — admite 1 dia de tolerância).
const { data: prDates = [] } = await supabase
  .from("pr_records")
  .select("performed_at")
  .eq("user_id", athlete.userId)
  .eq("is_personal_record", true)
  .order("performed_at", { ascending: false })
  .limit(180);

function computeStreak(dates: string[]): number {
  if (dates.length === 0) return 0;
  // Set de datas únicas em formato YYYY-MM-DD
  const dateSet = new Set(dates.map((d) => d.slice(0, 10)));
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);

  // Streak conta a partir de hoje (ou ontem) pra trás
  let cursor = new Date(today);
  if (!dateSet.has(cursor.toISOString().slice(0, 10))) {
    cursor = yesterday; // tolerância de 1 dia
    if (!dateSet.has(cursor.toISOString().slice(0, 10))) return 0;
  }
  let count = 0;
  while (dateSet.has(cursor.toISOString().slice(0, 10))) {
    count++;
    cursor.setDate(cursor.getDate() - 1);
  }
  return count;
}

const streakDays = computeStreak((prDates ?? []).map((d) => d.performed_at as string));

// === Skills (ginásticos) — fetch best reps por skill ===
const { data: skillRows = [] } = await supabase
  .from("pr_skills")
  .select("skill_id, best_reps")
  .eq("user_id", athlete.userId);

const skills: Record<string, number> = {};
for (const row of skillRows ?? []) {
  skills[row.skill_id as string] = Number(row.best_reps);
}

// === Runs — fetch best time por distância ===
const { data: runRows = [] } = await supabase
  .from("pr_runs")
  .select("distance, best_time_sec")
  .eq("user_id", athlete.userId);

const runs: Record<string, number> = {};
for (const row of runRows ?? []) {
  runs[row.distance as string] = Number(row.best_time_sec);
}

// === Gym layout + XP — coluna pr_athletes.gym_layout + xp_total ===
// VirtualGym lê esses via props. xp_total NULL/0 = atleta sem XP ainda.
const { data: athleteRow } = await supabase
  .from("pr_athletes")
  .select("gym_layout, xp_total")
  .eq("user_id", athlete.userId)
  .maybeSingle();
const initialGymLayout = (athleteRow?.gym_layout as unknown) ?? null;
const xpTotal = Number(athleteRow?.xp_total ?? 0);

function shortName(label: string): string {
  // Take first letter of each word, max 4 chars
  return label
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 4)
    .toUpperCase();
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Ginásio Virtual · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-20">
    <header class="px-4 pt-4 pb-2 max-w-4xl mx-auto flex items-center justify-between">
      <a href="/pr/profile" class="text-xs text-navy-300 hover:text-white">← Perfil</a>
      <div class="text-center">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">GINÁSIO VIRTUAL</div>
        <div class="font-display text-base tracking-tight">{athlete.displayName}</div>
      </div>
      <a href="/pr/gym/edit" class="text-xs text-navy-300 hover:text-brand-lime">Editor →</a>
    </header>

    <main class="max-w-4xl mx-auto px-2">
      <!-- Container com altura concreta. iOS Safari ignora min-height
           quando o pai tem aspect-ratio, deixando o canvas em 0×0. h-[65vh]
           com mínimo de 420px garante que a ilha React tenha onde montar. -->
      <div class="rounded-2xl overflow-hidden border border-navy-700 bg-navy-900 relative h-[65vh] min-h-[420px] sm:h-[70vh]">
        <VirtualGym
          client:only="react"
          athleteName={athlete.displayName ?? "Atleta"}
          accent={accent}
          trophies={fallbackTrophies}
          streakDays={streakDays}
          skills={skills}
          runs={runs}
          initialLayout={initialGymLayout as null}
          xpTotal={xpTotal}
        >
          {/* Fallback enquanto a ilha React hidrata. Se isso ficar visível
              por mais de 2-3s, a hidratação falhou (cheque o console). */}
          <div class="absolute inset-0 grid place-items-center">
            <div class="text-center">
              <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">
                Carregando ginásio
              </div>
              <div class="text-xs text-navy-300">
                Montando paredes, prateleiras e troféus...
              </div>
            </div>
          </div>
        </VirtualGym>

        {/* HUD overlay */}
        <div class="pointer-events-none absolute top-3 left-3 text-[10px] uppercase tracking-widest">
          <div class="text-navy-300">Tier</div>
          <div class="font-display text-base" style={`color: ${accent}`}>{tierName}</div>
        </div>
        <div class="pointer-events-none absolute bottom-3 right-3 text-[10px] uppercase tracking-widest text-navy-300 text-right">
          <div>{fallbackTrophies.length} troféu{fallbackTrophies.length === 1 ? "" : "s"}</div>
          <div class="text-brand-lime hidden sm:block">WASD pra andar · Clica num troféu</div>
          <div class="text-brand-lime sm:hidden">Joystick + tap no troféu</div>
        </div>
      </div>

      <section class="mt-4 rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-4 shadow-lg shadow-brand-lime/5">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">PORTAIS NO GYM</div>
        <div class="text-sm mb-2">
          <strong>Anda pelo gym e clica nos portais coloridos pra navegar:</strong>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #43b02a"></span>
            <span class="text-navy-300">Dieta</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #0057b8"></span>
            <span class="text-navy-300">Coach</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #ffc72c"></span>
            <span class="text-navy-300">Troféus</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #da291c"></span>
            <span class="text-navy-300">Eventos</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #d8ff2c"></span>
            <span class="text-navy-300">Registrar PR</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full bg-purple-500"></span>
            <span class="text-navy-300">Cinema</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full bg-pink-500"></span>
            <span class="text-navy-300">Fliperama</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full bg-brand-lime"></span>
            <span class="text-navy-300">Troféus reais</span>
          </div>
        </div>
        <div class="text-xs text-navy-400 mt-2">
          <a href="/pr/feed" class="text-brand-lime hover:underline">Visite o ginásio dos amigos no feed →</a>
        </div>
      </section>

      {fallbackTrophies.length === 0 && (
        <div class="mt-4 rounded-2xl border border-navy-700 bg-navy-800/30 p-6 text-center">
          <p class="text-sm text-navy-300 mb-3">Seu ginásio está vazio. Cada PR registrado vira um troféu na parede.</p>
          <a href="/pr/log" class="inline-block text-xs bg-brand-lime text-navy-900 font-semibold rounded px-3 py-1.5">Registrar primeiro PR</a>
        </div>
      )}
    </main>

    <BottomNav active="profile" />
  </body>
</html>

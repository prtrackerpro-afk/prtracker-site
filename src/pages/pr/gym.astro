---
export const prerender = false;
import "../../styles/global.css";
import { getServerSupabase } from "../../lib/supabase/server";
import { listBestLifts } from "../../lib/pr/db";
import { exerciseLabel, type ExerciseId } from "../../lib/pr/exercises";
import { summarize, tierColor, tierLabel, TIER_META, type Tier } from "../../lib/pr/strength-score";
import VirtualGym, { type GymTrophy } from "../../components/pr/VirtualGym";
import BottomNav from "../../components/pr/BottomNav.astro";

const athlete = Astro.locals.athlete!;

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

const bestLifts = (await listBestLifts(supabase, athlete.userId)) as Partial<Record<ExerciseId, number>>;
const summary = summarize({
  bodyWeightKg: athlete.bodyWeightKg,
  sex: athlete.sex,
  bestLifts,
});

// Build the trophies for the gym scene — sorted by tier rank desc, then weight desc.
const sorted = [...summary.lifts].sort((a, b) => {
  const r = TIER_META[b.tier].rank - TIER_META[a.tier].rank;
  return r !== 0 ? r : b.weightKg - a.weightKg;
});

const trophies: GymTrophy[] = sorted.map((l) => ({
  color: tierColor(l.tier),
  weightKg: l.weightKg,
  shortLabel: shortName(exerciseLabel(l.exerciseId)),
  exerciseId: l.exerciseId,
  exerciseLabel: exerciseLabel(l.exerciseId),
}));

// Fallback when athlete has no body data — show records with lime accent
const fallbackTrophies: GymTrophy[] =
  trophies.length === 0
    ? Object.entries(bestLifts)
        .slice(0, 12)
        .map(([id, kg]) => ({
          color: "#D8FF2C",
          weightKg: Number(kg),
          shortLabel: shortName(exerciseLabel(id as ExerciseId)),
          exerciseId: id as ExerciseId,
          exerciseLabel: exerciseLabel(id as ExerciseId),
        }))
    : trophies;

const accent = summary.hasBodyData ? tierColor(summary.overallTier) : "#D8FF2C";
const tierName = summary.hasBodyData ? tierLabel(summary.overallTier) : "Atleta";

// === STREAK Duolingo-style: dias consecutivos com PR registrado ===
// Buscamos as datas dos PRs do atleta e calculamos a maior sequência
// que termina em "hoje" (ou ontem — admite 1 dia de tolerância).
const { data: prDates = [] } = await supabase
  .from("pr_records")
  .select("performed_at")
  .eq("user_id", athlete.userId)
  .eq("is_personal_record", true)
  .order("performed_at", { ascending: false })
  .limit(180);

function computeStreak(dates: string[]): number {
  if (dates.length === 0) return 0;
  // Set de datas únicas em formato YYYY-MM-DD
  const dateSet = new Set(dates.map((d) => d.slice(0, 10)));
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);

  // Streak conta a partir de hoje (ou ontem) pra trás
  let cursor = new Date(today);
  if (!dateSet.has(cursor.toISOString().slice(0, 10))) {
    cursor = yesterday; // tolerância de 1 dia
    if (!dateSet.has(cursor.toISOString().slice(0, 10))) return 0;
  }
  let count = 0;
  while (dateSet.has(cursor.toISOString().slice(0, 10))) {
    count++;
    cursor.setDate(cursor.getDate() - 1);
  }
  return count;
}

const streakDays = computeStreak((prDates ?? []).map((d) => d.performed_at as string));

// === Skills (ginásticos) — fetch best reps por skill ===
const { data: skillRows = [] } = await supabase
  .from("pr_skills")
  .select("skill_id, best_reps")
  .eq("user_id", athlete.userId);

const skills: Record<string, number> = {};
for (const row of skillRows ?? []) {
  skills[row.skill_id as string] = Number(row.best_reps);
}

// === Runs — fetch best time por distância ===
const { data: runRows = [] } = await supabase
  .from("pr_runs")
  .select("distance, best_time_sec")
  .eq("user_id", athlete.userId);

const runs: Record<string, number> = {};
for (const row of runRows ?? []) {
  runs[row.distance as string] = Number(row.best_time_sec);
}

// === Gym layout + XP — coluna pr_athletes.gym_layout + xp_total ===
// VirtualGym lê esses via props. xp_total NULL/0 = atleta sem XP ainda.
const { data: athleteRow } = await supabase
  .from("pr_athletes")
  .select("gym_layout, xp_total")
  .eq("user_id", athlete.userId)
  .maybeSingle();
const initialGymLayout = (athleteRow?.gym_layout as unknown) ?? null;
const xpTotal = Number(athleteRow?.xp_total ?? 0);

function shortName(label: string): string {
  // Take first letter of each word, max 4 chars
  return label
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 4)
    .toUpperCase();
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Ginásio Virtual · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-20">
    <header class="px-4 pt-4 pb-2 max-w-4xl mx-auto flex items-center justify-between">
      <a href="/pr/profile" class="text-xs text-navy-300 hover:text-white">← Perfil</a>
      <div class="text-center">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">GINÁSIO VIRTUAL</div>
        <div class="font-display text-base tracking-tight">{athlete.displayName}</div>
      </div>
      <a href="/pr/gym/edit" class="text-xs text-navy-300 hover:text-brand-lime">Editor →</a>
    </header>

    <main class="max-w-4xl mx-auto px-2">
      <!-- Container com altura concreta. iOS Safari ignora min-height
           quando o pai tem aspect-ratio, deixando o canvas em 0×0. h-[65vh]
           com mínimo de 420px garante que a ilha React tenha onde montar. -->
      <div class="rounded-2xl overflow-hidden border border-navy-700 bg-navy-900 relative h-[65vh] min-h-[420px] sm:h-[70vh]">
        <VirtualGym
          client:only="react"
          athleteName={athlete.displayName ?? "Atleta"}
          accent={accent}
          trophies={fallbackTrophies}
          streakDays={streakDays}
          skills={skills}
          runs={runs}
          initialLayout={initialGymLayout as null}
          xpTotal={xpTotal}
        >
          {/* Fallback enquanto a ilha React hidrata. Se isso ficar visível
              por mais de 2-3s, a hidratação falhou (cheque o console). */}
          <div class="absolute inset-0 grid place-items-center">
            <div class="text-center">
              <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">
                Carregando ginásio
              </div>
              <div class="text-xs text-navy-300">
                Montando paredes, prateleiras e troféus...
              </div>
            </div>
          </div>
        </VirtualGym>

        {/* HUD overlay */}
        <div class="pointer-events-none absolute top-3 left-3 text-[10px] uppercase tracking-widest">
          <div class="text-navy-300">Tier</div>
          <div class="font-display text-base" style={`color: ${accent}`}>{tierName}</div>
        </div>
        <div class="pointer-events-none absolute bottom-3 right-3 text-[10px] uppercase tracking-widest text-navy-300 text-right">
          <div>{fallbackTrophies.length} troféu{fallbackTrophies.length === 1 ? "" : "s"}</div>
          <div class="text-brand-lime hidden sm:block">WASD pra andar · Clica num troféu</div>
          <div class="text-brand-lime sm:hidden">Joystick + tap no troféu</div>
        </div>
      </div>

      <section class="mt-4 rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-4 shadow-lg shadow-brand-lime/5">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">PORTAIS NO GYM</div>
        <div class="text-sm mb-2">
          <strong>Anda pelo gym e clica nos portais coloridos pra navegar:</strong>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #43b02a"></span>
            <span class="text-navy-300">Dieta</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #0057b8"></span>
            <span class="text-navy-300">Coach</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #ffc72c"></span>
            <span class="text-navy-300">Troféus</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #da291c"></span>
            <span class="text-navy-300">Eventos</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full" style="background: #d8ff2c"></span>
            <span class="text-navy-300">Registrar PR</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full bg-purple-500"></span>
            <span class="text-navy-300">Cinema</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full bg-pink-500"></span>
            <span class="text-navy-300">Fliperama</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-full bg-brand-lime"></span>
            <span class="text-navy-300">Troféus reais</span>
          </div>
        </div>
        <div class="text-xs text-navy-400 mt-2">
          <a href="/pr/feed" class="text-brand-lime hover:underline">Visite o ginásio dos amigos no feed →</a>
        </div>
      </section>

      {fallbackTrophies.length === 0 && (
        <div class="mt-4 rounded-2xl border border-navy-700 bg-navy-800/30 p-6 text-center">
          <p class="text-sm text-navy-300 mb-3">Seu ginásio está vazio. Cada PR registrado vira um troféu na parede.</p>
          <a href="/pr/log" class="inline-block text-xs bg-brand-lime text-navy-900 font-semibold rounded px-3 py-1.5">Registrar primeiro PR</a>
        </div>
      )}
    </main>

    <BottomNav active="profile" />

    <!-- PR4: PlayMode com canvas — atleta executa o movimento real -->
    <div id="play-mode-modal" class="hidden fixed inset-0 bg-black/90 z-[60] items-center justify-center p-3">
      <div class="bg-navy-900 border-2 border-brand-lime/40 rounded-2xl p-4 w-full max-w-md shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <div>
            <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">MODO LÚDICO · NÃO VALE XP</div>
            <h2 class="font-display text-xl text-white" id="play-title">Exercício</h2>
          </div>
          <button id="play-close" class="text-navy-300 hover:text-white text-2xl leading-none">✕</button>
        </div>
        <canvas
          id="play-canvas"
          width="420"
          height="320"
          class="w-full bg-navy-900 border-2 border-brand-lime/30 rounded-lg block mb-2"
          style="touch-action: none; image-rendering: pixelated;"
        ></canvas>
        <div class="grid grid-cols-3 gap-1 mb-2 text-center">
          <div class="bg-navy-800/40 rounded-lg p-2">
            <div class="text-xl font-display font-bold text-white tabular-nums" id="play-reps">0</div>
            <div class="text-[9px] uppercase tracking-wider text-navy-300">REPS</div>
          </div>
          <div class="bg-navy-800/40 rounded-lg p-2">
            <div class="text-xl font-display font-bold text-brand-lime tabular-nums" id="play-form">—</div>
            <div class="text-[9px] uppercase tracking-wider text-navy-300">FORMA</div>
          </div>
          <div class="bg-navy-800/40 rounded-lg p-2">
            <div class="text-xl font-display font-bold text-orange-400 tabular-nums" id="play-best">0</div>
            <div class="text-[9px] uppercase tracking-wider text-navy-300">MELHOR</div>
          </div>
        </div>
        <div id="play-instruction" class="text-xs text-brand-lime text-center mb-2 font-bold"></div>
        <button id="play-action-btn" class="w-full bg-brand-lime text-navy-900 font-display font-bold rounded-lg py-4 text-lg hover:opacity-90 active:scale-95 transition select-none touch-none">
          SEGURA · ESPAÇO
        </button>
        <button id="play-end" class="w-full mt-2 bg-orange-500 text-white text-xs rounded-lg py-2 hover:opacity-90">Encerrar</button>
      </div>
    </div>

    <script is:inline>
      // ExerciseGame — cada exercício tem animação canvas onde o atleta
      // FAZ o movimento. Hold espaço/botão pra executar; soltar pra retornar.
      // Cada exercício tem fases distintas e timing critério pra forma boa.
      (function () {
        const LABELS = {
          bench: "🏋️ Bench Press",
          squat: "🦵 Back Squat",
          deadlift: "💪 Deadlift",
          pullup: "🤸 Pull-up",
          pushup: "🔽 Push-up",
          burpee: "💥 Burpee",
          boxjump: "📦 Box Jump",
          kbswing: "🪝 KB Swing",
        };
        const INSTRUCTIONS = {
          bench: "SEGURA pra empurrar a barra · solta pra descer",
          squat: "SEGURA pra subir do agachamento · solta pra descer",
          deadlift: "SEGURA pra puxar do chão · solta pra abaixar",
          pullup: "SEGURA pra subir até o queixo · solta pra descer",
          pushup: "SEGURA pra empurrar do chão · solta pra descer",
          burpee: "TAP rápido pra completar a sequência",
          boxjump: "TAP no momento certo pra pular no box",
          kbswing: "RITMO — TAP no topo de cada balanço",
        };
        const modal = document.getElementById("play-mode-modal");
        const titleEl = document.getElementById("play-title");
        const canvas = document.getElementById("play-canvas");
        const repsEl = document.getElementById("play-reps");
        const formEl = document.getElementById("play-form");
        const bestEl = document.getElementById("play-best");
        const instructionEl = document.getElementById("play-instruction");
        const closeBtn = document.getElementById("play-close");
        const actionBtn = document.getElementById("play-action-btn");
        const endBtn = document.getElementById("play-end");
        const ctx = canvas.getContext("2d");

        const W = canvas.width;
        const H = canvas.height;

        let currentExercise = null;
        let reps = 0;
        let phase = 0; // 0 = idle/down, 1 = transitioning up, 2 = up/peak, 3 = transitioning down
        let progress = 0; // 0 to 1 within phase
        let formScore = 0;
        let pressed = false;
        let lastTap = 0;
        let rafId = 0;
        let stopped = false;

        // === SKIN ===
        const SKIN = "#e0b18a";
        const HAIR = "#1a1410";
        const TOP = "#D8FF2C";
        const SHORTS = "#1e1b50";

        function drawHead(cx, cy, r) {
          ctx.fillStyle = SKIN;
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = HAIR;
          ctx.beginPath();
          ctx.arc(cx, cy - 2, r, Math.PI, 0);
          ctx.fill();
          // eye
          ctx.fillStyle = "#01002A";
          ctx.fillRect(cx + 3, cy - 1, 2, 2);
          // mouth
          ctx.strokeStyle = "#01002A";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(cx + 2, cy + 4, 2, 0, Math.PI);
          ctx.stroke();
        }

        function drawBackground() {
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, W, H);
          // floor
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(0, H - 40, W, 40);
          ctx.strokeStyle = "#D8FF2C";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(0, H - 40);
          ctx.lineTo(W, H - 40);
          ctx.stroke();
          // gym grid lines
          ctx.strokeStyle = "rgba(216,255,44,0.06)";
          ctx.lineWidth = 1;
          for (let i = 0; i < 5; i++) {
            ctx.beginPath();
            ctx.moveTo(0, 60 + i * 50);
            ctx.lineTo(W, 60 + i * 50);
            ctx.stroke();
          }
        }

        // === SQUAT ===
        function drawSquat(t) {
          // t = 0 (full squat down) → 1 (standing)
          drawBackground();
          const groundY = H - 40;
          // Back rack: barbell on shoulders, athlete squats
          const standHip = groundY - 90;
          const squatHip = groundY - 60;
          const hipY = squatHip + (standHip - squatHip) * t;
          const torsoLen = 50;
          const headY = hipY - torsoLen - 18;
          const cx = W / 2;
          // Coxa: angulada quando squat, reta quando standing
          const kneeY = groundY - 30 - (groundY - 30 - hipY) * 0.5;
          const kneeOffsetX = (1 - t) * 12;
          // Pernas
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 14;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(cx - 12, hipY);
          ctx.lineTo(cx - 14 - kneeOffsetX, kneeY);
          ctx.lineTo(cx - 14, groundY - 10);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 12, hipY);
          ctx.lineTo(cx + 14 + kneeOffsetX, kneeY);
          ctx.lineTo(cx + 14, groundY - 10);
          ctx.stroke();
          // Tenis
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(cx - 22, groundY - 12, 16, 8);
          ctx.fillRect(cx + 6, groundY - 12, 16, 8);
          ctx.fillStyle = "#D8FF2C";
          ctx.fillRect(cx - 22, groundY - 4, 16, 2);
          ctx.fillRect(cx + 6, groundY - 4, 16, 2);
          // Shorts
          ctx.fillStyle = SHORTS;
          ctx.fillRect(cx - 18, hipY - 6, 36, 18);
          // Torso (regata)
          ctx.fillStyle = TOP;
          const torsoLean = (1 - t) * 15;
          ctx.save();
          ctx.translate(cx, hipY);
          ctx.fillRect(-22, -torsoLen, 44, torsoLen);
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 14px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("PR", 0, -torsoLen + 24);
          ctx.restore();
          // Head
          drawHead(cx, headY, 14);
          // Bracos (segurando barbell sobre os trapezios)
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          ctx.beginPath();
          ctx.moveTo(cx - 22, hipY - torsoLen + 4);
          ctx.lineTo(cx - 36, headY - 8);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 22, hipY - torsoLen + 4);
          ctx.lineTo(cx + 36, headY - 8);
          ctx.stroke();
          // Barbell (sobre os trapezios, atras da nuca)
          const barY = headY - 4;
          ctx.fillStyle = "#dfe2e8";
          ctx.fillRect(cx - 90, barY, 180, 6);
          // Plates IWF
          ctx.fillStyle = "#DA291C";
          ctx.fillRect(cx - 100, barY - 14, 12, 34);
          ctx.fillRect(cx + 88, barY - 14, 12, 34);
          ctx.fillStyle = "#0057B8";
          ctx.fillRect(cx - 114, barY - 18, 12, 42);
          ctx.fillRect(cx + 102, barY - 18, 12, 42);
          // Power rack uprights atras
          ctx.fillStyle = "rgba(74,77,90,0.5)";
          ctx.fillRect(cx - 130, 30, 8, H - 70);
          ctx.fillRect(cx + 122, 30, 8, H - 70);
          ctx.fillRect(cx - 130, 30, 260, 6);
          // Depth indicator
          if (t < 0.15) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 18px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("PARALLEL!", cx, 25);
          }
        }

        // === BENCH PRESS ===
        function drawBench(t) {
          // t = 0 (bar down on chest) → 1 (arms locked out)
          drawBackground();
          const groundY = H - 40;
          const benchY = groundY - 50;
          const cx = W / 2;
          // Bench
          ctx.fillStyle = "#7c1f1f";
          ctx.fillRect(cx - 100, benchY, 200, 16);
          ctx.fillStyle = "#4a4d5a";
          ctx.fillRect(cx - 95, benchY + 16, 6, 30);
          ctx.fillRect(cx + 89, benchY + 16, 6, 30);
          // Athlete deitado
          // pernas pra baixo
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 14;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(cx + 60, benchY + 4);
          ctx.lineTo(cx + 100, groundY - 8);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 80, benchY + 4);
          ctx.lineTo(cx + 116, groundY - 8);
          ctx.stroke();
          // Tenis
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(cx + 92, groundY - 12, 18, 8);
          ctx.fillRect(cx + 108, groundY - 12, 18, 8);
          // Torso deitado (regata)
          ctx.fillStyle = TOP;
          ctx.fillRect(cx - 60, benchY - 4, 130, 10);
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 12px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("PR", cx, benchY + 5);
          // Cabeça (lateral)
          drawHead(cx - 80, benchY + 1, 12);
          // Bracos: t=0 dobrados, t=1 esticados
          const armBend = (1 - t);
          const elbowY = benchY - 2 - armBend * 25;
          const wristY = benchY - 30 - (1 - armBend) * 60;
          const elbowX = cx + 10;
          // Bracos
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          ctx.beginPath();
          ctx.moveTo(cx, benchY);
          ctx.lineTo(elbowX - 4, elbowY);
          ctx.lineTo(cx + 4, wristY + 6);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 5, benchY);
          ctx.lineTo(elbowX + 4, elbowY);
          ctx.lineTo(cx + 6, wristY + 6);
          ctx.stroke();
          // Barbell
          const barY = wristY;
          ctx.fillStyle = "#dfe2e8";
          ctx.fillRect(cx - 90, barY, 180, 6);
          // Plates
          ctx.fillStyle = "#DA291C";
          ctx.fillRect(cx - 100, barY - 14, 12, 34);
          ctx.fillRect(cx + 88, barY - 14, 12, 34);
          ctx.fillStyle = "#0057B8";
          ctx.fillRect(cx - 114, barY - 18, 12, 42);
          ctx.fillRect(cx + 102, barY - 18, 12, 42);
          // Lockout
          if (t > 0.85) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 16px sans-serif";
            ctx.fillText("LOCK OUT!", cx, 30);
          }
        }

        // === DEADLIFT ===
        function drawDeadlift(t) {
          // t = 0 (bar on floor) → 1 (lockout standing)
          drawBackground();
          const groundY = H - 40;
          const cx = W / 2;
          const standHip = groundY - 100;
          const startHip = groundY - 50;
          const hipY = startHip + (standHip - startHip) * t;
          const torsoLean = (1 - t) * 50; // graus
          const torsoTopY = hipY - 60 + torsoLean * 0.3;
          // Pernas
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 14;
          ctx.lineCap = "round";
          const kneeBend = (1 - t) * 18;
          ctx.beginPath();
          ctx.moveTo(cx - 12, hipY);
          ctx.lineTo(cx - 14 - kneeBend, hipY + 30);
          ctx.lineTo(cx - 14, groundY - 10);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 12, hipY);
          ctx.lineTo(cx + 14 + kneeBend, hipY + 30);
          ctx.lineTo(cx + 14, groundY - 10);
          ctx.stroke();
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(cx - 22, groundY - 12, 16, 8);
          ctx.fillRect(cx + 6, groundY - 12, 16, 8);
          // Shorts
          ctx.fillStyle = SHORTS;
          ctx.fillRect(cx - 18, hipY - 6, 36, 16);
          // Torso inclinado
          const torsoAngle = (1 - t) * 0.7; // radianos
          ctx.save();
          ctx.translate(cx, hipY);
          ctx.rotate(-torsoAngle);
          ctx.fillStyle = TOP;
          ctx.fillRect(-20, -55, 40, 55);
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 12px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("PR", 0, -32);
          // Cabeça em cima do torso inclinado
          ctx.restore();
          const headOffsetX = -Math.sin(torsoAngle) * 60;
          const headOffsetY = -Math.cos(torsoAngle) * 60;
          drawHead(cx + headOffsetX, hipY + headOffsetY, 12);
          // Bracos retos pra baixo segurando barra
          const barY = groundY - 30 - (groundY - 30 - (hipY + 4)) * t;
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          ctx.beginPath();
          ctx.moveTo(cx - 18, hipY - 10);
          ctx.lineTo(cx - 22, barY);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 18, hipY - 10);
          ctx.lineTo(cx + 22, barY);
          ctx.stroke();
          // Barbell
          ctx.fillStyle = "#dfe2e8";
          ctx.fillRect(cx - 100, barY, 200, 6);
          // Plates IWF (45cm = grandes)
          ctx.fillStyle = "#DA291C";
          ctx.beginPath();
          ctx.arc(cx - 110, barY + 3, 22, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(cx + 110, barY + 3, 22, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = "#FFC72C";
          ctx.beginPath();
          ctx.arc(cx - 130, barY + 3, 18, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(cx + 130, barY + 3, 18, 0, Math.PI * 2);
          ctx.fill();
          if (t > 0.9) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 16px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("LOCKOUT!", cx, 30);
          }
        }

        // === PULL-UP ===
        function drawPullup(t) {
          // t = 0 (hanging) → 1 (chin over bar)
          drawBackground();
          const cx = W / 2;
          // Pull-up bar
          const barY = 60;
          ctx.fillStyle = "#dfe2e8";
          ctx.fillRect(cx - 80, barY, 160, 6);
          ctx.fillStyle = "#4a4d5a";
          ctx.fillRect(cx - 80, barY - 30, 6, 30);
          ctx.fillRect(cx + 74, barY - 30, 6, 30);
          // Athlete pendurado
          const handY = barY + 6;
          const headY = handY + 60 - t * 40;
          const torsoTop = headY + 14;
          const hipY = torsoTop + 50;
          // Bracos: estendidos quando t=0, dobrados quando t=1
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          ctx.lineCap = "round";
          const elbowY = handY + 25 + t * 20;
          const elbowX = 30 + t * 10;
          ctx.beginPath();
          ctx.moveTo(cx - 30, handY);
          ctx.lineTo(cx - elbowX, elbowY);
          ctx.lineTo(cx - 22, torsoTop);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 30, handY);
          ctx.lineTo(cx + elbowX, elbowY);
          ctx.lineTo(cx + 22, torsoTop);
          ctx.stroke();
          // Maos agarrando a barra
          ctx.fillStyle = SKIN;
          ctx.beginPath();
          ctx.arc(cx - 30, handY, 6, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(cx + 30, handY, 6, 0, Math.PI * 2);
          ctx.fill();
          // Torso
          ctx.fillStyle = TOP;
          ctx.fillRect(cx - 22, torsoTop, 44, 50);
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 12px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("PR", cx, torsoTop + 30);
          // Cabeça
          drawHead(cx, headY, 12);
          // Shorts
          ctx.fillStyle = SHORTS;
          ctx.fillRect(cx - 18, hipY, 36, 16);
          // Pernas dobradas (joelhos pra frente)
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 12;
          ctx.beginPath();
          ctx.moveTo(cx - 12, hipY + 16);
          ctx.lineTo(cx - 18, hipY + 50);
          ctx.lineTo(cx - 6, hipY + 70);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 12, hipY + 16);
          ctx.lineTo(cx + 18, hipY + 50);
          ctx.lineTo(cx + 6, hipY + 70);
          ctx.stroke();
          // Tenis
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(cx - 14, hipY + 68, 16, 6);
          ctx.fillRect(cx - 2, hipY + 68, 16, 6);
          if (t > 0.85) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 16px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("CHIN OVER!", cx, 30);
          }
        }

        // === PUSH-UP ===
        function drawPushup(t) {
          // t = 0 (chest near floor) → 1 (arms extended)
          drawBackground();
          const groundY = H - 40;
          const cx = W / 2;
          // Plank position — corpo horizontal acima do chao
          const bodyY = groundY - 30 - t * 25;
          const headX = cx - 90;
          const feetX = cx + 90;
          const headY = bodyY - 4;
          // Pernas (paralelas ao chao)
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 12;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(cx + 30, bodyY + 4);
          ctx.lineTo(feetX, groundY - 10);
          ctx.stroke();
          // Tenis
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(feetX - 8, groundY - 12, 18, 8);
          // Shorts
          ctx.fillStyle = SHORTS;
          ctx.fillRect(cx + 10, bodyY - 4, 30, 12);
          // Torso (regata)
          ctx.fillStyle = TOP;
          ctx.fillRect(cx - 30, bodyY - 6, 50, 14);
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 11px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("PR", cx - 5, bodyY + 4);
          // Cabeça
          drawHead(headX + 14, headY - 2, 11);
          // Bracos (sob o corpo)
          const armBend = 1 - t;
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          const handX = cx - 30;
          const elbowY = bodyY + 12 + armBend * 14;
          const handY = groundY - 16;
          ctx.beginPath();
          ctx.moveTo(handX, bodyY + 6);
          ctx.lineTo(handX + 4, elbowY);
          ctx.lineTo(handX, handY);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(handX + 18, bodyY + 6);
          ctx.lineTo(handX + 22, elbowY);
          ctx.lineTo(handX + 18, handY);
          ctx.stroke();
          if (t > 0.85) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 16px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("EXTENDED!", cx, 30);
          }
        }

        // === BURPEE: tap por fase, 4 fases ===
        function drawBurpee(t, phase) {
          // phase 0 = standing, 1 = squat down, 2 = plank, 3 = jump up
          drawBackground();
          const groundY = H - 40;
          const cx = W / 2;
          if (phase === 0 || phase === 3) {
            // Standing
            const jumpY = phase === 3 ? -t * 40 : 0;
            ctx.strokeStyle = SKIN;
            ctx.lineWidth = 14;
            ctx.lineCap = "round";
            ctx.beginPath();
            ctx.moveTo(cx - 12, groundY - 60 + jumpY);
            ctx.lineTo(cx - 14, groundY - 10 + jumpY);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx + 12, groundY - 60 + jumpY);
            ctx.lineTo(cx + 14, groundY - 10 + jumpY);
            ctx.stroke();
            ctx.fillStyle = "#0a0a14";
            ctx.fillRect(cx - 22, groundY - 12 + jumpY, 16, 8);
            ctx.fillRect(cx + 6, groundY - 12 + jumpY, 16, 8);
            ctx.fillStyle = SHORTS;
            ctx.fillRect(cx - 18, groundY - 66 + jumpY, 36, 16);
            ctx.fillStyle = TOP;
            ctx.fillRect(cx - 22, groundY - 110 + jumpY, 44, 50);
            ctx.fillStyle = "#01002A";
            ctx.font = "bold 12px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("PR", cx, groundY - 80 + jumpY);
            drawHead(cx, groundY - 124 + jumpY, 13);
            // Bracos pra cima no jump
            ctx.strokeStyle = SKIN;
            ctx.lineWidth = 10;
            const armUp = phase === 3 ? -50 : 0;
            ctx.beginPath();
            ctx.moveTo(cx - 22, groundY - 100 + jumpY);
            ctx.lineTo(cx - 30, groundY - 70 + armUp + jumpY);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx + 22, groundY - 100 + jumpY);
            ctx.lineTo(cx + 30, groundY - 70 + armUp + jumpY);
            ctx.stroke();
          } else if (phase === 1) {
            // Squat down
            ctx.strokeStyle = SKIN;
            ctx.lineWidth = 14;
            ctx.beginPath();
            ctx.moveTo(cx - 12, groundY - 30);
            ctx.lineTo(cx - 22, groundY - 12);
            ctx.lineTo(cx - 14, groundY - 10);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(cx + 12, groundY - 30);
            ctx.lineTo(cx + 22, groundY - 12);
            ctx.lineTo(cx + 14, groundY - 10);
            ctx.stroke();
            ctx.fillStyle = SHORTS;
            ctx.fillRect(cx - 18, groundY - 36, 36, 16);
            ctx.fillStyle = TOP;
            ctx.fillRect(cx - 20, groundY - 70, 40, 36);
            drawHead(cx, groundY - 84, 13);
          } else if (phase === 2) {
            // Plank position
            ctx.strokeStyle = SKIN;
            ctx.lineWidth = 12;
            ctx.beginPath();
            ctx.moveTo(cx + 30, groundY - 18);
            ctx.lineTo(cx + 80, groundY - 10);
            ctx.stroke();
            ctx.fillStyle = SHORTS;
            ctx.fillRect(cx + 10, groundY - 22, 30, 12);
            ctx.fillStyle = TOP;
            ctx.fillRect(cx - 30, groundY - 24, 50, 14);
            drawHead(cx - 50, groundY - 22, 11);
            // bracos baixo
            ctx.strokeStyle = SKIN;
            ctx.lineWidth = 10;
            ctx.beginPath();
            ctx.moveTo(cx - 28, groundY - 14);
            ctx.lineTo(cx - 30, groundY - 8);
            ctx.stroke();
          }
          // Phase indicator
          const phaseNames = ["STAND", "SQUAT", "PLANK", "JUMP!"];
          ctx.fillStyle = "#D8FF2C";
          ctx.font = "bold 14px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(phaseNames[phase] + " (" + (phase + 1) + "/4)", cx, 25);
        }

        // === BOX JUMP ===
        function drawBoxJump(t) {
          drawBackground();
          const groundY = H - 40;
          const cx = W / 2;
          // Box
          const boxH = 70;
          ctx.fillStyle = "#5a3a1f";
          ctx.fillRect(cx - 50, groundY - boxH, 100, boxH);
          ctx.strokeStyle = "#D8FF2C";
          ctx.lineWidth = 2;
          ctx.strokeRect(cx - 50, groundY - boxH, 100, boxH);
          // Athlete: t<0.4 = approach + crouch, 0.4-0.6 jump, >0.6 land on box
          let athleteX = cx - 80 + t * 50;
          let athleteY = groundY;
          let crouching = t < 0.3;
          if (t >= 0.3 && t < 0.5) {
            // Jump arc
            const jumpT = (t - 0.3) / 0.2;
            athleteY = groundY - jumpT * (boxH + 20);
            athleteX = cx - 50 + jumpT * 50;
          } else if (t >= 0.5) {
            athleteX = cx;
            athleteY = groundY - boxH;
          }
          // Render athlete simple
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 12;
          ctx.lineCap = "round";
          const hipY = athleteY - 60;
          const headY = hipY - 70;
          if (crouching) {
            ctx.beginPath();
            ctx.moveTo(athleteX - 12, hipY + 10);
            ctx.lineTo(athleteX - 22, athleteY - 12);
            ctx.lineTo(athleteX - 14, athleteY - 10);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(athleteX + 12, hipY + 10);
            ctx.lineTo(athleteX + 22, athleteY - 12);
            ctx.lineTo(athleteX + 14, athleteY - 10);
            ctx.stroke();
          } else {
            ctx.beginPath();
            ctx.moveTo(athleteX - 12, hipY);
            ctx.lineTo(athleteX - 14, athleteY - 10);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(athleteX + 12, hipY);
            ctx.lineTo(athleteX + 14, athleteY - 10);
            ctx.stroke();
          }
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(athleteX - 22, athleteY - 12, 16, 8);
          ctx.fillRect(athleteX + 6, athleteY - 12, 16, 8);
          ctx.fillStyle = SHORTS;
          ctx.fillRect(athleteX - 18, hipY - 6, 36, 16);
          ctx.fillStyle = TOP;
          ctx.fillRect(athleteX - 22, hipY - 50, 44, 44);
          drawHead(athleteX, headY, 13);
          // Bracos balanco (durante jump pra cima)
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          const armUp = (t >= 0.3 && t < 0.5) ? -25 : 0;
          ctx.beginPath();
          ctx.moveTo(athleteX - 22, hipY - 40);
          ctx.lineTo(athleteX - 30, hipY - 10 + armUp);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(athleteX + 22, hipY - 40);
          ctx.lineTo(athleteX + 30, hipY - 10 + armUp);
          ctx.stroke();
          if (t > 0.85) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 16px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("ON THE BOX!", cx, 25);
          }
        }

        // === KB SWING ===
        function drawKBSwing(t) {
          // t = 0 (KB no chao) → 1 (KB no peito = topo do swing)
          drawBackground();
          const groundY = H - 40;
          const cx = W / 2;
          // Athlete em pe inclinado + bracos seguram KB
          const torsoLean = (1 - t) * 0.5;
          const hipY = groundY - 70;
          // Pernas
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 14;
          ctx.lineCap = "round";
          const kneeBend = (1 - t) * 8;
          ctx.beginPath();
          ctx.moveTo(cx - 12, hipY);
          ctx.lineTo(cx - 14 - kneeBend, hipY + 30);
          ctx.lineTo(cx - 14, groundY - 10);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 12, hipY);
          ctx.lineTo(cx + 14 + kneeBend, hipY + 30);
          ctx.lineTo(cx + 14, groundY - 10);
          ctx.stroke();
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(cx - 22, groundY - 12, 16, 8);
          ctx.fillRect(cx + 6, groundY - 12, 16, 8);
          ctx.fillStyle = SHORTS;
          ctx.fillRect(cx - 18, hipY - 6, 36, 16);
          // Torso inclinado
          ctx.save();
          ctx.translate(cx, hipY);
          ctx.rotate(-torsoLean);
          ctx.fillStyle = TOP;
          ctx.fillRect(-22, -55, 44, 55);
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 12px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("PR", 0, -32);
          ctx.restore();
          const headOffsetX = -Math.sin(torsoLean) * 60;
          const headOffsetY = -Math.cos(torsoLean) * 60;
          drawHead(cx + headOffsetX, hipY + headOffsetY - 5, 13);
          // KB swing arc (de baixo entre as pernas até peito)
          const angle = -Math.PI / 2 - (1 - t) * Math.PI / 2; // -90 (chest) to -180 (between legs)
          const kbX = cx + Math.cos(angle) * 60;
          const kbY = hipY + Math.sin(angle) * 60;
          // Bracos retos seguindo a KB
          ctx.strokeStyle = SKIN;
          ctx.lineWidth = 10;
          ctx.beginPath();
          ctx.moveTo(cx - 18, hipY - 10);
          ctx.lineTo(kbX - 4, kbY);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx + 18, hipY - 10);
          ctx.lineTo(kbX + 4, kbY);
          ctx.stroke();
          // KB
          ctx.fillStyle = "#141420";
          ctx.beginPath();
          ctx.arc(kbX, kbY + 8, 16, 0, Math.PI * 2);
          ctx.fill();
          // Handle
          ctx.strokeStyle = "#dfe2e8";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.arc(kbX, kbY - 5, 9, Math.PI, 0);
          ctx.stroke();
          // Numero peso
          ctx.fillStyle = "#D8FF2C";
          ctx.font = "bold 9px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("16", kbX, kbY + 11);
          if (t > 0.9) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 16px sans-serif";
            ctx.fillText("CHEST HEIGHT!", cx, 25);
          }
        }

        // === RENDER MAP ===
        const RENDERERS = {
          squat: drawSquat,
          bench: drawBench,
          deadlift: drawDeadlift,
          pullup: drawPullup,
          pushup: drawPushup,
          boxjump: drawBoxJump,
          kbswing: drawKBSwing,
        };

        function loop() {
          if (stopped) return;
          if (currentExercise === "burpee") {
            // 4-phase tap-driven
            drawBurpee(progress, phase);
          } else if (RENDERERS[currentExercise]) {
            // hold-and-release smooth animation
            const targetSpeed = pressed ? 0.025 : -0.025;
            progress = Math.max(0, Math.min(1, progress + targetSpeed));
            RENDERERS[currentExercise](progress);
            // Conta rep quando pico (ou vale)
            // Cada exercicio tem ciclo: 0 → 1 (subir) → 0 (descer) = 1 rep
          }
          rafId = requestAnimationFrame(loop);
        }

        function bumpRep() {
          reps++;
          repsEl.textContent = String(reps);
          // Forma score: variação realista
          const formScores = ["A+", "A", "B+", "B"];
          formEl.textContent = formScores[Math.floor(Math.random() * formScores.length)];
        }

        function open(exercise) {
          currentExercise = exercise;
          reps = 0;
          progress = 0;
          phase = 0;
          pressed = false;
          stopped = false;
          titleEl.textContent = LABELS[exercise] || "Exercício";
          instructionEl.textContent = INSTRUCTIONS[exercise] || "";
          repsEl.textContent = "0";
          formEl.textContent = "—";
          const best = localStorage.getItem("pr_play_best_" + exercise) || "0";
          bestEl.textContent = best;
          // Adapt button text
          if (exercise === "burpee" || exercise === "boxjump" || exercise === "kbswing") {
            actionBtn.textContent = "TAP · ESPAÇO";
          } else {
            actionBtn.textContent = "SEGURA · ESPAÇO";
          }
          modal.classList.remove("hidden");
          modal.classList.add("flex");
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(loop);
        }
        function close() {
          if (currentExercise) {
            const prevBest = Number(localStorage.getItem("pr_play_best_" + currentExercise) || "0");
            if (reps > prevBest) localStorage.setItem("pr_play_best_" + currentExercise, String(reps));
          }
          stopped = true;
          if (rafId) cancelAnimationFrame(rafId);
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          currentExercise = null;
        }

        // Track quando completou rep (peak detection)
        let lastProgress = 0;
        let wasUp = false;
        setInterval(function () {
          if (!currentExercise || stopped) return;
          if (currentExercise === "burpee" || currentExercise === "boxjump" || currentExercise === "kbswing") return;
          if (progress > 0.92 && !wasUp) {
            wasUp = true;
            bumpRep();
          }
          if (progress < 0.08 && wasUp) wasUp = false;
        }, 50);

        // Tap-driven exercises
        function tapAction() {
          if (currentExercise === "burpee") {
            phase = (phase + 1) % 4;
            if (phase === 0) bumpRep();
          } else if (currentExercise === "boxjump") {
            // Animar 0 → 1 → 0
            progress = 1;
            bumpRep();
            setTimeout(function () { progress = 0; }, 600);
          } else if (currentExercise === "kbswing") {
            const now = Date.now();
            const delta = now - lastTap;
            lastTap = now;
            // Bom timing = entre 0.6s e 1.2s
            if (delta > 500 && delta < 1500) bumpRep();
            progress = 1;
            setTimeout(function () { progress = 0; }, 400);
          }
        }

        function press() {
          pressed = true;
          if (currentExercise === "burpee" || currentExercise === "boxjump" || currentExercise === "kbswing") {
            tapAction();
          }
        }
        function release() {
          pressed = false;
        }

        window.addEventListener("playmode:open", function (ev) {
          const detail = ev.detail || {};
          if (detail.exercise) open(detail.exercise);
        });
        closeBtn?.addEventListener("click", close);
        endBtn?.addEventListener("click", close);
        actionBtn?.addEventListener("pointerdown", function (e) { e.preventDefault(); press(); });
        actionBtn?.addEventListener("pointerup", function (e) { e.preventDefault(); release(); });
        actionBtn?.addEventListener("pointercancel", release);
        actionBtn?.addEventListener("pointerleave", release);
        window.addEventListener("keydown", function (e) {
          if (modal.classList.contains("hidden")) return;
          if (e.code === "Space") {
            e.preventDefault();
            if (!pressed) press();
          } else if (e.code === "Escape") {
            close();
          }
        });
        window.addEventListener("keyup", function (e) {
          if (modal.classList.contains("hidden")) return;
          if (e.code === "Space") {
            e.preventDefault();
            release();
          }
        });
      })();
    </script>
  </body>
</html>

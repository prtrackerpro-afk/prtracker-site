---
export const prerender = false;
import "../../styles/global.css";
import { getServerSupabase } from "../../lib/supabase/server";
import { exerciseLabel, type ExerciseId } from "../../lib/pr/exercises";
import BottomNav from "../../components/pr/BottomNav.astro";

const athlete = Astro.locals.athlete!; // gated by middleware

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

// pr_friend_feed RPC returns recent PR-true records from athletes the
// caller follows + their own. Reactions joined as a jsonb count map.
const { data: feed = [] } = await supabase.rpc("pr_friend_feed", {
  p_limit: 50,
  p_before_iso: null,
});

// V16: Gym Rats — frequência de treino dos amigos nos últimos 7 dias.
const { data: gymRats = [] } = await supabase.rpc("pr_friends_workout_frequency", {
  p_days: 7,
});

interface GymRatRow {
  user_id: string;
  display_name: string | null;
  instagram_handle: string | null;
  workout_days: number;
  last_workout_date: string;
}
const ratRows = (gymRats ?? []) as GymRatRow[];

interface FeedRow {
  record_id: string;
  user_id: string;
  display_name: string | null;
  instagram_handle: string | null;
  exercise: ExerciseId;
  weight_kg: number;
  performed_at: string;
  created_at: string;
  reactions: Record<string, number>;
}

const rows = (feed ?? []) as FeedRow[];

// Fetch own reactions for visible records so we can pre-fill the "you reacted"
// state on the buttons. Set keyed by `${recordId}:${emoji}`.
const ownReactionSet = new Set<string>();
if (rows.length > 0) {
  const recordIds = rows.map((r) => r.record_id);
  const { data: ownReacts = [] } = await supabase
    .from("pr_reactions")
    .select("record_id, emoji")
    .eq("user_id", athlete.userId)
    .in("record_id", recordIds);
  for (const r of ownReacts ?? []) {
    ownReactionSet.add(`${r.record_id}:${r.emoji}`);
  }
}

const REACTION_EMOJIS = ["🔥", "💪", "🇧🇷", "👏", "🤘", "⭐"] as const;

function fmtRelative(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const minutes = Math.floor(ms / 60000);
  if (minutes < 1) return "agora";
  if (minutes < 60) return `${minutes}min`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days}d`;
  return new Date(iso).toLocaleDateString("pt-BR", { day: "2-digit", month: "short" });
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Feed · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
  </head>
  <script
    define:vars={{
      anonKey: import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "",
      supabaseUrl: import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL ?? "",
    }}
  >
    // Hand the runtime keys to the client realtime subscriber. Anon key
    // is safe to expose — RLS gates writes; reads of pr_records still
    // pass through the SECURITY DEFINER function (pr_friend_feed) so
    // even with the key, athletes only see records they're entitled to.
    window.__PR_SUPA__ = { url: supabaseUrl, anon: anonKey };
  </script>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto flex items-center justify-between">
      <a href="/pr" class="text-xs text-navy-300 hover:text-white">← Meus PRs</a>
      <h1 class="font-display text-xl tracking-tight flex items-center gap-2 text-brand-lime">
        Feed
        <span
          id="live-pill"
          class="hidden text-[9px] uppercase tracking-[0.2em] rounded-full bg-brand-lime/15 text-brand-lime border border-brand-lime/40 px-1.5 py-0.5 inline-flex items-center gap-1"
          title="Conectado ao feed em tempo real"
        >
          <span id="live-dot" class="inline-block w-1.5 h-1.5 rounded-full bg-brand-lime animate-pulse"></span>
          Ao vivo
        </span>
      </h1>
      <a href="/pr/atletas" class="text-xs text-brand-lime hover:underline">+ Seguir</a>
    </header>

    {/* Realtime banner — fires when a new PR drops while page is open */}
    <div
      id="new-pr-banner"
      class="hidden fixed top-16 left-1/2 -translate-x-1/2 z-50 rounded-full bg-brand-lime text-navy-900 font-semibold text-xs px-4 py-2 shadow-lg shadow-brand-lime/40 cursor-pointer animate-bounce"
    >
      <span id="new-pr-count">0</span> novo PR. Toque pra ver →
    </div>

    <main class="max-w-2xl mx-auto px-4">
      {/* V16: Gym Rats — frequência semanal dos amigos */}
      {ratRows.length > 0 && (
        <section class="mb-4 rounded-2xl border border-orange-500/40 bg-orange-500/5 p-3">
          <div class="flex items-center justify-between mb-2">
            <div>
              <div class="text-[10px] uppercase tracking-[0.3em] text-orange-300">
                🔥 GYM RATS
              </div>
              <div class="text-xs text-navy-300">
                Amigos com mais treinos essa semana
              </div>
            </div>
            <span class="text-[10px] text-navy-400">7 dias</span>
          </div>
          <ul class="space-y-1.5">
            {ratRows.slice(0, 5).map((rat, i) => {
              const isHot = rat.workout_days >= 5;
              const isWarm = rat.workout_days >= 3;
              const fireColor = isHot ? "#ff44aa" : isWarm ? "#ff8030" : "#ffa050";
              return (
                <li
                  class="flex items-center gap-2.5 rounded-lg bg-navy-900/40 border border-navy-700 px-3 py-2"
                  style={i === 0 ? `border-color: ${fireColor}66; background: ${fireColor}10` : ""}
                >
                  <span class="text-base flex-shrink-0">
                    {i === 0 ? "👑" : i + 1 + "."}
                  </span>
                  <a
                    href={rat.instagram_handle ? `/pr/gym/${rat.instagram_handle}` : "#"}
                    class="flex-1 min-w-0 hover:text-brand-lime transition"
                  >
                    <div class="text-sm font-semibold truncate">
                      {rat.display_name ?? "Atleta"}
                    </div>
                    {rat.instagram_handle && (
                      <div class="text-[10px] text-navy-300 truncate">
                        @{rat.instagram_handle}
                      </div>
                    )}
                  </a>
                  <div class="text-right flex-shrink-0">
                    <div
                      class="font-display text-base tabular-nums leading-none"
                      style={`color: ${fireColor}`}
                    >
                      {rat.workout_days}
                    </div>
                    <div class="text-[9px] uppercase tracking-widest text-navy-300 leading-none mt-0.5">
                      {rat.workout_days === 1 ? "dia" : "dias"}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {rows.length === 0 ? (
        <div class="rounded-2xl border border-navy-700 bg-navy-800/30 p-8 text-center">
          <div class="text-3xl mb-2">👀</div>
          <p class="text-sm text-navy-300 mb-4">
            Nenhum PR aparece aqui ainda. Siga atletas pra ver os PRs deles em tempo real.
          </p>
          <a href="/pr/atletas" class="inline-block text-xs bg-brand-lime text-navy-900 font-semibold rounded px-3 py-1.5">
            Encontrar atletas
          </a>
        </div>
      ) : (
        <ul class="space-y-3">
          {rows.map((row) => (
            <li class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4">
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <div class="min-w-0">
                  {row.instagram_handle && row.user_id !== athlete.userId ? (
                    <a
                      href={`/pr/gym/${row.instagram_handle}`}
                      class="block hover:text-brand-lime transition"
                      title="Visitar ginásio"
                    >
                      <div class="font-semibold truncate">{row.display_name ?? "Atleta"}</div>
                      <div class="text-[11px] text-navy-300 truncate">@{row.instagram_handle}</div>
                    </a>
                  ) : (
                    <>
                      <div class="font-semibold truncate">
                        {row.display_name ?? "Atleta"}
                        {row.user_id === athlete.userId && (
                          <span class="text-[10px] text-brand-lime ml-1.5">VOCÊ</span>
                        )}
                      </div>
                      {row.instagram_handle && (
                        <div class="text-[11px] text-navy-300 truncate">@{row.instagram_handle}</div>
                      )}
                    </>
                  )}
                </div>
                <div class="text-[10px] text-navy-300 flex-shrink-0">{fmtRelative(row.created_at)}</div>
              </div>

              <div class="flex items-end justify-between mb-3 pb-3 border-b border-navy-700">
                <div class="min-w-0">
                  <div class="text-[10px] uppercase tracking-widest text-brand-lime">PR</div>
                  <div class="font-display text-base leading-tight truncate">
                    {exerciseLabel(row.exercise)}
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-display text-3xl tabular-nums text-brand-lime">
                    {row.weight_kg}
                  </div>
                  <div class="text-[10px] uppercase tracking-wider text-navy-300">kg</div>
                </div>
              </div>

              {/* Reactions */}
              <div class="flex flex-wrap gap-1.5" data-react-row data-record-id={row.record_id}>
                {REACTION_EMOJIS.map((emoji) => {
                  const count = row.reactions?.[emoji] ?? 0;
                  const own = ownReactionSet.has(`${row.record_id}:${emoji}`);
                  return (
                    <button
                      type="button"
                      class={`text-base rounded-full border px-3 py-1.5 transition flex items-center gap-1.5 ${
                        own
                          ? "border-brand-lime/70 bg-brand-lime/15 text-brand-lime"
                          : "border-navy-600 bg-navy-900/50 text-white hover:bg-navy-800 hover:border-brand-lime/40"
                      }`}
                      data-react-btn
                      data-emoji={emoji}
                      data-own={own ? "1" : "0"}
                      aria-pressed={own}
                    >
                      <span>{emoji}</span>
                      {count > 0 && (
                        <span class={`text-[10px] tabular-nums ${own ? "text-brand-lime" : "text-navy-300"}`}>
                          {count}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>

    <BottomNav active="feed" />

    <script>
      // === Realtime: subscribe to new PR-true records via Supabase ====
      // When a friend logs a PR, the green dot pulses and a banner appears
      // offering to refresh the feed. We do NOT auto-prepend rows because
      // RLS doesn't expose other athletes' records on the client — we'd
      // need to re-fetch via the SECURITY DEFINER feed function. Cheaper
      // to just nudge the user to reload.
      (async () => {
        const cfg = (window as typeof window & { __PR_SUPA__?: { url: string; anon: string } }).__PR_SUPA__;
        if (!cfg?.url || !cfg.anon) return;
        const livePill = document.getElementById("live-pill");
        const banner = document.getElementById("new-pr-banner");
        const countEl = document.getElementById("new-pr-count");
        if (!livePill || !banner || !countEl) return;

        let newCount = 0;
        banner.addEventListener("click", () => window.location.reload());

        try {
          const { createClient } = await import("https://esm.sh/@supabase/supabase-js@2.45.0");
          const sb = createClient(cfg.url, cfg.anon);
          const ch = sb
            .channel("pr-feed")
            .on(
              "postgres_changes",
              { event: "INSERT", schema: "public", table: "pr_records" },
              (payload) => {
                if (!payload.new || !(payload.new as { is_personal_record?: boolean }).is_personal_record) return;
                newCount += 1;
                countEl.textContent = String(newCount);
                banner.classList.remove("hidden");
              }
            )
            .subscribe((status) => {
              livePill.classList.toggle("hidden", status !== "SUBSCRIBED");
            });
          window.addEventListener("beforeunload", () => sb.removeChannel(ch));
        } catch {
          // ESM CDN unreachable — degrade silently to non-realtime.
        }
      })();

      // === Reaction buttons =============================================
      // Optimistic UI: click flips the visual state immediately, then the
      // API confirms or reverts. `data-own` tracks whether the current user
      // has reacted with this emoji on this record.
      const OWN_CLASSES = [
        "border-brand-lime/70",
        "bg-brand-lime/15",
        "text-brand-lime",
      ] as const;
      const IDLE_CLASSES = [
        "border-navy-600",
        "bg-navy-900/50",
        "text-white",
        "hover:bg-navy-800",
        "hover:border-brand-lime/40",
      ] as const;

      function applyOwnState(btn: HTMLButtonElement, own: boolean): void {
        btn.dataset.own = own ? "1" : "0";
        btn.setAttribute("aria-pressed", own ? "true" : "false");
        for (const c of OWN_CLASSES) btn.classList.toggle(c, own);
        for (const c of IDLE_CLASSES) btn.classList.toggle(c, !own);
        const countEl = btn.querySelector("[data-count]") as HTMLSpanElement | null;
        if (countEl) {
          countEl.classList.toggle("text-brand-lime", own);
          countEl.classList.toggle("text-navy-300", !own);
        }
      }

      function setCount(btn: HTMLButtonElement, count: number): void {
        let countEl = btn.querySelector("[data-count]") as HTMLSpanElement | null;
        if (count <= 0) {
          countEl?.remove();
          return;
        }
        if (!countEl) {
          countEl = document.createElement("span");
          countEl.dataset.count = "1";
          countEl.className = "text-[10px] tabular-nums";
          countEl.classList.add(btn.dataset.own === "1" ? "text-brand-lime" : "text-navy-300");
          btn.appendChild(countEl);
        }
        countEl.textContent = String(count);
      }

      // Tag existing count spans so the helpers can find them.
      document.querySelectorAll<HTMLButtonElement>("[data-react-btn]").forEach((btn) => {
        const countEl = btn.querySelector("span:last-child");
        if (countEl && countEl !== btn.querySelector("span:first-child")) {
          (countEl as HTMLSpanElement).dataset.count = "1";
        }
      });

      document.querySelectorAll<HTMLElement>("[data-react-row]").forEach((row) => {
        const recordId = row.dataset.recordId;
        if (!recordId) return;
        row.querySelectorAll<HTMLButtonElement>("[data-react-btn]").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const emoji = btn.dataset.emoji;
            if (!emoji) return;
            const wasOwn = btn.dataset.own === "1";
            const willBeOwn = !wasOwn;
            const countEl = btn.querySelector("[data-count]") as HTMLSpanElement | null;
            const prevCount = countEl ? parseInt(countEl.textContent ?? "0", 10) || 0 : 0;
            // Optimistic flip
            btn.disabled = true;
            applyOwnState(btn, willBeOwn);
            setCount(btn, prevCount + (willBeOwn ? 1 : -1));
            try {
              const res = await fetch(`/api/pr/reactions/${recordId}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ emoji }),
              });
              if (!res.ok) throw new Error("react failed");
              const body = await res.json().catch(() => ({}));
              // Server is the source of truth — sync visual state
              const finalOwn = body.toggled === "on";
              if (finalOwn !== willBeOwn) {
                applyOwnState(btn, finalOwn);
                setCount(btn, prevCount + (finalOwn ? 1 : -1) + (willBeOwn === finalOwn ? 0 : 0));
              }
            } catch {
              // Revert on network/server error
              applyOwnState(btn, wasOwn);
              setCount(btn, prevCount);
            } finally {
              btn.disabled = false;
            }
          });
        });
      });
    </script>
  </body>
</html>

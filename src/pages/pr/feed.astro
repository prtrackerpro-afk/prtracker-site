---
export const prerender = false;
import "../../styles/global.css";
import { getServerSupabase } from "../../lib/supabase/server";
import { exerciseLabel, type ExerciseId } from "../../lib/pr/exercises";

const athlete = Astro.locals.athlete!; // gated by middleware

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

// pr_friend_feed RPC returns recent PR-true records from athletes the
// caller follows + their own. Reactions joined as a jsonb count map.
const { data: feed = [] } = await supabase.rpc("pr_friend_feed", {
  p_limit: 50,
  p_before_iso: null,
});

interface FeedRow {
  record_id: string;
  user_id: string;
  display_name: string | null;
  instagram_handle: string | null;
  exercise: ExerciseId;
  weight_kg: number;
  performed_at: string;
  created_at: string;
  reactions: Record<string, number>;
}

const rows = (feed ?? []) as FeedRow[];

const REACTION_EMOJIS = ["🔥", "💪", "🇧🇷", "👏", "🤘", "⭐"] as const;

function fmtRelative(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const minutes = Math.floor(ms / 60000);
  if (minutes < 1) return "agora";
  if (minutes < 60) return `${minutes}min`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days}d`;
  return new Date(iso).toLocaleDateString("pt-BR", { day: "2-digit", month: "short" });
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Feed · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
  </head>
  <script
    define:vars={{
      anonKey: import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "",
      supabaseUrl: import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL ?? "",
    }}
  >
    // Hand the runtime keys to the client realtime subscriber. Anon key
    // is safe to expose — RLS gates writes; reads of pr_records still
    // pass through the SECURITY DEFINER function (pr_friend_feed) so
    // even with the key, athletes only see records they're entitled to.
    window.__PR_SUPA__ = { url: supabaseUrl, anon: anonKey };
  </script>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto flex items-center justify-between">
      <a href="/pr" class="text-xs text-navy-300 hover:text-white">← Meus PRs</a>
      <h1 class="font-display text-base tracking-tight flex items-center gap-2">
        Feed
        <span id="live-dot" class="inline-block w-1.5 h-1.5 rounded-full bg-navy-700" title="conexão realtime"></span>
      </h1>
      <a href="/pr/atletas" class="text-xs text-brand-lime hover:underline">+ Seguir</a>
    </header>

    {/* Realtime banner — fires when a new PR drops while page is open */}
    <div
      id="new-pr-banner"
      class="hidden fixed top-16 left-1/2 -translate-x-1/2 z-50 rounded-full bg-brand-lime text-navy-900 font-semibold text-xs px-4 py-2 shadow-lg shadow-brand-lime/40 cursor-pointer animate-bounce"
    >
      <span id="new-pr-count">0</span> novo PR. Toque pra ver →
    </div>

    <main class="max-w-2xl mx-auto px-4">
      {rows.length === 0 ? (
        <div class="rounded-2xl border border-navy-700 bg-navy-800/30 p-8 text-center">
          <div class="text-3xl mb-2">👀</div>
          <p class="text-sm text-navy-300 mb-4">
            Nenhum PR aparece aqui ainda. Siga atletas pra ver os PRs deles em tempo real.
          </p>
          <a href="/pr/atletas" class="inline-block text-xs bg-brand-lime text-navy-900 font-semibold rounded px-3 py-1.5">
            Encontrar atletas
          </a>
        </div>
      ) : (
        <ul class="space-y-3">
          {rows.map((row) => (
            <li class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4">
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <div class="min-w-0">
                  <div class="font-semibold truncate">
                    {row.display_name ?? "Atleta"}
                    {row.user_id === athlete.userId && (
                      <span class="text-[10px] text-brand-lime ml-1.5">VOCÊ</span>
                    )}
                  </div>
                  {row.instagram_handle && (
                    <div class="text-[11px] text-navy-300 truncate">@{row.instagram_handle}</div>
                  )}
                </div>
                <div class="text-[10px] text-navy-300 flex-shrink-0">{fmtRelative(row.created_at)}</div>
              </div>

              <div class="flex items-end justify-between mb-3 pb-3 border-b border-navy-700">
                <div class="min-w-0">
                  <div class="text-[10px] uppercase tracking-widest text-brand-lime">PR</div>
                  <div class="font-display text-base leading-tight truncate">
                    {exerciseLabel(row.exercise)}
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-display text-3xl tabular-nums text-brand-lime">
                    {row.weight_kg}
                  </div>
                  <div class="text-[10px] uppercase tracking-wider text-navy-300">kg</div>
                </div>
              </div>

              {/* Reactions */}
              <div class="flex flex-wrap gap-1.5" data-react-row data-record-id={row.record_id}>
                {REACTION_EMOJIS.map((emoji) => {
                  const count = row.reactions?.[emoji] ?? 0;
                  return (
                    <button
                      type="button"
                      class="text-sm rounded-full border border-navy-600 bg-navy-900/50 px-2.5 py-1 hover:bg-navy-800 transition flex items-center gap-1"
                      data-react-btn
                      data-emoji={emoji}
                    >
                      <span>{emoji}</span>
                      {count > 0 && (
                        <span class="text-[10px] tabular-nums text-navy-300">{count}</span>
                      )}
                    </button>
                  );
                })}
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>

    <script>
      // === Realtime: subscribe to new PR-true records via Supabase ====
      // When a friend logs a PR, the green dot pulses and a banner appears
      // offering to refresh the feed. We do NOT auto-prepend rows because
      // RLS doesn't expose other athletes' records on the client — we'd
      // need to re-fetch via the SECURITY DEFINER feed function. Cheaper
      // to just nudge the user to reload.
      (async () => {
        const cfg = (window as typeof window & { __PR_SUPA__?: { url: string; anon: string } }).__PR_SUPA__;
        if (!cfg?.url || !cfg.anon) return;
        const liveDot = document.getElementById("live-dot");
        const banner = document.getElementById("new-pr-banner");
        const countEl = document.getElementById("new-pr-count");
        if (!liveDot || !banner || !countEl) return;

        let newCount = 0;
        banner.addEventListener("click", () => window.location.reload());

        try {
          const { createClient } = await import("https://esm.sh/@supabase/supabase-js@2.45.0");
          const sb = createClient(cfg.url, cfg.anon);
          const ch = sb
            .channel("pr-feed")
            .on(
              "postgres_changes",
              { event: "INSERT", schema: "public", table: "pr_records" },
              (payload) => {
                if (!payload.new || !(payload.new as { is_personal_record?: boolean }).is_personal_record) return;
                newCount += 1;
                countEl.textContent = String(newCount);
                banner.classList.remove("hidden");
              }
            )
            .subscribe((status) => {
              liveDot.classList.toggle("bg-brand-lime", status === "SUBSCRIBED");
              liveDot.classList.toggle("animate-pulse", status === "SUBSCRIBED");
              liveDot.classList.toggle("bg-navy-700", status !== "SUBSCRIBED");
            });
          window.addEventListener("beforeunload", () => sb.removeChannel(ch));
        } catch {
          // ESM CDN unreachable — degrade silently to non-realtime.
        }
      })();

      // === Reaction buttons (existing) =================================
      // Wire up reaction buttons — optimistic UI, revert on error.
      document.querySelectorAll<HTMLElement>("[data-react-row]").forEach((row) => {
        const recordId = row.dataset.recordId;
        if (!recordId) return;
        row.querySelectorAll<HTMLButtonElement>("[data-react-btn]").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const emoji = btn.dataset.emoji;
            if (!emoji) return;
            btn.disabled = true;
            const countEl = btn.querySelector("span:last-child");
            const prev = countEl?.textContent ?? "0";
            const prevNum = parseInt(prev, 10) || 0;
            // Optimistic +1
            if (countEl) {
              countEl.textContent = String(prevNum + 1);
            } else {
              const span = document.createElement("span");
              span.className = "text-[10px] tabular-nums text-navy-300";
              span.textContent = "1";
              btn.appendChild(span);
            }
            try {
              const res = await fetch(`/api/pr/reactions/${recordId}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ emoji }),
              });
              if (!res.ok) throw new Error("react failed");
              const body = await res.json().catch(() => ({}));
              // If the server toggled OFF, decrement back below previous
              if (body.toggled === "off" && countEl) {
                const next = Math.max(0, prevNum - 1);
                countEl.textContent = String(next);
                if (next === 0) countEl.remove();
              }
            } catch {
              // Revert
              if (countEl) {
                countEl.textContent = String(prevNum);
                if (prevNum === 0) countEl.remove();
              }
            } finally {
              btn.disabled = false;
            }
          });
        });
      });
    </script>
  </body>
</html>

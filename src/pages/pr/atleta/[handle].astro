---
export const prerender = false;
import "../../../styles/global.css";
import { getAdminSupabase } from "../../../lib/supabase/server";
import { getAuthenticatedAthlete } from "../../../lib/pr/auth";
import { exerciseLabel, productSlugForExercise, type ExerciseId } from "../../../lib/pr/exercises";
import { summarize, tierLabel, tierColor, TIER_META, type Tier } from "../../../lib/pr/strength-score";
import { configuratorQuery } from "../../../lib/pr/plates";
import TrophyWall from "../../../components/pr/TrophyWall.astro";

// PUBLIC athlete profile, indexed by Instagram handle. No auth required —
// this is the shareable link an athlete posts in their bio. Renders the
// Lifter Card + Strength Tier + Trophy Wall (read-only) so visitors can
// see what the app is and create their own.
//
// Squad invite (V18): quando o link tem `?invite=1`, mostramos um banner
// destacado pra aceitar o convite e seguir o atleta. Se o visitante não
// estiver logado, manda pro login com retorno + auto-follow.

const handle = (Astro.params.handle ?? "").trim().toLowerCase();
if (!handle) return new Response("Missing handle", { status: 400 });

const url = new URL(Astro.request.url);
const inviteMode = url.searchParams.get("invite") === "1";
const autoAccept = url.searchParams.get("auto") === "1";

// Visitor athlete (pode estar logado mesmo sendo página pública)
const visitor = await getAuthenticatedAthlete(Astro);

// Service-role read (RLS would block cross-athlete reads). Safe because
// we only return the columns the athlete chose to make discoverable
// (no email, no body data — body data ratio used in tiers stays opaque).
const sb = getAdminSupabase();

const { data: profile } = await sb
  .from("pr_athletes")
  .select("user_id, display_name, instagram_handle, body_weight_kg, sex")
  .ilike("instagram_handle", handle)
  .maybeSingle();

if (!profile || !profile.display_name) {
  return new Response("Atleta não encontrado", { status: 404 });
}

const { data: bestRows = [] } = await sb
  .from("pr_best_lifts")
  .select("exercise, weight_kg, performed_at")
  .eq("user_id", profile.user_id);

const bestLifts: Partial<Record<ExerciseId, number>> = {};
for (const r of bestRows ?? []) {
  bestLifts[r.exercise as ExerciseId] = Number(r.weight_kg);
}

const summary = summarize({
  bodyWeightKg: profile.body_weight_kg != null ? Number(profile.body_weight_kg) : null,
  sex: (profile.sex as "male" | "female" | undefined) ?? null,
  bestLifts,
});

const sortedLifts = [...summary.lifts].sort(
  (a, b) => TIER_META[b.tier].rank - TIER_META[a.tier].rank || b.ratio - a.ratio
);

const overallTier: Tier | null = summary.hasBodyData ? summary.overallTier : null;
const tColor = overallTier ? tierColor(overallTier) : "#D8FF2C";
const tName = overallTier ? tierLabel(overallTier).toUpperCase() : "ATLETA";

// Squad invite state — só verifica follow se visitante logado e diferente do dono
let isSelf = false;
let alreadyFollowing = false;
if (inviteMode && visitor) {
  isSelf = visitor.userId === profile.user_id;
  if (!isSelf) {
    const { data: existing } = await sb
      .from("pr_follows")
      .select("follower_id")
      .eq("follower_id", visitor.userId)
      .eq("followee_id", profile.user_id)
      .maybeSingle();
    alreadyFollowing = !!existing;
  }
}

const SITE = (import.meta.env.PUBLIC_SITE_URL || "https://prtracker.com.br").replace(/\/$/, "");
const ogImage = `${SITE}/images/brand/logo-lime.png`;
const pageTitle = `${profile.display_name} · ${tName} · PR Tracker`;
const pageDesc =
  sortedLifts.length > 0
    ? `${sortedLifts.length} movimentos registrados · ${tName} · veja a estante de troféus.`
    : `Atleta no PR Tracker — registre seu PR, vire troféu.`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={`${SITE}/pr/atleta/${handle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto flex items-center justify-between">
      <a href="/pr" class="font-display text-base tracking-tight text-brand-lime">PR TRACKER</a>
      {visitor ? (
        <a href="/pr" class="text-xs rounded-lg border border-navy-600 text-white font-semibold px-3 py-1.5 hover:bg-navy-800">
          Voltar pro meu app
        </a>
      ) : (
        <a href="/pr/login" class="text-xs rounded-lg bg-brand-lime text-navy-900 font-semibold px-3 py-1.5">
          Crie o seu
        </a>
      )}
    </header>

    <main class="max-w-2xl mx-auto px-4">
      {inviteMode && !isSelf && (
        <section
          id="squad-invite-banner"
          class="mb-4 rounded-2xl border-2 border-brand-lime/50 bg-gradient-to-r from-brand-lime/15 to-brand-lime/5 p-4 shadow-lg shadow-brand-lime/15"
          data-target-user-id={profile.user_id}
          data-visitor-state={visitor ? (alreadyFollowing ? "following" : "logged-in") : "logged-out"}
          data-auto-accept={autoAccept ? "1" : "0"}
        >
          <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">CONVITE PRA SQUAD</div>
          <div class="font-display text-lg text-white leading-tight mb-2">
            {profile.display_name} te chamou pra treinar junto.
          </div>
          {visitor ? (
            alreadyFollowing ? (
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <p class="text-sm text-navy-200">Você já segue esse atleta.</p>
                <a href="/pr/feed" class="text-xs bg-brand-lime text-navy-900 font-display font-bold rounded-lg px-3 py-2 hover:opacity-90">
                  Ver feed →
                </a>
              </div>
            ) : (
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <p class="text-sm text-navy-200">Aceita o squad pra ver os PRs no teu feed em tempo real.</p>
                <button
                  type="button"
                  id="squad-accept-btn"
                  class="text-sm bg-brand-lime text-navy-900 font-display font-bold rounded-lg px-4 py-2 hover:opacity-90 hover:scale-[1.03] active:scale-100 transition shadow-md shadow-brand-lime/30 disabled:opacity-60"
                >
                  ✓ Aceitar squad
                </button>
              </div>
            )
          ) : (
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <p class="text-sm text-navy-200">Entra no PR Tracker e segue automaticamente.</p>
              <a
                href={`/pr/login?next=${encodeURIComponent(`/pr/atleta/${handle}?invite=1&auto=1`)}`}
                class="text-sm bg-brand-lime text-navy-900 font-display font-bold rounded-lg px-4 py-2 hover:opacity-90 transition shadow-md shadow-brand-lime/30"
              >
                Entrar e seguir →
              </a>
            </div>
          )}
        </section>
      )}
      {/* === HERO LIFTER CARD === */}
      <section
        class="rounded-2xl p-6 mb-6 border-2 relative overflow-hidden"
        style={`border-color: ${tColor}; background: linear-gradient(135deg, rgba(1,0,42,0.95), rgba(10,0,80,0.95))`}
      >
        <div class="text-[10px] uppercase tracking-[0.3em] text-navy-300">Atleta</div>
        <h1 class="font-display text-3xl tracking-tight mt-1">{profile.display_name}</h1>
        {profile.instagram_handle && (
          <a
            href={`https://instagram.com/${profile.instagram_handle}`}
            target="_blank"
            rel="noopener"
            class="text-sm text-navy-300 hover:text-white"
          >@{profile.instagram_handle}</a>
        )}
        <div class="text-center mt-6">
          <div class="text-[10px] uppercase tracking-[0.3em] text-navy-300">Strength Tier</div>
          <div class="font-display text-5xl mt-1" style={`color: ${tColor}`}>{tName}</div>
          {summary.hasBodyData && (
            <div class="text-sm text-white mt-1">
              Top {Math.max(1, Math.round(100 - summary.percentile))}% Brasil
            </div>
          )}
        </div>

        {summary.powerlifting && (
          <div class="rounded-lg bg-navy-900/50 p-3 mt-5 text-center">
            <div class="text-[10px] uppercase tracking-widest text-navy-300">Powerlifting Total</div>
            <div class="font-display text-3xl tabular-nums mt-1">{Math.round(summary.powerlifting.totalKg)}<span class="text-sm text-navy-300 ml-0.5">kg</span></div>
            <div class="text-xs text-navy-300 mt-1">
              {summary.powerlifting.ratio.toFixed(2).replace(".", ",")}× peso · {tierLabel(summary.powerlifting.tier)}
            </div>
          </div>
        )}
      </section>

      {/* === TROPHY WALL (isometric scene, shared component) === */}
      {sortedLifts.length > 0 && (
        <section class="mb-6">
          <TrophyWall
            athleteName={profile.display_name}
            overallTier={overallTier}
            lifts={sortedLifts.map((l) => ({ exerciseId: l.exerciseId, weightKg: l.weightKg, tier: l.tier }))}
          />
        </section>
      )}

      {/* === TROPHY GRID with buy CTAs === */}
      {sortedLifts.length > 0 ? (
        <section class="mb-6">
          <div class="flex items-baseline justify-between mb-3">
            <h2 class="text-base font-semibold tracking-tight">Cada PR pode virar troféu</h2>
            <div class="text-[10px] uppercase tracking-widest text-navy-300">{sortedLifts.length}</div>
          </div>
          <ul class="grid grid-cols-2 gap-2">
            {sortedLifts.map((lift) => {
              const c = tierColor(lift.tier);
              const productSlug = productSlugForExercise(lift.exerciseId);
              const trophyHref = `/produto/${productSlug}?${configuratorQuery(lift.weightKg, lift.exerciseId, "pr-public")}`;
              return (
                <li class="rounded-xl border bg-navy-800/30 p-3 flex flex-col" style={`border-color: ${c}33`}>
                  <div class="text-[10px] uppercase tracking-widest" style={`color: ${c}`}>
                    {tierLabel(lift.tier)}
                  </div>
                  <div class="font-display text-sm leading-tight truncate">{exerciseLabel(lift.exerciseId)}</div>
                  <div class="font-display text-2xl tabular-nums mt-1" style={`color: ${c}`}>
                    {lift.weightKg}
                    <span class="text-xs text-navy-300 font-body ml-0.5">kg</span>
                  </div>
                  <a
                    href={trophyHref}
                    class="mt-2 text-[10px] uppercase tracking-widest text-center rounded-md py-1.5 border transition hover:opacity-90"
                    style={`color: ${c}; border-color: ${c}55; background: ${c}10`}
                  >
                    Quero esse troféu →
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ) : (
        <section class="rounded-2xl border border-navy-700 bg-navy-800/30 p-8 text-center mb-6">
          <p class="text-sm text-navy-300">Esse atleta ainda não registrou nenhum PR.</p>
        </section>
      )}

      {/* === CTA SIGN-UP === */}
      <section class="rounded-2xl border border-brand-lime/30 bg-brand-lime/5 p-6 text-center mb-6">
        <h2 class="font-display text-xl tracking-tight mb-2">Você também é atleta?</h2>
        <p class="text-sm text-navy-300 mb-4">
          Registra seus PRs · vira tier · estante de troféus · pode pedir o troféu físico
        </p>
        <a
          href="/pr/login"
          class="inline-block rounded-lg bg-brand-lime px-5 py-3 text-sm font-semibold text-navy-900 hover:opacity-90 transition"
        >
          Entrar no PR Tracker
        </a>
      </section>

      <footer class="text-center text-[10px] uppercase tracking-widest text-navy-300 pt-6 pb-12">
        prtracker.com.br · @pr.tracker
      </footer>
    </main>

    <script>
      // Squad invite handler — POST /api/pr/follows quando o visitante
      // aceita o convite. Roda também automaticamente quando a página
      // carrega com `?auto=1` (após login redirect).
      const banner = document.getElementById("squad-invite-banner");
      if (banner) {
        const targetUserId = banner.dataset.targetUserId;
        const state = banner.dataset.visitorState;
        const autoAccept = banner.dataset.autoAccept === "1";
        const btn = document.getElementById("squad-accept-btn") as HTMLButtonElement | null;

        async function acceptSquad(): Promise<void> {
          if (!targetUserId || !btn) return;
          btn.disabled = true;
          const originalText = btn.textContent;
          btn.textContent = "Seguindo...";
          try {
            const res = await fetch("/api/pr/follows", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ user_id: targetUserId }),
            });
            if (!res.ok) throw new Error("follow failed");
            btn.textContent = "✓ Squad ativo";
            // Redirect pro feed após 800ms pra ver os PRs do atleta
            setTimeout(() => {
              window.location.href = "/pr/feed";
            }, 800);
          } catch {
            btn.disabled = false;
            btn.textContent = originalText ?? "Aceitar squad";
          }
        }

        btn?.addEventListener("click", acceptSquad);

        // Auto-accept depois do login (caminho do convite logged-out)
        if (autoAccept && state === "logged-in") {
          // Pequeno delay pra UI montar e usuário ver o banner
          setTimeout(() => { acceptSquad(); }, 400);
        }
      }
    </script>
  </body>
</html>

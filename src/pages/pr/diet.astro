        { match: /grao de bico|grão de bico|lentilha|ervilha/i, portions: [{ label: "1 concha (80g)", g: 80 }] },
        { match: /tomate|cenoura|beterraba|pepino|pimentao|cebola/i, portions: [{ label: "1 unidade (100g)", g: 100 }, { label: "1 fatia (15g)", g: 15 }] },
        { match: /alface|rucula|agriao|espinafre/i, portions: [{ label: "1 prato (50g)", g: 50 }] },
        { match: /brocolis|couve flor|couve manteiga/i, portions: [{ label: "1 porção (80g)", g: 80 }] },
        { match: /uva/i, portions: [{ label: "10 bagos (50g)", g: 50 }, { label: "1 cacho (200g)", g: 200 }] },
        { match: /melancia/i, portions: [{ label: "1 fatia (200g)", g: 200 }] },
        { match: /melao|melão/i, portions: [{ label: "1 fatia (150g)", g: 150 }] },
        { match: /morango|framboesa|amora|mirtilo|acerola/i, portions: [{ label: "1 punhado (50g)", g: 50 }] },
        { match: /pera/i, portions: [{ label: "1 unidade (170g)", g: 170 }] },
        { match: /abacaxi/i, portions: [{ label: "1 fatia (100g)", g: 100 }] },
        { match: /coco fresco/i, portions: [{ label: "1 pedaço (40g)", g: 40 }] },
        { match: /agua de coco/i, portions: [{ label: "1 copo (200ml)", g: 200 }, { label: "1 caixa (1L)", g: 1000 }] },
      ];

      function showQuickPortions(foodName: string) {
        const portionsBox = document.getElementById("quick-portions") as HTMLDivElement;
        const list = document.getElementById("quick-portions-list") as HTMLDivElement;
        list.innerHTML = "";
        const match = PORTION_TABLE.find((p) => p.match.test(foodName));
        if (!match) {
          portionsBox.classList.add("hidden");
          return;
        }
        portionsBox.classList.remove("hidden");
        match.portions.forEach((p) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "px-2.5 py-1 rounded-full text-xs bg-navy-800 hover:bg-brand-lime hover:text-navy-900 text-white border border-navy-700";
          btn.textContent = p.label;
          btn.addEventListener("click", () => {
            qtyInput.value = String(p.g);
            qtyInput.focus();
          });
          list.appendChild(btn);
        });
      }

      searchInput?.addEventListener("input", () => {
        if (searchTimer) clearTimeout(searchTimer);
        const q = searchInput.value.trim();
        if (q.length < 2) {
          resultsBox.innerHTML = "";
          return;
        }
        searchTimer = window.setTimeout(async () => {
          const res = await fetch(`/api/pr/diet/food-search?q=${encodeURIComponent(q)}`);
          const data = await res.json();
          resultsBox.innerHTML = "";
          (data.foods as FoodHit[]).forEach((f) => {
            const item = document.createElement("button");
            item.className =
              "block w-full text-left px-3 py-2 rounded hover:bg-navy-800 text-white text-sm";
            item.innerHTML = `<div>${f.name}</div><div class="text-xs text-navy-400">${Math.round(f.kcal)} kcal/100g</div>`;
            item.addEventListener("click", () => {
              selectedFoodId = f.id;
              selectedNameEl.textContent = f.name;
              qtySection.classList.remove("hidden");
              showQuickPortions(f.name);
              qtyInput.focus();
              qtyInput.select();
            });
            resultsBox.appendChild(item);
          });
        }, 200);
      });

      // Water +/- handlers
      document.querySelectorAll(".water-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const qty = Number((e.currentTarget as HTMLButtonElement).dataset.water ?? "200");
          (e.currentTarget as HTMLButtonElement).disabled = true;
          try {
            const res = await fetch("/api/pr/diet/water", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ qty_ml: qty }),
            });
            if (res.ok) {
              const totalEl = document.getElementById("water-total");
              const barEl = document.getElementById("water-bar");
              const cur = Number(totalEl?.textContent ?? "0");
              const next = cur + qty;
              if (totalEl) totalEl.textContent = String(next);
              if (barEl) (barEl as HTMLElement).style.width = Math.min(100, (next / 2500) * 100) + "%";
            }
          } catch {}
          (e.currentTarget as HTMLButtonElement).disabled = false;
        });
      });

      // Delete handler
      document.querySelectorAll(".delete-meal-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const mealId = (e.currentTarget as HTMLButtonElement).dataset.mealId;
          if (!mealId || !confirm("Remover esta refeição?")) return;
          try {
            const res = await fetch(`/api/pr/diet/meal-log?id=${mealId}`, { method: "DELETE" });
            if (res.ok) {
              window.location.reload();
            } else {
              alert("Erro ao remover.");
            }
          } catch {
            alert("Erro de conexão.");
          }
        });
      });

      saveBtn?.addEventListener("click", async () => {
        if (!selectedFoodId || !currentMealType) return;
        saveBtn.disabled = true;
        saveBtn.textContent = "Salvando...";
        const qty = Number(qtyInput.value);
        const res = await fetch("/api/pr/diet/meal-log", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            meal_type: currentMealType,
            food_id: selectedFoodId,
            qty_g: qty,
          }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          saveBtn.disabled = false;
          saveBtn.textContent = "Salvar";
          alert("Erro ao salvar.");
        }
      });
    </script>
  </body>
</html>

        <div class="flex items-center justify-between mb-3">
          <h3 class="font-display text-lg">Adicionar alimento</h3>
          <button id="close-modal" class="text-navy-300 hover:text-white">✕</button>
        </div>
        <input
          id="food-search"
          type="text"
          placeholder="Buscar alimento (ex: arroz, frango)..."
          class="w-full bg-navy-800 border border-navy-700 rounded-lg px-3 py-2 text-sm focus:border-brand-lime focus:outline-none mb-2"
        />
        <div id="search-results" class="max-h-64 overflow-y-auto space-y-1 text-sm"></div>
        <div id="qty-section" class="hidden mt-3 pt-3 border-t border-navy-800">
          <div id="selected-food-name" class="text-sm text-brand-lime mb-2"></div>

          <!-- Quick portions: aparecem dinamicamente baseado no nome do alimento -->
          <div id="quick-portions" class="hidden mb-2">
            <div class="text-[10px] uppercase tracking-wider text-navy-300 mb-1">Porção rápida</div>
            <div id="quick-portions-list" class="flex flex-wrap gap-1.5"></div>
          </div>

          <label class="block text-xs uppercase tracking-wider text-navy-300 mb-1">Quantidade (g)</label>
          <input
            id="food-qty"
            type="number"
            value="100"
            min="1"
            max="5000"
            class="w-full bg-navy-800 border border-navy-700 rounded-lg px-3 py-2 text-sm focus:border-brand-lime focus:outline-none mb-2"
          />
          <button id="save-food" class="w-full bg-brand-lime text-navy-900 font-bold rounded-lg py-2.5 text-sm hover:opacity-90">
            Salvar
          </button>
        </div>
      </div>
    </div>

    <script>
      type FoodHit = { id: string; name: string; brand: string | null; kcal: number };
      const modal = document.getElementById("add-food-modal") as HTMLDivElement;
      const closeBtn = document.getElementById("close-modal") as HTMLButtonElement;
      const searchInput = document.getElementById("food-search") as HTMLInputElement;
      const resultsBox = document.getElementById("search-results") as HTMLDivElement;
      const qtySection = document.getElementById("qty-section") as HTMLDivElement;

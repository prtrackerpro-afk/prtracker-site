                      type="button"
                      data-meal-id={m.id}
                      class="delete-meal-btn text-navy-500 hover:text-red-400 text-sm leading-none px-1"
                      title="Remover"
                    >×</button>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))}
    </main>

    <BottomNav active="profile" />

    <!-- Modal: adicionar alimento -->
    <div id="add-food-modal" class="hidden fixed inset-0 bg-black/80 z-50 items-end sm:items-center justify-center p-4">

---
export const prerender = false;
import "../../styles/global.css";
import BottomNav from "../../components/pr/BottomNav.astro";
import { getServerSupabase } from "../../lib/supabase/server";

const athlete = Astro.locals.athlete;
if (!athlete) return Astro.redirect("/pr/login");

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

// Hoje (00:00 - 23:59)
const today = new Date();
today.setHours(0, 0, 0, 0);
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);

const { data: mealsRaw } = await supabase
  .from("pr_meal_log")
  .select(
    "id, meal_type, consumed_at, qty_g, custom_name, custom_kcal, custom_protein_g, custom_carbs_g, custom_fat_g, pr_food_db(name, kcal, protein_g, carbs_g, fat_g)"
  )
  .eq("user_id", athlete.userId)
  .gte("consumed_at", today.toISOString())
  .lt("consumed_at", tomorrow.toISOString())
  .order("consumed_at", { ascending: true });

const { data: targetRow } = await supabase
  .from("pr_diet_targets")
  .select("kcal_target, protein_g_target, carbs_g_target, fat_g_target, water_ml_target")
  .eq("user_id", athlete.userId)
  .maybeSingle();

// Hidratação do dia
const { data: waterRows = [] } = await supabase
  .from("pr_water_log")
  .select("qty_ml")
  .eq("user_id", athlete.userId)
  .gte("consumed_at", today.toISOString())
  .lt("consumed_at", tomorrow.toISOString());
const waterTotal = (waterRows ?? []).reduce((acc, r) => acc + (r.qty_ml as number), 0);
const waterTarget = (targetRow as { water_ml_target?: number } | null)?.water_ml_target ?? 2500;

// Streak de dias com pelo menos 4 refeições logadas
const { data: streakDates = [] } = await supabase
  .from("pr_meal_log")
  .select("consumed_at")
  .eq("user_id", athlete.userId)
  .gte("consumed_at", new Date(today.getTime() - 30 * 86400000).toISOString())
  .order("consumed_at", { ascending: false });

function computeDietStreak(dates: string[]): number {
  if (dates.length === 0) return 0;
  // Conta refeições por dia
  const byDay = new Map<string, number>();
  for (const d of dates) {
    const day = d.slice(0, 10);
    byDay.set(day, (byDay.get(day) ?? 0) + 1);
  }
  // Streak: dias consecutivos com >= 4 refeições terminando hoje (ou ontem)
  const todayKey = today.toISOString().slice(0, 10);
  const yesterdayKey = new Date(today.getTime() - 86400000).toISOString().slice(0, 10);
  let cursor: Date;
  if ((byDay.get(todayKey) ?? 0) >= 4) cursor = new Date(today);
  else if ((byDay.get(yesterdayKey) ?? 0) >= 4) cursor = new Date(today.getTime() - 86400000);
  else return 0;
  let count = 0;
  while ((byDay.get(cursor.toISOString().slice(0, 10)) ?? 0) >= 4) {
    count++;
    cursor.setDate(cursor.getDate() - 1);
  }
  return count;
}
const dietStreak = computeDietStreak(((streakDates ?? []) as Array<{ consumed_at: string }>).map(d => d.consumed_at));

const target = targetRow ?? {
  kcal_target: 2200,
  protein_g_target: 150,
  carbs_g_target: 250,
  fat_g_target: 70,
};

type MealRaw = {
  id: string;
  meal_type: string;
  consumed_at: string;
  qty_g: number;
  custom_name: string | null;
  custom_kcal: number | null;
  custom_protein_g: number | null;
  custom_carbs_g: number | null;
  custom_fat_g: number | null;
  pr_food_db: { name: string; kcal: number; protein_g: number; carbs_g: number; fat_g: number } | null;
};

const meals = (mealsRaw ?? []) as MealRaw[];

// Calcula macros totais do dia
function macros(m: MealRaw) {
  const factor = m.qty_g / 100;
  if (m.pr_food_db) {
    return {
      kcal: m.pr_food_db.kcal * factor,
      p: m.pr_food_db.protein_g * factor,
      c: m.pr_food_db.carbs_g * factor,
      f: m.pr_food_db.fat_g * factor,
      name: m.pr_food_db.name,
    };
  }
  return {
    kcal: (m.custom_kcal ?? 0) * factor,
    p: (m.custom_protein_g ?? 0) * factor,
    c: (m.custom_carbs_g ?? 0) * factor,
    f: (m.custom_fat_g ?? 0) * factor,
    name: m.custom_name ?? "Custom",
  };
}

const totals = meals.reduce(
  (acc, m) => {
    const mc = macros(m);
    acc.kcal += mc.kcal;
    acc.p += mc.p;
    acc.c += mc.c;
    acc.f += mc.f;
    return acc;
  },
  { kcal: 0, p: 0, c: 0, f: 0 }
);

const mealLabels: Record<string, string> = {
  breakfast: "Café da manhã",
  morning_snack: "Lanche da manhã",
  lunch: "Almoço",
  afternoon_snack: "Lanche da tarde",
  dinner: "Jantar",
  evening_snack: "Ceia",
  pre_workout: "Pré-treino",
  post_workout: "Pós-treino",
};
const ORDER = [
  "breakfast",
  "morning_snack",
  "lunch",
  "afternoon_snack",
  "dinner",
  "evening_snack",
  "pre_workout",
  "post_workout",
];
const mealsByType: Record<string, MealRaw[]> = {};
for (const m of meals) {
  (mealsByType[m.meal_type] ??= []).push(m);
}

const pctKcal = Math.min(100, Math.round((totals.kcal / target.kcal_target) * 100));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Dieta · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-md mx-auto">
      <a href="/pr" class="text-sm text-navy-300 hover:text-white">← Voltar</a>
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mt-3">DIETA</div>
      <h1 class="font-display text-3xl tracking-tight text-white">Macros do dia</h1>
      <div class="flex items-center justify-between">
        <p class="text-sm text-navy-300">{new Date().toLocaleDateString("pt-BR", { weekday: "long", day: "numeric", month: "long" })}</p>
        {dietStreak > 0 && (
          <div class="text-xs bg-orange-500/20 text-orange-300 rounded-full px-2.5 py-0.5 font-bold">🔥 {dietStreak} dias</div>
        )}
      </div>
    </header>

    <main class="max-w-md mx-auto px-4 space-y-4">
      <!-- Resumo de macros -->
      <section class="rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-4 shadow-lg shadow-brand-lime/5">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-2">RESUMO HOJE</div>
        <div class="flex items-baseline gap-2 mb-3">
          <div class="text-3xl font-display font-bold text-white tabular-nums">{Math.round(totals.kcal)}</div>
          <div class="text-sm text-navy-300">/ {target.kcal_target} kcal</div>
          <div class="text-xs text-navy-400 ml-auto">{pctKcal}%</div>
        </div>
        <div class="h-2 bg-navy-800 rounded-full overflow-hidden">
          <div class={`h-full transition-all ${pctKcal > 110 ? "bg-red-500" : pctKcal > 95 ? "bg-orange-400" : "bg-brand-lime"}`} style={`width: ${Math.min(100, pctKcal)}%`}></div>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4 text-center">
          <div>
            <div class="text-xl font-display font-bold text-white tabular-nums">{Math.round(totals.p)}</div>
            <div class="text-[10px] uppercase tracking-wider text-navy-300">Prot ({target.protein_g_target}g)</div>
            <div class="h-1 bg-navy-800 rounded-full mt-1 overflow-hidden">
              <div class="h-full bg-red-400" style={`width: ${Math.min(100, Math.round(totals.p / target.protein_g_target * 100))}%`}></div>
            </div>
          </div>
          <div>
            <div class="text-xl font-display font-bold text-white tabular-nums">{Math.round(totals.c)}</div>
            <div class="text-[10px] uppercase tracking-wider text-navy-300">Carb ({target.carbs_g_target}g)</div>
            <div class="h-1 bg-navy-800 rounded-full mt-1 overflow-hidden">
              <div class="h-full bg-yellow-400" style={`width: ${Math.min(100, Math.round(totals.c / target.carbs_g_target * 100))}%`}></div>
            </div>
          </div>
          <div>
            <div class="text-xl font-display font-bold text-white tabular-nums">{Math.round(totals.f)}</div>
            <div class="text-[10px] uppercase tracking-wider text-navy-300">Gord ({target.fat_g_target}g)</div>
            <div class="h-1 bg-navy-800 rounded-full mt-1 overflow-hidden">
              <div class="h-full bg-purple-400" style={`width: ${Math.min(100, Math.round(totals.f / target.fat_g_target * 100))}%`}></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Hidratação -->
      <section class="rounded-2xl border border-blue-500/40 bg-blue-500/5 p-3">
        <div class="flex items-center justify-between mb-2">
          <div>
            <div class="text-[10px] uppercase tracking-[0.3em] text-blue-400">💧 HIDRATAÇÃO</div>
            <div class="text-sm text-white"><span class="font-bold tabular-nums" id="water-total">{waterTotal}</span> / {waterTarget} ml</div>
          </div>
          <div class="flex gap-1">
            <button data-water="200" class="water-btn bg-blue-500/30 hover:bg-blue-500/60 text-white text-xs rounded-full px-2.5 py-1.5">+200ml</button>
            <button data-water="500" class="water-btn bg-blue-500/30 hover:bg-blue-500/60 text-white text-xs rounded-full px-2.5 py-1.5">+500ml</button>
          </div>
        </div>
        <div class="h-1.5 bg-navy-800 rounded-full overflow-hidden">
          <div id="water-bar" class="h-full bg-blue-400 transition-all" style={`width: ${Math.min(100, Math.round(waterTotal / waterTarget * 100))}%`}></div>
        </div>
      </section>

      <!-- Refeições -->
      {ORDER.map((mt) => (
        <section class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-display font-semibold">{mealLabels[mt]}</div>
            <button
              type="button"
              data-meal-type={mt}
              class="add-food-btn text-[10px] uppercase tracking-wider text-brand-lime hover:underline"
            >
              + Adicionar
            </button>
          </div>
          {(mealsByType[mt] ?? []).length === 0 ? (
            <div class="text-xs text-navy-400 italic">Nada registrado</div>
          ) : (
            <ul class="space-y-1 text-sm">
              {(mealsByType[mt] ?? []).map((m) => {
                const mc = macros(m);
                return (
                  <li class="flex items-center justify-between gap-2">
                    <span class="text-white flex-1 min-w-0">{mc.name} <span class="text-navy-400">{m.qty_g}g</span></span>
                    <span class="text-navy-300 tabular-nums text-xs">{Math.round(mc.kcal)}kcal</span>

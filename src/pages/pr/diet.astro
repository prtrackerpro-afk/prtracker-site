---
export const prerender = false;
import "../../styles/global.css";
import BottomNav from "../../components/pr/BottomNav.astro";
import { getServerSupabase } from "../../lib/supabase/server";

const athlete = Astro.locals.athlete;
if (!athlete) return Astro.redirect("/pr/login");

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

// Hoje (00:00 - 23:59)
const today = new Date();
today.setHours(0, 0, 0, 0);
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);

const { data: mealsRaw } = await supabase
  .from("pr_meal_log")
  .select(
    "id, meal_type, consumed_at, qty_g, custom_name, custom_kcal, custom_protein_g, custom_carbs_g, custom_fat_g, pr_food_db(name, kcal, protein_g, carbs_g, fat_g)"
  )
  .eq("user_id", athlete.userId)
  .gte("consumed_at", today.toISOString())
  .lt("consumed_at", tomorrow.toISOString())
  .order("consumed_at", { ascending: true });

const { data: targetRow } = await supabase
  .from("pr_diet_targets")
  .select("kcal_target, protein_g_target, carbs_g_target, fat_g_target")
  .eq("user_id", athlete.userId)
  .maybeSingle();

const target = targetRow ?? {
  kcal_target: 2200,
  protein_g_target: 150,
  carbs_g_target: 250,
  fat_g_target: 70,
};

type MealRaw = {
  id: string;
  meal_type: string;
  consumed_at: string;
  qty_g: number;
  custom_name: string | null;
  custom_kcal: number | null;
  custom_protein_g: number | null;
  custom_carbs_g: number | null;
  custom_fat_g: number | null;
  pr_food_db: { name: string; kcal: number; protein_g: number; carbs_g: number; fat_g: number } | null;
};

const meals = (mealsRaw ?? []) as MealRaw[];

// Calcula macros totais do dia
function macros(m: MealRaw) {
  const factor = m.qty_g / 100;
  if (m.pr_food_db) {
    return {
      kcal: m.pr_food_db.kcal * factor,
      p: m.pr_food_db.protein_g * factor,
      c: m.pr_food_db.carbs_g * factor,
      f: m.pr_food_db.fat_g * factor,
      name: m.pr_food_db.name,
    };
  }
  return {
    kcal: (m.custom_kcal ?? 0) * factor,
    p: (m.custom_protein_g ?? 0) * factor,
    c: (m.custom_carbs_g ?? 0) * factor,
    f: (m.custom_fat_g ?? 0) * factor,
    name: m.custom_name ?? "Custom",
  };
}

const totals = meals.reduce(
  (acc, m) => {
    const mc = macros(m);
    acc.kcal += mc.kcal;
    acc.p += mc.p;
    acc.c += mc.c;
    acc.f += mc.f;
    return acc;
  },
  { kcal: 0, p: 0, c: 0, f: 0 }
);

const mealLabels: Record<string, string> = {
  breakfast: "Café da manhã",
  morning_snack: "Lanche da manhã",
  lunch: "Almoço",
  afternoon_snack: "Lanche da tarde",
  dinner: "Jantar",
  evening_snack: "Ceia",
  pre_workout: "Pré-treino",
  post_workout: "Pós-treino",
};
const ORDER = [
  "breakfast",
  "morning_snack",
  "lunch",
  "afternoon_snack",
  "dinner",
  "evening_snack",
  "pre_workout",
  "post_workout",
];
const mealsByType: Record<string, MealRaw[]> = {};
for (const m of meals) {
  (mealsByType[m.meal_type] ??= []).push(m);
}

const pctKcal = Math.min(100, Math.round((totals.kcal / target.kcal_target) * 100));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Dieta · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-md mx-auto">
      <a href="/pr" class="text-sm text-navy-300 hover:text-white">← Voltar</a>
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mt-3">DIETA</div>
      <h1 class="font-display text-3xl tracking-tight text-white">Macros do dia</h1>
      <p class="text-sm text-navy-300">{new Date().toLocaleDateString("pt-BR", { weekday: "long", day: "numeric", month: "long" })}</p>
    </header>

    <main class="max-w-md mx-auto px-4 space-y-4">
      <!-- Resumo de macros -->
      <section class="rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-4 shadow-lg shadow-brand-lime/5">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-2">RESUMO HOJE</div>
        <div class="flex items-baseline gap-2 mb-3">
          <div class="text-3xl font-display font-bold text-white tabular-nums">{Math.round(totals.kcal)}</div>
          <div class="text-sm text-navy-300">/ {target.kcal_target} kcal</div>
        </div>
        <div class="h-2 bg-navy-800 rounded-full overflow-hidden">
          <div class="h-full bg-brand-lime transition-all" style={`width: ${pctKcal}%`}></div>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4 text-center">
          <div>
            <div class="text-xl font-display font-bold text-white tabular-nums">{Math.round(totals.p)}</div>
            <div class="text-[10px] uppercase tracking-wider text-navy-300">Prot ({target.protein_g_target}g)</div>
          </div>
          <div>
            <div class="text-xl font-display font-bold text-white tabular-nums">{Math.round(totals.c)}</div>
            <div class="text-[10px] uppercase tracking-wider text-navy-300">Carb ({target.carbs_g_target}g)</div>
          </div>
          <div>
            <div class="text-xl font-display font-bold text-white tabular-nums">{Math.round(totals.f)}</div>
            <div class="text-[10px] uppercase tracking-wider text-navy-300">Gord ({target.fat_g_target}g)</div>
          </div>
        </div>
      </section>

      <!-- Refeições -->
      {ORDER.map((mt) => (
        <section class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-display font-semibold">{mealLabels[mt]}</div>
            <button
              type="button"
              data-meal-type={mt}
              class="add-food-btn text-[10px] uppercase tracking-wider text-brand-lime hover:underline"
            >
              + Adicionar
            </button>
          </div>
          {(mealsByType[mt] ?? []).length === 0 ? (
            <div class="text-xs text-navy-400 italic">Nada registrado</div>
          ) : (
            <ul class="space-y-1 text-sm">
              {(mealsByType[mt] ?? []).map((m) => {
                const mc = macros(m);
                return (
                  <li class="flex justify-between gap-2">
                    <span class="text-white">{mc.name} <span class="text-navy-400">{m.qty_g}g</span></span>
                    <span class="text-navy-300 tabular-nums text-xs">{Math.round(mc.kcal)}kcal</span>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))}
    </main>

    <BottomNav active="profile" />

    <!-- Modal: adicionar alimento -->
    <div id="add-food-modal" class="hidden fixed inset-0 bg-black/80 z-50 items-end sm:items-center justify-center p-4">
      <div class="bg-navy-900 border-2 border-brand-lime/40 rounded-2xl p-4 w-full max-w-md">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-display text-lg">Adicionar alimento</h3>
          <button id="close-modal" class="text-navy-300 hover:text-white">✕</button>
        </div>
        <input
          id="food-search"
          type="text"
          placeholder="Buscar alimento (ex: arroz, frango)..."
          class="w-full bg-navy-800 border border-navy-700 rounded-lg px-3 py-2 text-sm focus:border-brand-lime focus:outline-none mb-2"
        />
        <div id="search-results" class="max-h-64 overflow-y-auto space-y-1 text-sm"></div>
        <div id="qty-section" class="hidden mt-3 pt-3 border-t border-navy-800">
          <div id="selected-food-name" class="text-sm text-brand-lime mb-2"></div>
          <label class="block text-xs uppercase tracking-wider text-navy-300 mb-1">Quantidade (g)</label>
          <input
            id="food-qty"
            type="number"
            value="100"
            min="1"
            max="5000"
            class="w-full bg-navy-800 border border-navy-700 rounded-lg px-3 py-2 text-sm focus:border-brand-lime focus:outline-none mb-2"
          />
          <button id="save-food" class="w-full bg-brand-lime text-navy-900 font-bold rounded-lg py-2.5 text-sm hover:opacity-90">
            Salvar
          </button>
        </div>
      </div>
    </div>

    <script>
      type FoodHit = { id: string; name: string; brand: string | null; kcal: number };
      const modal = document.getElementById("add-food-modal") as HTMLDivElement;
      const closeBtn = document.getElementById("close-modal") as HTMLButtonElement;
      const searchInput = document.getElementById("food-search") as HTMLInputElement;
      const resultsBox = document.getElementById("search-results") as HTMLDivElement;
      const qtySection = document.getElementById("qty-section") as HTMLDivElement;
      const selectedNameEl = document.getElementById("selected-food-name") as HTMLDivElement;
      const qtyInput = document.getElementById("food-qty") as HTMLInputElement;
      const saveBtn = document.getElementById("save-food") as HTMLButtonElement;

      let currentMealType: string | null = null;
      let selectedFoodId: string | null = null;
      let searchTimer: number | null = null;

      document.querySelectorAll(".add-food-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          currentMealType = (e.currentTarget as HTMLButtonElement).dataset.mealType ?? null;
          modal.classList.remove("hidden");
          modal.classList.add("flex");
          searchInput.value = "";
          resultsBox.innerHTML = "";
          qtySection.classList.add("hidden");
          selectedFoodId = null;
          searchInput.focus();
        });
      });

      closeBtn?.addEventListener("click", () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      });

      searchInput?.addEventListener("input", () => {
        if (searchTimer) clearTimeout(searchTimer);
        const q = searchInput.value.trim();
        if (q.length < 2) {
          resultsBox.innerHTML = "";
          return;
        }
        searchTimer = window.setTimeout(async () => {
          const res = await fetch(`/api/pr/diet/food-search?q=${encodeURIComponent(q)}`);
          const data = await res.json();
          resultsBox.innerHTML = "";
          (data.foods as FoodHit[]).forEach((f) => {
            const item = document.createElement("button");
            item.className =
              "block w-full text-left px-3 py-2 rounded hover:bg-navy-800 text-white text-sm";
            item.innerHTML = `<div>${f.name}</div><div class="text-xs text-navy-400">${Math.round(f.kcal)} kcal/100g</div>`;
            item.addEventListener("click", () => {
              selectedFoodId = f.id;
              selectedNameEl.textContent = f.name;
              qtySection.classList.remove("hidden");
              qtyInput.focus();
            });
            resultsBox.appendChild(item);
          });
        }, 200);
      });

      saveBtn?.addEventListener("click", async () => {
        if (!selectedFoodId || !currentMealType) return;
        saveBtn.disabled = true;
        saveBtn.textContent = "Salvando...";
        const qty = Number(qtyInput.value);
        const res = await fetch("/api/pr/diet/meal-log", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            meal_type: currentMealType,
            food_id: selectedFoodId,
            qty_g: qty,
          }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          saveBtn.disabled = false;
          saveBtn.textContent = "Salvar";
          alert("Erro ao salvar.");
        }
      });
    </script>
  </body>
</html>

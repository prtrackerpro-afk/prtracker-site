---
export const prerender = false;
import "../../styles/global.css";
import { EXERCISES } from "../../lib/pr/exercises";

// Athlete is loaded by middleware (Astro.locals.athlete) — we don't need
// it here since the form posts to /api/pr/records which re-reads it.
const today = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Registrar PR · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body">
    <header class="px-4 pt-6 pb-4 max-w-md mx-auto">
      <a href="/pr" class="text-sm text-navy-300 hover:text-white">← Voltar</a>
    </header>

    <main class="max-w-md mx-auto px-4">
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-2">NOVO RECORDE</div>
      <h1 class="font-display text-3xl tracking-tight mb-2 text-white">Registrar PR</h1>
      <p class="text-sm text-navy-300 mb-6">
        Logue só o que importa — não é diário de treino.
      </p>

      <form id="log-form" class="space-y-4">
        <div>
          <label for="exercise" class="block text-xs uppercase tracking-wider text-navy-300 mb-1.5">Movimento</label>
          <select
            id="exercise"
            name="exercise"
            required
            class="w-full rounded-lg border border-navy-600 bg-navy-900 px-3 py-2.5 text-sm focus:border-brand-lime focus:outline-none focus:ring-1 focus:ring-brand-lime"
          >
            {EXERCISES.map((ex) => (
              <option value={ex.id}>{ex.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="weight" class="block text-xs uppercase tracking-wider text-navy-300 mb-1.5">Peso (kg)</label>
          <div class="flex gap-2">
            <button type="button" data-delta="-5" class="weight-btn shrink-0 rounded-lg bg-navy-800 hover:bg-navy-700 text-white px-3 py-2.5 text-sm font-bold">-5</button>
            <button type="button" data-delta="-2.5" class="weight-btn shrink-0 rounded-lg bg-navy-800 hover:bg-navy-700 text-white px-3 py-2.5 text-sm font-bold">-2.5</button>
            <input
              id="weight"
              name="weight"
              type="number"
              step="0.5"
              min="1"
              max="999"
              required
              inputmode="decimal"
              class="flex-1 min-w-0 rounded-lg border border-navy-600 bg-navy-900 px-3 py-2.5 text-lg font-display tabular-nums focus:border-brand-lime focus:outline-none focus:ring-1 focus:ring-brand-lime text-center"
            />
            <button type="button" data-delta="2.5" class="weight-btn shrink-0 rounded-lg bg-navy-800 hover:bg-navy-700 text-white px-3 py-2.5 text-sm font-bold">+2.5</button>
            <button type="button" data-delta="5" class="weight-btn shrink-0 rounded-lg bg-navy-800 hover:bg-navy-700 text-white px-3 py-2.5 text-sm font-bold">+5</button>
          </div>
        </div>

        <div>
          <label for="date" class="block text-xs uppercase tracking-wider text-navy-300 mb-1.5">Data</label>
          <input
            id="date"
            name="date"
            type="date"
            value={today}
            max={today}
            required
            class="w-full rounded-lg border border-navy-600 bg-navy-900 px-3 py-2.5 text-sm focus:border-brand-lime focus:outline-none focus:ring-1 focus:ring-brand-lime"
          />
        </div>

        <div>
          <label for="notes" class="block text-xs uppercase tracking-wider text-navy-300 mb-1.5">Observação (opcional)</label>
          <input
            id="notes"
            name="notes"
            type="text"
            maxlength="200"
            placeholder="ex: cinto, deadlift sumo, primeiro vermelho"
            class="w-full rounded-lg border border-navy-600 bg-navy-900 px-3 py-2.5 text-sm focus:border-brand-lime focus:outline-none focus:ring-1 focus:ring-brand-lime"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full rounded-lg bg-brand-lime px-4 py-4 text-base font-display font-bold text-navy-900 hover:opacity-90 hover:scale-[1.02] active:scale-100 transition disabled:opacity-60 disabled:cursor-wait shadow-lg shadow-brand-lime/30 flex items-center justify-center gap-2"
        >
          <span id="submit-spinner" class="hidden w-4 h-4 rounded-full border-2 border-navy-900/30 border-t-navy-900 animate-spin"></span>
          <span id="submit-label">🏆 Salvar PR</span>
        </button>

        <div id="error-msg" class="text-sm text-red-400 hidden"></div>

        <div id="offline-hint" class="hidden mt-3 rounded-lg border border-orange-500/40 bg-orange-500/5 px-3 py-2 text-xs text-orange-200">
          📡 Sem internet — vamos salvar localmente e sincronizar quando voltar online.
        </div>
      </form>
    </main>

    <script>
      import { enqueuePR } from "../../lib/pr/offline-queue";

      const form = document.getElementById("log-form") as HTMLFormElement;
      const errorMsg = document.getElementById("error-msg") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
      const submitLabel = document.getElementById("submit-label") as HTMLSpanElement;
      const submitSpinner = document.getElementById("submit-spinner") as HTMLSpanElement;
      const weightInput = document.getElementById("weight") as HTMLInputElement;
      const offlineHint = document.getElementById("offline-hint") as HTMLDivElement | null;

      function setSubmitState(busy: boolean, labelText: string): void {
        submitBtn.disabled = busy;
        submitLabel.textContent = labelText;
        submitSpinner.classList.toggle("hidden", !busy);
      }

      function updateOfflineHint(): void {
        if (!offlineHint) return;
        offlineHint.classList.toggle("hidden", navigator.onLine);
      }
      updateOfflineHint();
      window.addEventListener("online", updateOfflineHint);
      window.addEventListener("offline", updateOfflineHint);

      // Quick +/- weight buttons
      document.querySelectorAll(".weight-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const delta = Number((btn as HTMLButtonElement).dataset.delta ?? "0");
          const current = Number(weightInput.value) || 0;
          const next = Math.max(1, current + delta);
          weightInput.value = String(next);
        });
      });

      function saveOffline(data: FormData): void {
        enqueuePR({
          exercise: String(data.get("exercise") ?? ""),
          weight_kg: Number(data.get("weight")),
          performed_at: String(data.get("date") ?? ""),
          notes: (data.get("notes") as string) || null,
        });
        // Volta pra home com flag pra mostrar toast "PR salvo offline"
        window.location.href = "/pr?offline_saved=1";
      }

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.classList.add("hidden");
        setSubmitState(true, "Salvando...");

        const data = new FormData(form);

        // Se está offline, vai direto pra fila
        if (!navigator.onLine) {
          saveOffline(data);
          return;
        }

        try {
          const res = await fetch("/api/pr/records", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              exercise: data.get("exercise"),
              weight_kg: Number(data.get("weight")),
              performed_at: data.get("date"),
              notes: data.get("notes") || null,
            }),
          });
          const body = await res.json().catch(() => ({}));
          if (!res.ok) {
            errorMsg.textContent = body.message || "Erro ao salvar.";
            errorMsg.classList.remove("hidden");
            setSubmitState(false, "🏆 Salvar PR");
            return;
          }
          // If it was a PR, go to celebration; otherwise back to dashboard.
          if (body.is_personal_record) {
            window.location.href = `/pr/celebrate/${body.id}`;
          } else {
            window.location.href = "/pr";
          }
        } catch {
          // Falha de rede (mesmo com navigator.onLine=true): salva offline
          saveOffline(data);
        }
      });
    </script>
  </body>
</html>

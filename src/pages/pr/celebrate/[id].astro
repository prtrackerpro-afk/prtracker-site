---
export const prerender = false;
import "../../../styles/global.css";
import { getServerSupabase } from "../../../lib/supabase/server";
import { getRecord } from "../../../lib/pr/db";
import { exerciseLabel, productSlugForExercise, type ExerciseId } from "../../../lib/pr/exercises";
import { configuratorQuery, splitPlates } from "../../../lib/pr/plates";
import { renderCardSvg } from "../../../lib/pr/card-svg";
import { tierForLift, tierLabel, tierColor, TIER_ORDER, TIER_META, type Tier } from "../../../lib/pr/strength-score";

const athlete = Astro.locals.athlete!;
const id = Astro.params.id!;

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

const record = await getRecord(supabase, id);
if (!record || record.user_id !== athlete.userId) {
  return Astro.redirect("/pr", 302);
}

// Previous best for this exercise (excluding this record itself) — drives
// both the kg delta AND the level-up detection on the strength tier.
const { data: prev } = await supabase
  .from("pr_records")
  .select("weight_kg")
  .eq("user_id", athlete.userId)
  .eq("exercise", record.exercise)
  .neq("id", record.id)
  .order("weight_kg", { ascending: false })
  .limit(1)
  .maybeSingle();

const previousBest = prev?.weight_kg ? Number(prev.weight_kg) : null;
const delta = previousBest != null ? Number(record.weight_kg) - previousBest : null;

const productSlug = productSlugForExercise(record.exercise as ExerciseId);
const trophyHref = `/produto/${productSlug}?${configuratorQuery(
  Number(record.weight_kg),
  record.exercise,
  "pr-celebrate",
  record.id
)}`;

const split = splitPlates(Number(record.weight_kg));

// Strength tier — only if athlete has body data.
let currentTier: Tier | null = null;
let previousTier: Tier | null = null;
let isLevelUp = false;
let strengthData: {
  tier: Tier;
  ratio: number;
  percentile: number;
  nextTier: Tier | null;
  nextTierKg: number | null;
} | null = null;

if (athlete.bodyWeightKg && athlete.sex) {
  const score = tierForLift(record.exercise as ExerciseId, Number(record.weight_kg), athlete.bodyWeightKg, athlete.sex);
  currentTier = score.tier;
  const tierToPercentile = { iniciante: 30, novato: 60, intermediario: 80, avancado: 95, elite: 99 } as const;
  strengthData = {
    tier: score.tier,
    ratio: score.ratio,
    percentile: tierToPercentile[score.tier],
    nextTier: score.nextTier,
    nextTierKg: score.kgToNextTier,
  };

  if (previousBest != null) {
    const prevScore = tierForLift(record.exercise as ExerciseId, previousBest, athlete.bodyWeightKg, athlete.sex);
    previousTier = prevScore.tier;
    isLevelUp = TIER_META[currentTier].rank > TIER_META[previousTier].rank;
  }
}

// Inline the same SVG that the share endpoint produces — single source of
// truth, and it loads instantly without an extra HTTP roundtrip.
const cardSvg = renderCardSvg({
  athleteName: athlete.displayName ?? "Atleta",
  exerciseId: record.exercise as ExerciseId,
  weightKg: Number(record.weight_kg),
  performedAt: record.performed_at,
  strength: strengthData,
});

const movement = exerciseLabel(record.exercise as ExerciseId);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Novo PR · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body">
    <div class="max-w-md mx-auto px-4 py-6">
      <div class="text-center mb-4">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">Novo recorde pessoal</div>
        <h1 class="font-display text-2xl tracking-tight">{movement}</h1>
      </div>

      {/* Inline card preview — same SVG that the share endpoint serves */}
      <div class="card-preview rounded-2xl overflow-hidden border border-navy-700 mb-4 shadow-2xl shadow-brand-lime/10" set:html={cardSvg} />

      {/* Big animated count-up under the card */}
      <div class="text-center mb-1">
        <span
          id="count-up"
          class="font-display text-6xl text-brand-lime tabular-nums leading-none"
          data-target={record.weight_kg}
        >0</span>
        <span class="text-xl text-navy-300 ml-1">kg</span>
      </div>

      {delta != null ? (
        <p class="text-center text-sm text-navy-300 mb-4">
          <span class="text-brand-lime">+{delta.toFixed(1)} kg</span> sobre seu PR anterior ({previousBest} kg)
        </p>
      ) : (
        <p class="text-center text-sm text-navy-300 mb-4">Seu primeiro registro nesse movimento</p>
      )}

      {/* Level-up banner — only when current tier > previous tier */}
      {isLevelUp && currentTier && (
        <div
          id="level-up-banner"
          class="rounded-xl border-2 px-4 py-3 mb-4 text-center transition-all"
          style={`border-color: ${tierColor(currentTier)}; background: ${tierColor(currentTier)}10`}
        >
          <div class="text-[10px] uppercase tracking-[0.3em] text-navy-300">Você evoluiu</div>
          <div
            class="font-display text-3xl mt-1"
            style={`color: ${tierColor(currentTier)}`}
          >
            {tierLabel(currentTier).toUpperCase()}
          </div>
          {previousTier && (
            <div class="text-xs text-navy-300 mt-1">
              Antes: <span class="text-white">{tierLabel(previousTier)}</span>
            </div>
          )}
        </div>
      )}

      {/* No-body-data prompt — convert later */}
      {!strengthData && (
        <div class="rounded-xl border border-amber-400/30 bg-amber-400/5 px-4 py-3 mb-4 text-sm">
          <div class="text-amber-300 font-semibold mb-1">Desbloqueie seu Strength Tier</div>
          <div class="text-xs text-navy-300 mb-2">Adicione peso corporal e sexo no perfil pra ver onde você ranqueia.</div>
          <a href="/pr/profile" class="text-xs text-brand-lime underline">Atualizar perfil →</a>
        </div>
      )}

      <div class="space-y-3 mb-6">
        <a
          href={trophyHref}
          class="block w-full rounded-lg bg-brand-lime px-4 py-3.5 text-base font-semibold text-navy-900 hover:opacity-90 transition text-center"
        >
          Transforme em troféu →
        </a>

        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            id="share-btn"
            class="rounded-lg border border-navy-600 px-3 py-2.5 text-sm font-semibold hover:bg-navy-800 transition"
          >
            Compartilhar
          </button>
          <button
            type="button"
            id="download-png-btn"
            class="rounded-lg border border-navy-600 px-3 py-2.5 text-sm font-semibold hover:bg-navy-800 transition"
          >
            Baixar PNG
          </button>
        </div>

        <a href="/pr" class="block text-center text-xs text-navy-300 hover:text-white pt-1">
          Voltar pros meus PRs
        </a>
      </div>

      {/* Helper preview: which plates would go on the bar */}
      {split.pairs.length > 0 && (
        <div class="rounded-xl border border-navy-700 bg-navy-800/30 p-4">
          <div class="text-[10px] uppercase tracking-widest text-navy-300 mb-2 text-center">Anilhas (cada lado)</div>
          <div class="flex justify-center flex-wrap gap-1.5">
            {split.pairs.map((p) => (
              <span class="text-xs rounded bg-navy-900 px-2 py-1 border border-navy-700">
                {p.count}× {p.kg} kg
              </span>
            ))}
          </div>
        </div>
      )}
    </div>

    {/* Confetti canvas — fired on first paint when isLevelUp */}
    <canvas
      id="confetti"
      class="pointer-events-none fixed inset-0 z-50"
      width="0"
      height="0"
    ></canvas>

    <style>
      .card-preview svg {
        width: 100%;
        height: auto;
        display: block;
      }
      @keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(216,255,44,0.0); }
        50% { box-shadow: 0 0 24px 4px rgba(216,255,44,0.4); }
      }
      .level-up-pulse { animation: pulse-glow 1.6s ease-in-out 2; }
    </style>

    <script
      define:vars={{
        recordId: record.id,
        weight: Number(record.weight_kg),
        exercise: record.exercise,
        exerciseLabelStr: movement,
        isLevelUp,
        tierColorHex: currentTier ? tierColor(currentTier) : "#D8FF2C",
        tierLabelStr: currentTier ? tierLabel(currentTier) : null,
        percentile: strengthData?.percentile ?? null,
      }}
    >
      // === Count-up animation =========================================
      const el = document.getElementById("count-up");
      if (el) {
        const target = Number(el.dataset.target ?? 0);
        const duration = 800;
        const start = performance.now();
        const animate = (now) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = (target * eased).toFixed(target % 1 === 0 ? 0 : 1);
          if (t < 1) requestAnimationFrame(animate);
          else el.textContent = String(target);
        };
        requestAnimationFrame(animate);
      }

      // === Confetti on level-up =======================================
      // Lightweight pure-canvas confetti — no deps. Fires once when the
      // athlete just leveled up. Particles fall from top in tier colour
      // mixed with brand lime, fade out over ~3 seconds.
      function fireConfetti(color) {
        const canvas = document.getElementById("confetti");
        if (!canvas) return;
        const dpr = window.devicePixelRatio || 1;
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        canvas.style.width = window.innerWidth + "px";
        canvas.style.height = window.innerHeight + "px";
        const ctx = canvas.getContext("2d");
        ctx.scale(dpr, dpr);

        const colors = [color, "#D8FF2C", "#ffffff", "#43B02A", "#FFC72C"];
        const particles = Array.from({ length: 140 }, () => ({
          x: Math.random() * window.innerWidth,
          y: -20 - Math.random() * window.innerHeight * 0.5,
          vx: (Math.random() - 0.5) * 4,
          vy: 2 + Math.random() * 4,
          rot: Math.random() * Math.PI * 2,
          vrot: (Math.random() - 0.5) * 0.2,
          size: 6 + Math.random() * 8,
          color: colors[Math.floor(Math.random() * colors.length)],
          life: 1,
        }));

        const start = performance.now();
        const duration = 3200;

        function frame(now) {
          const elapsed = now - start;
          const fade = Math.max(0, 1 - elapsed / duration);
          ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
          for (const p of particles) {
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.08; // gravity
            p.rot += p.vrot;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.globalAlpha = fade;
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.4);
            ctx.restore();
          }
          if (elapsed < duration) {
            requestAnimationFrame(frame);
          } else {
            ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
          }
        }
        requestAnimationFrame(frame);
      }

      if (isLevelUp) {
        // Slight delay so the count-up has a moment first.
        setTimeout(() => {
          fireConfetti(tierColorHex);
          if (navigator.vibrate) navigator.vibrate([60, 40, 80]);
          const banner = document.getElementById("level-up-banner");
          banner?.classList.add("level-up-pulse");
        }, 700);
      }

      // === SVG → PNG conversion (client-side, brand fonts preserved) ==
      async function svgToPngBlob() {
        const svgEl = document.querySelector(".card-preview svg");
        if (!svgEl) return null;
        const xml = new XMLSerializer().serializeToString(svgEl);
        const svgBlob = new Blob([xml], { type: "image/svg+xml;charset=utf-8" });
        const url = URL.createObjectURL(svgBlob);
        try {
          const img = new Image();
          if (document.fonts && document.fonts.ready) {
            await document.fonts.ready;
          }
          await new Promise((resolve, reject) => {
            img.onload = () => resolve(null);
            img.onerror = reject;
            img.src = url;
          });
          const canvas = document.createElement("canvas");
          canvas.width = 1080;
          canvas.height = 1920;
          const ctx = canvas.getContext("2d");
          if (!ctx) return null;
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, 1080, 1920);
          ctx.drawImage(img, 0, 0, 1080, 1920);
          return await new Promise((resolve) => canvas.toBlob((b) => resolve(b), "image/png", 0.95));
        } finally {
          URL.revokeObjectURL(url);
        }
      }

      function downloadBlob(blob, filename) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

      const filename = `pr-${exercise}-${weight}kg.png`;

      const downloadBtn = document.getElementById("download-png-btn");
      downloadBtn?.addEventListener("click", async () => {
        const original = downloadBtn.textContent;
        downloadBtn.disabled = true;
        downloadBtn.textContent = "Gerando...";
        try {
          const blob = await svgToPngBlob();
          if (!blob) throw new Error("conversion failed");
          downloadBlob(blob, filename);
          downloadBtn.textContent = "Baixado";
          setTimeout(() => { downloadBtn.textContent = original; downloadBtn.disabled = false; }, 1200);
        } catch {
          window.location.href = `/api/pr/card/${recordId}.svg`;
          downloadBtn.textContent = original;
          downloadBtn.disabled = false;
        }
      });

      // === Auto-generated share caption ===============================
      // PT-BR caption with emoji + tier + percentile + hashtags. The body
      // is crafted to read well as Story sticker, Reel description, or
      // WhatsApp message. Optimized to drop into IG/TikTok natively.
      function buildCaption() {
        const lines = [];
        if (isLevelUp && tierLabelStr) {
          lines.push(`🔥 LEVEL UP — ${tierLabelStr.toUpperCase()}`);
          lines.push(`${exerciseLabelStr} · ${weight} kg`);
        } else if (tierLabelStr) {
          lines.push(`💪 Novo PR — ${exerciseLabelStr}`);
          lines.push(`${weight} kg · ${tierLabelStr}`);
        } else {
          lines.push(`💪 Novo PR — ${exerciseLabelStr}`);
          lines.push(`${weight} kg`);
        }
        if (percentile != null) {
          const top = Math.max(1, Math.round(100 - percentile));
          lines.push(`Top ${top}% Brasil`);
        }
        const hashtags = [
          "#PRTracker",
          "#" + exerciseLabelStr.replace(/\s|&|·/g, ""),
          "#Personal Record",
          tierLabelStr ? "#" + tierLabelStr.replace(/\s/g, "") : null,
        ].filter(Boolean);
        lines.push("");
        lines.push(hashtags.join(" "));
        lines.push("@pr.tracker · prtracker.com.br");
        return lines.join("\n");
      }
      const shareBtn = document.getElementById("share-btn");
      shareBtn?.addEventListener("click", async () => {
        const text = buildCaption();
        try {
          const blob = await svgToPngBlob();
          if (blob && navigator.canShare && navigator.share) {
            const file = new File([blob], filename, { type: "image/png" });
            if (navigator.canShare({ files: [file] })) {
              await navigator.share({ title: "PR Tracker", text, files: [file] });
              return;
            }
          }
          if (blob) {
            downloadBlob(blob, filename);
            shareBtn.textContent = "PNG salvo";
            setTimeout(() => { shareBtn.textContent = "Compartilhar"; }, 1500);
          } else {
            const url = `${window.location.origin}/api/pr/card/${recordId}.svg`;
            await navigator.clipboard.writeText(url);
            shareBtn.textContent = "Link copiado";
            setTimeout(() => { shareBtn.textContent = "Compartilhar"; }, 1500);
          }
        } catch {
          // user cancelled
        }
      });
    </script>
  </body>
</html>

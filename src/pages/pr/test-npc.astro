---
// Página de DEBUG pra verificar visualmente se buildNPC renderiza com cabeça.
// Sem auth — público intencional pra debug. Remover antes de produção real.
export const prerender = false;
import "../../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>DEBUG NPC · PR Tracker</title>
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body">
    <header class="px-4 py-3 max-w-4xl mx-auto">
      <h1 class="font-display text-base">DEBUG · NPC Standalone</h1>
      <p class="text-xs text-navy-300">Renderiza 2 NPCs (nutri + personal) com luz forte. Se não aparece cabeça aqui, é bug do buildNPC.</p>
    </header>
    <main class="max-w-4xl mx-auto px-2">
      <div id="canvas-mount" class="rounded-2xl overflow-hidden border border-navy-700 bg-navy-900 relative" style="height: 70vh; min-height: 480px;"></div>
      <pre id="debug-log" class="text-[10px] text-brand-lime mt-3 p-3 bg-navy-800/40 rounded overflow-auto max-h-48 whitespace-pre-wrap"></pre>
    </main>

    <script type="module">
      import * as THREE from "https://esm.sh/three@0.184.0";
      import { OrbitControls } from "https://esm.sh/three@0.184.0/examples/jsm/controls/OrbitControls.js";

      const log = (msg) => {
        const el = document.getElementById("debug-log");
        if (el) el.textContent += msg + "\n";
        console.log(msg);
      };

      // === NPC builder INLINE (cópia do buildNPC pra teste sem importar bundles) ===
      function buildSimpleNPC(props) {
        const root = new THREE.Group();
        const { skinHex, hairHex, topHex, shortsHex, gender, initial } = props;
        const isF = gender === "female";
        const torsoR = isF ? 0.18 : 0.22;
        const headR = 0.21;

        const skinMat = new THREE.MeshStandardMaterial({
          color: skinHex, roughness: 0.7,
          emissive: skinHex, emissiveIntensity: 0.35,
        });
        const hairMat = new THREE.MeshStandardMaterial({
          color: hairHex, roughness: 0.85,
          emissive: hairHex, emissiveIntensity: 0.3,
        });
        const topMat = new THREE.MeshStandardMaterial({ color: topHex, roughness: 0.7 });
        const shortsMat = new THREE.MeshStandardMaterial({ color: shortsHex, roughness: 0.85 });

        // HEAD
        const head = new THREE.Group();
        const skull = new THREE.Mesh(new THREE.SphereGeometry(headR, 24, 18), skinMat);
        skull.scale.set(1.0, 1.06, 1.0);
        head.add(skull);

        for (const sx of [-0.07, 0.07]) {
          const eye = new THREE.Mesh(
            new THREE.SphereGeometry(0.024, 10, 8),
            new THREE.MeshBasicMaterial({ color: 0x0a0a14 })
          );
          eye.position.set(sx, 0.03, headR * 0.92);
          head.add(eye);
        }
        const mouth = new THREE.Mesh(
          new THREE.BoxGeometry(0.08, 0.012, 0.005),
          new THREE.MeshBasicMaterial({ color: 0x4a1f1f })
        );
        mouth.position.set(0, -0.07, headR * 0.94);
        head.add(mouth);

        const hair = new THREE.Mesh(
          new THREE.SphereGeometry(headR + 0.02, 24, 18, 0, Math.PI * 2, 0, Math.PI / 1.8),
          hairMat
        );
        head.add(hair);

        head.position.y = 1.95;
        root.add(head);

        // TORSO
        const torso = new THREE.Mesh(
          new THREE.CylinderGeometry(torsoR, torsoR * 0.92, 0.55, 18),
          topMat
        );
        torso.position.y = 1.375;
        root.add(torso);

        // Hip
        const hip = new THREE.Mesh(
          new THREE.CylinderGeometry(0.21, 0.20, 0.18, 16),
          shortsMat
        );
        hip.position.y = 1.0;
        root.add(hip);

        // Legs
        for (const sx of [-0.1, 0.1]) {
          const leg = new THREE.Group();
          leg.position.set(sx, 0.985, 0);
          const shorts = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.105, 0.18, 10), shortsMat);
          shorts.position.y = -0.09;
          leg.add(shorts);
          const thigh = new THREE.Mesh(new THREE.CylinderGeometry(0.085, 0.07, 0.28, 10), skinMat);
          thigh.position.y = -0.32;
          leg.add(thigh);
          const calf = new THREE.Mesh(new THREE.CylinderGeometry(0.065, 0.055, 0.36, 10), skinMat);
          calf.position.y = -0.65;
          leg.add(calf);
          root.add(leg);
        }

        // Arms
        for (const sx of [-0.24, 0.24]) {
          const arm = new THREE.Group();
          arm.position.set(sx, 1.62, 0);
          const upper = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.06, 0.28, 10), skinMat);
          upper.position.y = -0.2;
          arm.add(upper);
          const lower = new THREE.Mesh(new THREE.CylinderGeometry(0.058, 0.052, 0.26, 10), skinMat);
          lower.position.y = -0.5;
          arm.add(lower);
          root.add(arm);
        }

        return root;
      }

      // === SCENE setup ===
      const mount = document.getElementById("canvas-mount");
      const w = mount.clientWidth;
      const h = mount.clientHeight;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x01002A);

      const camera = new THREE.PerspectiveCamera(50, w / h, 0.1, 100);
      camera.position.set(0, 2.5, 5);
      camera.lookAt(0, 1.5, 0);

      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(w, h);
      mount.appendChild(renderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.set(0, 1.5, 0);
      controls.enableDamping = true;

      // Lighting forte pra garantir visibilidade
      scene.add(new THREE.AmbientLight(0xffffff, 0.8));
      const key = new THREE.DirectionalLight(0xffffff, 1.5);
      key.position.set(3, 5, 3);
      scene.add(key);

      // Floor
      const floor = new THREE.Mesh(
        new THREE.PlaneGeometry(20, 20),
        new THREE.MeshStandardMaterial({ color: 0x1a1a2a })
      );
      floor.rotation.x = -Math.PI / 2;
      scene.add(floor);

      // 2 NPCs lado a lado
      const nutri = buildSimpleNPC({
        skinHex: "#e0b18a", hairHex: "#5e3a1f",
        topHex: "#43B02A", shortsHex: "#1e1b50",
        gender: "female", initial: "C",
      });
      nutri.position.x = -1;
      scene.add(nutri);
      log("Nutri NPC adicionada em x=-1, y=0");

      const pt = buildSimpleNPC({
        skinHex: "#c08a5e", hairHex: "#1a1410",
        topHex: "#1a1a3a", shortsHex: "#111111",
        gender: "male", initial: "B",
      });
      pt.position.x = 1;
      scene.add(pt);
      log("PT NPC adicionado em x=+1, y=0");

      // Marker visual no chão pra cada NPC (cilindro lime baixo)
      for (const x of [-1, 1]) {
        const marker = new THREE.Mesh(
          new THREE.CylinderGeometry(0.5, 0.5, 0.02, 24),
          new THREE.MeshBasicMaterial({ color: 0xD8FF2C, transparent: true, opacity: 0.3 })
        );
        marker.position.set(x, 0.01, 0);
        scene.add(marker);
      }

      // Caixa de referência na altura da cabeça (y=1.95)
      for (const x of [-1, 1]) {
        const refBox = new THREE.Mesh(
          new THREE.BoxGeometry(0.05, 0.05, 0.05),
          new THREE.MeshBasicMaterial({ color: 0xff0000 })
        );
        refBox.position.set(x + 0.4, 1.95, 0);
        scene.add(refBox);
      }
      log("Cubos vermelhos de referência adicionados em y=1.95 (altura esperada da cabeça)");

      // Render loop
      function animate() {
        controls.update();
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      }
      animate();

      // Resize
      window.addEventListener("resize", () => {
        const w = mount.clientWidth;
        const h = mount.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      });

      log("Setup completo. Use mouse pra orbitar.");
    </script>
  </body>
</html>

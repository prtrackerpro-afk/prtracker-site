---
export const prerender = false;
import "../../../styles/global.css";
import GymEditor from "../../../components/pr/GymEditor";
import BottomNav from "../../../components/pr/BottomNav.astro";
import { getServerSupabase } from "../../../lib/supabase/server";
import { DEFAULT_LAYOUT, type GymLayout } from "../../../lib/pr/gym/layout";

const athlete = Astro.locals.athlete!;

// SSR: carrega layout salvo do Supabase. Fallback DEFAULT_LAYOUT.
// O componente GymEditor ainda re-hidrata no client pra pegar
// mudanças feitas em outra aba/device, mas começar com o layout
// correto evita flash visual.
const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});
const { data: athleteRow } = await supabase
  .from("pr_athletes")
  .select("gym_layout")
  .eq("user_id", athlete.userId)
  .maybeSingle();

const initialLayout: GymLayout =
  (athleteRow?.gym_layout as GymLayout | null) ?? DEFAULT_LAYOUT;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Editor do Ginásio · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-20">
    <header class="px-4 pt-4 pb-2 max-w-4xl mx-auto flex items-center justify-between">
      <a href="/pr/gym" class="text-xs text-navy-300 hover:text-white">← Ginásio</a>
      <div class="text-center">
        <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">EDITOR</div>
        <div class="font-display text-base tracking-tight">{athlete.displayName}</div>
      </div>
      <span class="w-10"></span>
    </header>

    <main class="max-w-4xl mx-auto px-4">
      <GymEditor client:only="react" initialLayout={initialLayout} />
    </main>

    <BottomNav active="profile" />
  </body>
</html>

---
export const prerender = false;
import "../../../styles/global.css";
import { getServerSupabase } from "../../../lib/supabase/server";
import { exerciseLabel, type ExerciseId } from "../../../lib/pr/exercises";
import { summarize, tierColor, tierLabel, TIER_META, type Tier } from "../../../lib/pr/strength-score";
import VirtualGym, { type GymTrophy } from "../../../components/pr/VirtualGym";
import BottomNav from "../../../components/pr/BottomNav.astro";

const athlete = Astro.locals.athlete!;
const handle = String(Astro.params.handle ?? "").trim();

if (!handle) {
  return Astro.redirect("/pr/feed");
}

// Fetch via SECURITY DEFINER function — handles visibility check.
const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

const { data: target, error } = await supabase
  .rpc("pr_get_visitable_gym", { p_handle: handle })
  .maybeSingle();

interface VisitableGym {
  user_id: string;
  display_name: string;
  instagram_handle: string;
  body_weight_kg: number | null;
  sex: "male" | "female" | null;
  gym_layout: unknown;
  gym_visibility: "public" | "friends" | "private";
  xp_total: number;
  best_lifts: Record<string, number>;
  skills: Record<string, number>;
  runs: Record<string, number>;
}

const gym = target as VisitableGym | null;

const isOwnGym = gym?.user_id === athlete.userId;
const visitMode = !isOwnGym;
const notFound = !gym && !error;
const wasError = !!error;

// === Build trophies igual gym.astro ===
const bestLifts = (gym?.best_lifts ?? {}) as Partial<Record<ExerciseId, number>>;
const summary = gym
  ? summarize({
      bodyWeightKg: gym.body_weight_kg ?? undefined,
      sex: gym.sex ?? undefined,
      bestLifts,
    })
  : null;

const sorted = summary
  ? [...summary.lifts].sort((a, b) => {
      const r = TIER_META[b.tier].rank - TIER_META[a.tier].rank;
      return r !== 0 ? r : b.weightKg - a.weightKg;
    })
  : [];

const trophies: GymTrophy[] = sorted.map((l) => ({
  color: tierColor(l.tier),
  weightKg: l.weightKg,
  shortLabel: shortName(exerciseLabel(l.exerciseId)),
  exerciseId: l.exerciseId,
  exerciseLabel: exerciseLabel(l.exerciseId),
}));

const fallbackTrophies: GymTrophy[] =
  trophies.length === 0 && gym
    ? Object.entries(bestLifts)
        .slice(0, 12)
        .map(([id, kg]) => ({
          color: "#D8FF2C",
          weightKg: Number(kg),
          shortLabel: shortName(exerciseLabel(id as ExerciseId)),
          exerciseId: id as ExerciseId,
          exerciseLabel: exerciseLabel(id as ExerciseId),
        }))
    : trophies;

const accent = summary?.hasBodyData ? tierColor(summary.overallTier) : "#D8FF2C";
const tierName = summary?.hasBodyData ? tierLabel(summary.overallTier) : "Atleta";

function shortName(label: string): string {
  return label
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 4)
    .toUpperCase();
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>
      {gym ? `Visitando @${gym.instagram_handle} · PR Tracker` : "Ginásio · PR Tracker"}
    </title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-20">
    {notFound ? (
      <div class="max-w-md mx-auto pt-16 px-4 text-center">
        <div class="text-6xl mb-4">🔒</div>
        <h1 class="font-display text-2xl tracking-tight mb-2">Ginásio não encontrado</h1>
        <p class="text-sm text-navy-300 mb-6">
          Esse atleta não existe, está privado, ou só pode ser visitado por amigos.
        </p>
        <a
          href="/pr/feed"
          class="inline-block text-sm bg-brand-lime text-navy-900 font-semibold rounded-lg px-4 py-2.5 hover:opacity-90"
        >
          ← Voltar pro feed
        </a>
      </div>
    ) : wasError ? (
      <div class="max-w-md mx-auto pt-16 px-4 text-center">
        <div class="text-6xl mb-4">⚠️</div>
        <h1 class="font-display text-2xl tracking-tight mb-2">Erro ao carregar</h1>
        <p class="text-xs text-navy-300 mb-2">{error?.message}</p>
        <a href="/pr/feed" class="text-sm text-brand-lime">← Voltar</a>
      </div>
    ) : (
      <>
        <header class="px-4 pt-4 pb-2 max-w-4xl mx-auto flex items-center justify-between">
          <a href="/pr/feed" class="text-xs text-navy-300 hover:text-white">← Feed</a>
          <div class="text-center">
            <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">
              {visitMode ? "VISITANDO" : "MEU GINÁSIO"}
            </div>
            <div class="font-display text-base tracking-tight">{gym!.display_name}</div>
            <div class="text-[10px] text-navy-300">@{gym!.instagram_handle}</div>
          </div>
          <a
            href={`https://instagram.com/${gym!.instagram_handle}`}
            target="_blank"
            rel="noopener"
            class="text-xs text-navy-300 hover:text-brand-lime"
          >
            📷
          </a>
        </header>

        <main class="max-w-4xl mx-auto px-2">
          <div class="rounded-2xl overflow-hidden border border-navy-700 bg-navy-900 relative h-[65vh] min-h-[420px] sm:h-[70vh]">
            <VirtualGym
              client:only="react"
              athleteName={gym!.display_name}
              accent={accent}
              trophies={fallbackTrophies}
              streakDays={0}
              skills={gym!.skills as Record<string, number>}
              runs={gym!.runs as Record<string, number>}
              initialLayout={gym!.gym_layout as null}
              xpTotal={gym!.xp_total}
              visitMode={visitMode}
            >
              <div class="absolute inset-0 grid place-items-center">
                <div class="text-center">
                  <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">
                    Carregando ginásio
                  </div>
                  <div class="text-xs text-navy-300">
                    Visitando {gym!.display_name}...
                  </div>
                </div>
              </div>
            </VirtualGym>

            <div class="pointer-events-none absolute top-3 left-3 text-[10px] uppercase tracking-widest">
              <div class="text-navy-300">Tier</div>
              <div class="font-display text-base" style={`color: ${accent}`}>{tierName}</div>
            </div>
            <div class="pointer-events-none absolute bottom-3 right-3 text-[10px] uppercase tracking-widest text-navy-300 text-right">
              <div>{fallbackTrophies.length} troféu{fallbackTrophies.length === 1 ? "" : "s"}</div>
              {visitMode && <div class="text-brand-lime">Apenas visualização</div>}
            </div>
          </div>

          {visitMode && (
            <section class="mt-4 rounded-2xl border border-brand-lime/30 bg-brand-lime/5 p-4">
              <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mb-1">VISITA</div>
              <div class="text-sm">
                Você está vendo o ginásio de <strong>{gym!.display_name}</strong>.
                <span class="text-navy-300"> Modais e edição desabilitados. Clique em "📷" pra abrir o Instagram.</span>
              </div>
            </section>
          )}
        </main>

        <BottomNav active="profile" />
      </>
    )}
  </body>
</html>

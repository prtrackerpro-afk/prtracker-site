---
export const prerender = false;
import "../../styles/global.css";
import BottomNav from "../../components/pr/BottomNav.astro";
import { getServerSupabase } from "../../lib/supabase/server";

const athlete = Astro.locals.athlete;
if (!athlete) return Astro.redirect("/pr/login");

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

// Top 5 scores de cada jogo
async function fetchTop5(gameId: string) {
  const { data } = await supabase
    .from("pr_arcade_scores")
    .select("score, played_at, user_id")
    .eq("game_id", gameId)
    .order("score", { ascending: false })
    .limit(5);
  return data ?? [];
}

const [bbTop, psTop, wsTop] = await Promise.all([
  fetchTop5("barbell_bounce"),
  fetchTop5("shaker_mixer"),
  fetchTop5("wod_sprint"),
]);

// Best do próprio atleta em cada jogo
async function myBest(gameId: string) {
  const { data } = await supabase
    .from("pr_arcade_scores")
    .select("score")
    .eq("game_id", gameId)
    .eq("user_id", athlete.userId)
    .order("score", { ascending: false })
    .limit(1)
    .maybeSingle();
  return data?.score ?? 0;
}
const [bbMyBest, psMyBest, wsMyBest] = await Promise.all([
  myBest("barbell_bounce"),
  myBest("shaker_mixer"),
  myBest("wod_sprint"),
]);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Fliperama · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto">
      <a href="/pr/gym" class="text-sm text-navy-300 hover:text-white">← Voltar ao gym</a>
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mt-3">FLIPERAMA</div>
      <h1 class="font-display text-3xl tracking-tight text-white">Pega leve. É só diversão.</h1>
      <p class="text-sm text-navy-300">3 jogos fitness-themed. Score não conta XP no app.</p>

      <!-- Quick stats — meu best em cada jogo -->
      <div class="grid grid-cols-3 gap-2 mt-3">
        <div class="bg-navy-800/40 rounded-lg p-2 text-center">
          <div class="text-[9px] uppercase tracking-wider text-brand-lime">BARBELL BOUNCE</div>
          <div class="text-lg font-display font-bold text-white tabular-nums">{bbMyBest}</div>
        </div>
        <div class="bg-navy-800/40 rounded-lg p-2 text-center">
          <div class="text-[9px] uppercase tracking-wider text-pink-400">PROTEIN SHAKER</div>
          <div class="text-lg font-display font-bold text-white tabular-nums">{psMyBest}</div>
        </div>
        <div class="bg-navy-800/40 rounded-lg p-2 text-center">
          <div class="text-[9px] uppercase tracking-wider text-blue-400">WOD SPRINT</div>
          <div class="text-lg font-display font-bold text-white tabular-nums">{wsMyBest}</div>
        </div>
      </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 space-y-6">
      <section class="rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-4 shadow-lg shadow-brand-lime/5">
        <div class="mb-3">
          <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">JOGO 1</div>
          <h2 class="font-display text-xl text-white">Barbell Bounce</h2>
          <p class="text-xs text-navy-300">Endless runner — pula barras, abaixa nas baixas.</p>
        </div>
        <div id="game-container" class="relative w-full" style="min-height: 280px;">
          <canvas
            id="bb-canvas"
            width="640"
            height="360"
            class="bg-navy-900 border-2 border-brand-lime/40 rounded-lg w-full block cursor-pointer"
            style="touch-action: none; image-rendering: pixelated;"
          ></canvas>
          <div id="bb-overlay" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none rounded-lg" style="background: rgba(0,0,0,0.5);">
            <div class="text-3xl sm:text-4xl font-display font-bold text-brand-lime mb-2">▶ TOQUE PRA JOGAR</div>
            <div class="text-xs text-white/80" id="bb-hi-display">Best: 0</div>
          </div>
        </div>
        <div class="text-xs text-navy-300 text-center mt-3 max-w-md mx-auto">
          <strong class="text-white">Como jogar:</strong> ESPAÇO ou ↑ pra pular ·
          ↓ pra abaixar · No celular: tap pula, swipe ↓ abaixa.
        </div>
        <div class="text-center mt-3" id="bb-result" style="display:none;">
          <div class="text-2xl font-display font-bold text-white" id="bb-final-score">Score: 0</div>
          <button id="bb-restart" type="button" class="mt-3 bg-brand-lime text-navy-900 font-display font-bold rounded-xl px-8 py-3.5 text-base shadow-lg shadow-brand-lime/30 hover:opacity-90 hover:scale-[1.03] active:scale-100 transition">
            ↻ Jogar de novo
          </button>
        </div>
      </section>

      <section class="rounded-2xl border-2 border-pink-500/40 bg-pink-500/5 p-4 shadow-lg shadow-pink-500/5">
        <div class="mb-3">
          <div class="text-[10px] uppercase tracking-[0.3em] text-pink-400">JOGO 2</div>
          <h2 class="font-display text-xl text-white">Protein Shaker</h2>
          <p class="text-xs text-navy-300">Match-3 — combine 3+ ingredientes iguais. 60 segundos.</p>
        </div>
        <div id="ps-container" class="relative w-full" style="min-height: 280px;">
          <canvas
            id="ps-canvas"
            width="480"
            height="480"
            class="bg-navy-900 border-2 border-pink-500/40 rounded-lg w-full block cursor-pointer mx-auto"
            style="touch-action: none; image-rendering: pixelated; max-width: 480px;"
          ></canvas>
          <div id="ps-overlay" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none rounded-lg" style="background: rgba(0,0,0,0.5);">
            <div class="text-3xl font-display font-bold text-pink-400 mb-2">▶ TOQUE PRA JOGAR</div>
            <div class="text-xs text-white/80" id="ps-hi-display">Best: 0</div>
          </div>
        </div>
        <div class="text-xs text-navy-300 text-center mt-3 max-w-md mx-auto">
          <strong class="text-white">Como jogar:</strong> Clica num tile e depois num adjacente pra trocar.
          Match-3+ = pontos. Combo aumenta o multiplicador.
        </div>
        <div class="text-center mt-3" id="ps-result" style="display:none;">
          <div class="text-2xl font-display font-bold text-white" id="ps-final-score">Score: 0</div>
          <button id="ps-restart" type="button" class="mt-3 bg-pink-500 text-white font-display font-bold rounded-xl px-8 py-3.5 text-base shadow-lg shadow-pink-500/30 hover:opacity-90 hover:scale-[1.03] active:scale-100 transition">
            ↻ Jogar de novo
          </button>
        </div>
      </section>

      <section class="rounded-2xl border-2 border-blue-500/40 bg-blue-500/5 p-4 shadow-lg shadow-blue-500/5">
        <div class="mb-3">
          <div class="text-[10px] uppercase tracking-[0.3em] text-blue-400">JOGO 3</div>
          <h2 class="font-display text-xl text-white">WOD Sprint</h2>
          <p class="text-xs text-navy-300">Tap rítmico nos exercícios. 60 segundos. Acerta o timing.</p>
        </div>
        <div id="ws-container" class="relative w-full" style="min-height: 280px;">
          <canvas
            id="ws-canvas"
            width="480"
            height="540"
            class="bg-navy-900 border-2 border-blue-500/40 rounded-lg w-full block cursor-pointer mx-auto"
            style="touch-action: none; image-rendering: pixelated; max-width: 480px;"
          ></canvas>
          <div id="ws-overlay" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none rounded-lg" style="background: rgba(0,0,0,0.5);">
            <div class="text-3xl font-display font-bold text-blue-400 mb-2">▶ TOQUE PRA JOGAR</div>
            <div class="text-xs text-white/80" id="ws-hi-display">Best: 0</div>
          </div>
        </div>
        <div class="text-xs text-navy-300 text-center mt-3 max-w-md mx-auto">
          <strong class="text-white">Como jogar:</strong> Tap nas notas quando entrarem na zona lime.
          Teclas A/S/D/F (desktop) ou tap no botão (mobile).
        </div>
        <div class="text-center mt-3" id="ws-result" style="display:none;">
          <div class="text-2xl font-display font-bold text-white" id="ws-final-score">Score: 0</div>
          <button id="ws-restart" type="button" class="mt-3 bg-blue-500 text-white font-display font-bold rounded-xl px-8 py-3.5 text-base shadow-lg shadow-blue-500/30 hover:opacity-90 hover:scale-[1.03] active:scale-100 transition">
            ↻ Jogar de novo
          </button>
        </div>
      </section>
    </main>

    <BottomNav active="profile" />

    <script is:inline>
      // Vanilla JS Barbell Bounce — sem React, hidratacao garantida.
      (function () {
        const canvas = document.getElementById("bb-canvas");
        const overlay = document.getElementById("bb-overlay");
        const hiDisplay = document.getElementById("bb-hi-display");
        const result = document.getElementById("bb-result");
        const finalScoreEl = document.getElementById("bb-final-score");
        const restartBtn = document.getElementById("bb-restart");
        if (!canvas || !overlay) {
          console.error("[bb] canvas/overlay missing");
          return;
        }
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let hi = Number(localStorage.getItem("pr_bb_hi") || "0");
        if (hiDisplay) hiDisplay.textContent = "Best: " + hi;

        let running = false;
        let rafId = 0;

        function startGame() {
          if (running) return;
          running = true;
          overlay.style.display = "none";
          result.style.display = "none";

          const W = canvas.width;
          const H = canvas.height;
          const groundY = H - 60;

          const player = { x: 80, y: groundY, vy: 0, w: 38, h: 56 };
          const gravity = 0.85;
          const jumpV = -16;

          let obstacles = [];
          let frame = 0;
          let speed = 6;
          let scoreLocal = 0;
          let jumpHeld = false;
          let duckHeld = false;

          function spawn() {
            // 3 tipos: kettlebell (low jump), plate stack (medium jump), barbell rack (slide under)
            const r = Math.random();
            if (r < 0.4) {
              // Kettlebell — pequena no chao, precisa pular
              obstacles.push({ x: W + 20, y: groundY - 38, w: 36, h: 38, type: "kettlebell" });
            } else if (r < 0.75) {
              // Plate stack — anilhas empilhadas, precisa pular
              obstacles.push({ x: W + 20, y: groundY - 60, w: 32, h: 60, type: "plate" });
            } else {
              // Pull-up bar — alta, precisa abaixar
              obstacles.push({ x: W + 20, y: groundY - 130, w: 60, h: 14, type: "pullup" });
            }
          }

          function onKeyDown(e) {
            if (e.code === "Space" || e.code === "ArrowUp") {
              e.preventDefault();
              jumpHeld = true;
            }
            if (e.code === "ArrowDown") {
              e.preventDefault();
              duckHeld = true;
            }
          }
          function onKeyUp(e) {
            if (e.code === "Space" || e.code === "ArrowUp") jumpHeld = false;
            if (e.code === "ArrowDown") duckHeld = false;
          }
          window.addEventListener("keydown", onKeyDown);
          window.addEventListener("keyup", onKeyUp);

          let touchStartY = 0;
          function onPointerDown(e) {
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            touchStartY = e.clientY - rect.top;
            jumpHeld = true;
          }
          function onPointerMove(e) {
            if (!jumpHeld) return;
            const rect = canvas.getBoundingClientRect();
            const y = e.clientY - rect.top;
            if (y - touchStartY > 25) {
              duckHeld = true;
              jumpHeld = false;
            }
          }
          function onPointerUp() {
            jumpHeld = false;
            duckHeld = false;
          }
          canvas.addEventListener("pointerdown", onPointerDown);
          canvas.addEventListener("pointermove", onPointerMove);
          canvas.addEventListener("pointerup", onPointerUp);
          canvas.addEventListener("pointercancel", onPointerUp);

          function endGame() {
            running = false;
            cancelAnimationFrame(rafId);
            window.removeEventListener("keydown", onKeyDown);
            window.removeEventListener("keyup", onKeyUp);
            canvas.removeEventListener("pointerdown", onPointerDown);
            canvas.removeEventListener("pointermove", onPointerMove);
            canvas.removeEventListener("pointerup", onPointerUp);
            canvas.removeEventListener("pointercancel", onPointerUp);

            // Game over overlay no canvas
            ctx.fillStyle = "rgba(1,0,42,0.85)";
            ctx.fillRect(0, 0, W, H);
            ctx.fillStyle = "#DA291C";
            ctx.font = "bold 48px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("GAME OVER", W / 2, H / 2 - 10);
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 28px sans-serif";
            ctx.fillText("Score: " + scoreLocal, W / 2, H / 2 + 30);

            if (scoreLocal > hi) {
              hi = scoreLocal;
              localStorage.setItem("pr_bb_hi", String(hi));
              if (hiDisplay) hiDisplay.textContent = "Best: " + hi;
            }
            if (scoreLocal > 50) {
              fetch("/api/pr/arcade/score", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ game_id: "barbell_bounce", score: scoreLocal }),
              }).catch(function () {});
            }

            finalScoreEl.textContent = "Score: " + scoreLocal + " · Best: " + hi;
            result.style.display = "block";
          }

          // === Athlete sprite (vanilla 2D drawing) ===
          function drawAthlete(ctx, px, py, ph, ducking, frame) {
            // Cabeça circular skin tone
            const skinColor = "#e0b18a";
            const headR = 8;
            const headX = px + 20;
            const headY = py + headR + 2;
            ctx.fillStyle = skinColor;
            ctx.beginPath();
            ctx.arc(headX, headY, headR, 0, Math.PI * 2);
            ctx.fill();
            // Cabelo (cap escuro)
            ctx.fillStyle = "#1a1410";
            ctx.beginPath();
            ctx.arc(headX, headY - 1, headR, Math.PI, 0);
            ctx.fill();
            // Olho
            ctx.fillStyle = "#01002A";
            ctx.fillRect(headX + 3, headY - 1, 2, 2);
            // Sorriso
            ctx.strokeStyle = "#01002A";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.arc(headX + 2, headY + 3, 2, 0, Math.PI);
            ctx.stroke();

            // Corpo (regata lime PR TRACKER)
            const torsoY = py + 14;
            const torsoH = ducking ? 10 : 22;
            ctx.fillStyle = "#D8FF2C";
            ctx.fillRect(px + 12, torsoY, 18, torsoH);
            // Logo PR no peito
            ctx.fillStyle = "#01002A";
            ctx.font = "bold 8px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("PR", px + 21, torsoY + 11);

            if (!ducking) {
              // Pernas (shorts navy + skin)
              const legBob = Math.sin(frame * 0.4) * 3;
              ctx.fillStyle = "#1e1b50";
              ctx.fillRect(px + 13, py + 36, 7, 8); // shorts esq
              ctx.fillRect(px + 22, py + 36, 7, 8); // shorts dir
              ctx.fillStyle = skinColor;
              ctx.fillRect(px + 14, py + 44 - legBob, 5, 8); // perna esq
              ctx.fillRect(px + 23, py + 44 + legBob, 5, 8); // perna dir
              ctx.fillStyle = "#0a0a14";
              ctx.fillRect(px + 13, py + 52 - legBob, 7, 4); // tenis esq
              ctx.fillRect(px + 22, py + 52 + legBob, 7, 4); // tenis dir
              // Sola lime
              ctx.fillStyle = "#D8FF2C";
              ctx.fillRect(px + 13, py + 55 - legBob, 7, 1);
              ctx.fillRect(px + 22, py + 55 + legBob, 7, 1);

              // Braço direito segurando barbell (mini)
              ctx.fillStyle = skinColor;
              ctx.fillRect(px + 30, py + 18, 4, 12);
              // Mini barbell na mao direita
              ctx.fillStyle = "#dfe2e8"; // chrome
              ctx.fillRect(px + 30, py + 14, 3, 3); // bar vertical
              // Plate vermelho topo
              ctx.fillStyle = "#DA291C";
              ctx.beginPath();
              ctx.arc(px + 31, py + 13, 4, 0, Math.PI * 2);
              ctx.fill();
              // Plate azul base
              ctx.fillStyle = "#0057B8";
              ctx.beginPath();
              ctx.arc(px + 31, py + 30, 4, 0, Math.PI * 2);
              ctx.fill();

              // Braço esquerdo
              ctx.fillStyle = skinColor;
              ctx.fillRect(px + 8, py + 18, 4, 14);
            } else {
              // Ducking: pernas dobradas + cabeça mais baixa
              ctx.fillStyle = "#1e1b50";
              ctx.fillRect(px + 13, py + 24, 16, 6);
              ctx.fillStyle = "#0a0a14";
              ctx.fillRect(px + 13, py + 28, 7, 2);
              ctx.fillRect(px + 22, py + 28, 7, 2);
            }
          }

          function drawObstacle(ctx, o) {
            if (o.type === "kettlebell") {
              // Kettlebell preta com handle metalico
              const cx = o.x + o.w / 2;
              const cy = o.y + 18;
              ctx.fillStyle = "#141420";
              ctx.beginPath();
              ctx.arc(cx, cy, 14, 0, Math.PI * 2);
              ctx.fill();
              // Handle metalico
              ctx.strokeStyle = "#dfe2e8";
              ctx.lineWidth = 4;
              ctx.beginPath();
              ctx.arc(cx, cy - 12, 7, Math.PI, 0);
              ctx.stroke();
              // Reflexo
              ctx.fillStyle = "rgba(255,255,255,0.15)";
              ctx.beginPath();
              ctx.arc(cx - 4, cy - 4, 4, 0, Math.PI * 2);
              ctx.fill();
              // Numero do peso
              ctx.fillStyle = "#D8FF2C";
              ctx.font = "bold 9px sans-serif";
              ctx.textAlign = "center";
              ctx.fillText("16", cx, cy + 3);
            } else if (o.type === "plate") {
              // Stack de plates IWF (vermelho-azul-amarelo)
              ctx.fillStyle = "#DA291C";
              ctx.fillRect(o.x, o.y, o.w, 16); // top plate
              ctx.fillStyle = "#0057B8";
              ctx.fillRect(o.x, o.y + 18, o.w, 16); // mid
              ctx.fillStyle = "#FFC72C";
              ctx.fillRect(o.x, o.y + 36, o.w, 16); // bottom
              // Hub central preto
              ctx.fillStyle = "#0a0a14";
              ctx.fillRect(o.x + o.w / 2 - 3, o.y, 6, o.h);
            } else if (o.type === "pullup") {
              // Pull-up bar — barra horizontal alta + 2 postes saindo
              ctx.fillStyle = "#dfe2e8";
              ctx.fillRect(o.x, o.y, o.w, 6); // bar chrome
              ctx.fillStyle = "#4a4d5a";
              ctx.fillRect(o.x, o.y + 6, 6, 8); // poste esq
              ctx.fillRect(o.x + o.w - 6, o.y + 6, 6, 8); // poste dir
              // Knurling lines
              ctx.strokeStyle = "#9aa3b0";
              ctx.lineWidth = 1;
              for (let i = 4; i < o.w - 4; i += 4) {
                ctx.beginPath();
                ctx.moveTo(o.x + i, o.y + 1);
                ctx.lineTo(o.x + i, o.y + 5);
                ctx.stroke();
              }
            }
          }

          function loop() {
            if (!running) return;
            frame++;

            if (jumpHeld && player.y >= groundY - 1) player.vy = jumpV;
            const ducking = duckHeld && player.y >= groundY - 1;
            player.vy += gravity;
            player.y += player.vy;
            if (player.y > groundY) {
              player.y = groundY;
              player.vy = 0;
            }

            const playerH = ducking ? 30 : player.h;
            const playerY = ducking ? groundY - 30 : player.y - player.h;

            if (frame % Math.max(50, 90 - Math.floor(scoreLocal / 100)) === 0) spawn();

            obstacles.forEach(function (o) {
              o.x -= speed;
            });
            obstacles = obstacles.filter(function (o) {
              return o.x + o.w > 0;
            });

            for (let i = 0; i < obstacles.length; i++) {
              const o = obstacles[i];
              if (
                player.x < o.x + o.w &&
                player.x + player.w > o.x &&
                playerY < o.y + o.h &&
                playerY + playerH > o.y
              ) {
                endGame();
                return;
              }
            }

            if (frame % 200 === 0 && speed < 14) speed += 0.5;
            scoreLocal = Math.floor(frame / 6);

            // Render
            ctx.fillStyle = "#01002A";
            ctx.fillRect(0, 0, W, H);

            ctx.strokeStyle = "rgba(216,255,44,0.1)";
            ctx.lineWidth = 1;
            for (let i = 0; i < 5; i++) {
              const x = (frame * speed * 0.3 + i * 100) % W;
              ctx.beginPath();
              ctx.moveTo(x, groundY);
              ctx.lineTo(x - 30, H);
              ctx.stroke();
            }

            ctx.fillStyle = "#0a0a14";
            ctx.fillRect(0, groundY, W, H - groundY);
            ctx.strokeStyle = "#D8FF2C";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, groundY);
            ctx.lineTo(W, groundY);
            ctx.stroke();

            // Player — atleta com barbell nas mãos (cycles 1-3 fitness visual)
            drawAthlete(ctx, player.x, playerY, playerH, ducking, frame);

            for (let i = 0; i < obstacles.length; i++) {
              const o = obstacles[i];
              drawObstacle(ctx, o);
            }

            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 24px sans-serif";
            ctx.textAlign = "left";
            ctx.fillText("SCORE: " + scoreLocal, 16, 30);
            ctx.font = "14px sans-serif";
            ctx.fillStyle = "#9ca3af";
            ctx.fillText("HI: " + hi, 16, 50);

            rafId = requestAnimationFrame(loop);
          }
          rafId = requestAnimationFrame(loop);
        }

        // Tela inicial — desenha o "fundo" do jogo + atleta parado
        function drawIdle() {
          const W = canvas.width;
          const H = canvas.height;
          const groundY = H - 60;
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, W, H);
          // Background gym silhuetas (rack, bench)
          ctx.fillStyle = "rgba(216,255,44,0.08)";
          // Power rack silhouette
          ctx.fillRect(W - 180, groundY - 90, 6, 90);
          ctx.fillRect(W - 100, groundY - 90, 6, 90);
          ctx.fillRect(W - 180, groundY - 90, 86, 4);
          // Bench silhouette
          ctx.fillRect(W - 350, groundY - 30, 100, 4);
          ctx.fillRect(W - 340, groundY - 30, 4, 30);
          ctx.fillRect(W - 260, groundY - 30, 4, 30);
          // Floor
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(0, groundY, W, 60);
          ctx.strokeStyle = "#D8FF2C";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(0, groundY);
          ctx.lineTo(W, groundY);
          ctx.stroke();
          // Player parado
          drawAthlete(ctx, 80, groundY - 56, 56, false, 0);

          function drawAthlete(ctx, px, py, ph, ducking, frame) {
            const skinColor = "#e0b18a";
            const headR = 8;
            const headX = px + 20;
            const headY = py + headR + 2;
            ctx.fillStyle = skinColor;
            ctx.beginPath();
            ctx.arc(headX, headY, headR, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = "#1a1410";
            ctx.beginPath();
            ctx.arc(headX, headY - 1, headR, Math.PI, 0);
            ctx.fill();
            ctx.fillStyle = "#01002A";
            ctx.fillRect(headX + 3, headY - 1, 2, 2);
            ctx.strokeStyle = "#01002A";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.arc(headX + 2, headY + 3, 2, 0, Math.PI);
            ctx.stroke();
            ctx.fillStyle = "#D8FF2C";
            ctx.fillRect(px + 12, py + 14, 18, 22);
            ctx.fillStyle = "#01002A";
            ctx.font = "bold 8px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("PR", px + 21, py + 25);
            ctx.fillStyle = "#1e1b50";
            ctx.fillRect(px + 13, py + 36, 7, 8);
            ctx.fillRect(px + 22, py + 36, 7, 8);
            ctx.fillStyle = skinColor;
            ctx.fillRect(px + 14, py + 44, 5, 8);
            ctx.fillRect(px + 23, py + 44, 5, 8);
            ctx.fillStyle = "#0a0a14";
            ctx.fillRect(px + 13, py + 52, 7, 4);
            ctx.fillRect(px + 22, py + 52, 7, 4);
            ctx.fillStyle = "#D8FF2C";
            ctx.fillRect(px + 13, py + 55, 7, 1);
            ctx.fillRect(px + 22, py + 55, 7, 1);
            // Bracos parado
            ctx.fillStyle = skinColor;
            ctx.fillRect(px + 8, py + 18, 4, 14);
            ctx.fillRect(px + 30, py + 18, 4, 14);
          }
        }
        drawIdle();

        // Click/keyboard pra iniciar
        canvas.addEventListener("click", function () {
          if (!running) startGame();
        });
        // Touch separadamente pra mobile
        canvas.addEventListener("touchstart", function (e) {
          if (!running) {
            e.preventDefault();
            startGame();
          }
        });
        window.addEventListener("keydown", function (e) {
          if (!running && e.code === "Space") {
            e.preventDefault();
            startGame();
          }
        });
        if (restartBtn) restartBtn.addEventListener("click", function () {
          if (!running) startGame();
        });
      })();
    </script>

    <script is:inline>
      // === JOGO 2 — PROTEIN SHAKER (match-3) ===
      (function () {
        const canvas = document.getElementById("ps-canvas");
        const overlay = document.getElementById("ps-overlay");
        const hiDisplay = document.getElementById("ps-hi-display");
        const result = document.getElementById("ps-result");
        const finalScoreEl = document.getElementById("ps-final-score");
        const restartBtn = document.getElementById("ps-restart");
        if (!canvas || !overlay) return;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let hi = Number(localStorage.getItem("pr_ps_hi") || "0");
        if (hiDisplay) hiDisplay.textContent = "Best: " + hi;

        const COLS = 6;
        const ROWS = 6;
        const CELL = 80;
        const TOP_PAD = 0; // tabuleiro comeca em y=0
        const TYPES = 6; // 6 ingredientes
        // Ingredientes: 0=whey(branco), 1=banana(amarelo), 2=ovo(creme), 3=oat(marrom), 4=leite(azul), 5=morango(rosa)
        const COLORS = ["#ffffff", "#FFC72C", "#fff8c8", "#8c5a3a", "#0057B8", "#ff66aa"];
        const ICONS = ["W", "🍌", "🥚", "🌾", "M", "🍓"];

        let board = [];
        let running = false;
        let timeLeft = 60;
        let score = 0;
        let combo = 0;
        let timerInterval = 0;
        let selected = null;
        let animationOffsets = []; // pra anim de fall

        function newBoard() {
          board = [];
          for (let r = 0; r < ROWS; r++) {
            const row = [];
            for (let c = 0; c < COLS; c++) {
              row.push(Math.floor(Math.random() * TYPES));
            }
            board.push(row);
          }
          // Re-randomize matches iniciais
          let attempts = 0;
          while (findMatches().length > 0 && attempts < 100) {
            const m = findMatches()[0];
            board[m.r][m.c] = (board[m.r][m.c] + 1) % TYPES;
            attempts++;
          }
        }

        function findMatches() {
          const matches = [];
          // Horizontal
          for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS - 2; c++) {
              const v = board[r][c];
              if (v < 0) continue;
              if (board[r][c + 1] === v && board[r][c + 2] === v) {
                let len = 3;
                while (c + len < COLS && board[r][c + len] === v) len++;
                for (let i = 0; i < len; i++) matches.push({ r, c: c + i });
                c += len - 1;
              }
            }
          }
          // Vertical
          for (let c = 0; c < COLS; c++) {
            for (let r = 0; r < ROWS - 2; r++) {
              const v = board[r][c];
              if (v < 0) continue;
              if (board[r + 1][c] === v && board[r + 2][c] === v) {
                let len = 3;
                while (r + len < ROWS && board[r + len][c] === v) len++;
                for (let i = 0; i < len; i++) matches.push({ r: r + i, c });
                r += len - 1;
              }
            }
          }
          return matches;
        }

        function clearAndFall() {
          const matches = findMatches();
          if (matches.length === 0) {
            combo = 0;
            return false;
          }
          // Pontuar
          score += matches.length * 10 * (1 + combo * 0.5);
          combo++;
          // Marcar tiles como -1
          for (const m of matches) board[m.r][m.c] = -1;
          // Fall down
          for (let c = 0; c < COLS; c++) {
            let writeRow = ROWS - 1;
            for (let r = ROWS - 1; r >= 0; r--) {
              if (board[r][c] !== -1) {
                board[writeRow][c] = board[r][c];
                if (writeRow !== r) board[r][c] = -1;
                writeRow--;
              }
            }
            // Fill top
            for (let r = writeRow; r >= 0; r--) {
              board[r][c] = Math.floor(Math.random() * TYPES);
            }
          }
          return true;
        }

        function trySwap(a, b) {
          // Adjacente?
          const dr = Math.abs(a.r - b.r);
          const dc = Math.abs(a.c - b.c);
          if (!(dr + dc === 1)) return false;
          const tmp = board[a.r][a.c];
          board[a.r][a.c] = board[b.r][b.c];
          board[b.r][b.c] = tmp;
          if (findMatches().length === 0) {
            // Reverter
            board[b.r][b.c] = board[a.r][a.c];
            board[a.r][a.c] = tmp;
            return false;
          }
          // Cascata de matches
          let cascadeLoops = 0;
          while (clearAndFall() && cascadeLoops < 10) cascadeLoops++;
          return true;
        }

        function drawTile(r, c, type) {
          const x = c * CELL;
          const y = r * CELL;
          if (type < 0) return;
          // Bg cell
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(x + 2, y + 2, CELL - 4, CELL - 4);
          // Tile color
          ctx.fillStyle = COLORS[type] || "#ffffff";
          ctx.fillRect(x + 6, y + 6, CELL - 12, CELL - 12);
          // Selected highlight
          if (selected && selected.r === r && selected.c === c) {
            ctx.strokeStyle = "#D8FF2C";
            ctx.lineWidth = 4;
            ctx.strokeRect(x + 4, y + 4, CELL - 8, CELL - 8);
          }
          // Icon centered
          ctx.fillStyle = "#01002A";
          ctx.font = "bold 32px sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(ICONS[type] || "?", x + CELL / 2, y + CELL / 2 + 4);
        }

        function render() {
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
              drawTile(r, c, board[r][c]);
            }
          }
          // HUD top right
          ctx.fillStyle = "#ff66aa";
          ctx.font = "bold 22px sans-serif";
          ctx.textAlign = "right";
          ctx.textBaseline = "top";
          ctx.fillText(Math.round(score), canvas.width - 10, 5);
          ctx.fillStyle = "#ffffff";
          ctx.font = "12px sans-serif";
          ctx.fillText("SCORE", canvas.width - 10, 32);
          // Timer
          ctx.fillStyle = timeLeft <= 10 ? "#DA291C" : "#D8FF2C";
          ctx.font = "bold 22px sans-serif";
          ctx.textAlign = "left";
          ctx.fillText(timeLeft + "s", 10, 5);
          if (combo > 1) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 18px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("COMBO x" + combo, canvas.width / 2, 8);
          }
        }

        function startGame() {
          if (running) return;
          running = true;
          score = 0;
          combo = 0;
          timeLeft = 60;
          newBoard();
          overlay.style.display = "none";
          result.style.display = "none";
          render();
          timerInterval = setInterval(function () {
            timeLeft--;
            render();
            if (timeLeft <= 0) endGame();
          }, 1000);
        }

        function endGame() {
          running = false;
          clearInterval(timerInterval);
          if (score > hi) {
            hi = Math.round(score);
            localStorage.setItem("pr_ps_hi", String(hi));
            if (hiDisplay) hiDisplay.textContent = "Best: " + hi;
          }
          if (score > 50) {
            fetch("/api/pr/arcade/score", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ game_id: "shaker_mixer", score: Math.round(score) }),
            }).catch(function () {});
          }
          // Pinta GAME OVER
          ctx.fillStyle = "rgba(1,0,42,0.85)";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = "#ff66aa";
          ctx.font = "bold 40px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("ACABOU O TEMPO!", canvas.width / 2, canvas.height / 2 - 10);
          ctx.fillStyle = "#D8FF2C";
          ctx.font = "bold 24px sans-serif";
          ctx.fillText("Score: " + Math.round(score), canvas.width / 2, canvas.height / 2 + 30);
          finalScoreEl.textContent = "Score: " + Math.round(score) + " · Best: " + hi;
          result.style.display = "block";
        }

        function getCellFromEvent(e) {
          const rect = canvas.getBoundingClientRect();
          const cx = ((e.clientX - rect.left) / rect.width) * canvas.width;
          const cy = ((e.clientY - rect.top) / rect.height) * canvas.height;
          const c = Math.floor(cx / CELL);
          const r = Math.floor(cy / CELL);
          if (r < 0 || r >= ROWS || c < 0 || c >= COLS) return null;
          return { r, c };
        }

        canvas.addEventListener("pointerdown", function (e) {
          if (!running) return;
          e.preventDefault();
          const cell = getCellFromEvent(e);
          if (!cell) return;
          if (!selected) {
            selected = cell;
            render();
            return;
          }
          if (selected.r === cell.r && selected.c === cell.c) {
            selected = null;
            render();
            return;
          }
          const swapped = trySwap(selected, cell);
          selected = null;
          render();
        });

        // Idle: tabuleiro com tiles random
        newBoard();
        render();

        canvas.addEventListener("click", function () {
          if (!running) startGame();
        });
        canvas.addEventListener("touchstart", function (e) {
          if (!running) {
            e.preventDefault();
            startGame();
          }
        });
        if (restartBtn) restartBtn.addEventListener("click", function () {
          if (!running) startGame();
        });
      })();
    </script>

    <script is:inline>
      // === JOGO 3 — WOD SPRINT (rhythm tap) ===
      (function () {
        const canvas = document.getElementById("ws-canvas");
        const overlay = document.getElementById("ws-overlay");
        const hiDisplay = document.getElementById("ws-hi-display");
        const result = document.getElementById("ws-result");
        const finalScoreEl = document.getElementById("ws-final-score");
        const restartBtn = document.getElementById("ws-restart");
        if (!canvas || !overlay) return;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let hi = Number(localStorage.getItem("pr_ws_hi") || "0");
        if (hiDisplay) hiDisplay.textContent = "Best: " + hi;

        const W = canvas.width;
        const H = canvas.height;
        const LANE_COUNT = 4;
        const LANE_W = W / LANE_COUNT;
        const HIT_Y = H - 80;
        const HIT_TOLERANCE = 35; // pixels
        const NOTE_R = 30;
        const LANE_LABELS = ["BURPEE", "SQUAT", "PUSH", "JUMP"];
        const LANE_KEYS = ["KeyA", "KeyS", "KeyD", "KeyF"];
        const LANE_COLORS = ["#DA291C", "#FFC72C", "#0057B8", "#43B02A"];

        let notes = [];
        let running = false;
        let score = 0;
        let combo = 0;
        let perfectCount = 0;
        let goodCount = 0;
        let missCount = 0;
        let timeLeft = 60;
        let frame = 0;
        let timerInterval = 0;
        let lastFlash = [0, 0, 0, 0];
        let rafId = 0;

        function spawnNote() {
          notes.push({
            lane: Math.floor(Math.random() * LANE_COUNT),
            y: -NOTE_R,
            hit: false,
          });
        }

        function endGame() {
          running = false;
          cancelAnimationFrame(rafId);
          clearInterval(timerInterval);
          window.removeEventListener("keydown", onKey);
          if (score > hi) {
            hi = score;
            localStorage.setItem("pr_ws_hi", String(hi));
            if (hiDisplay) hiDisplay.textContent = "Best: " + hi;
          }
          if (score > 50) {
            fetch("/api/pr/arcade/score", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ game_id: "wod_sprint", score: score }),
            }).catch(function () {});
          }
          ctx.fillStyle = "rgba(1,0,42,0.88)";
          ctx.fillRect(0, 0, W, H);
          ctx.fillStyle = "#0057B8";
          ctx.font = "bold 36px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("WOD COMPLETO!", W / 2, H / 2 - 30);
          ctx.fillStyle = "#D8FF2C";
          ctx.font = "bold 24px sans-serif";
          ctx.fillText("Score: " + score, W / 2, H / 2 + 10);
          ctx.fillStyle = "#ffffff";
          ctx.font = "16px sans-serif";
          ctx.fillText("Perfect: " + perfectCount + " · Good: " + goodCount + " · Miss: " + missCount, W / 2, H / 2 + 40);
          finalScoreEl.textContent = "Score: " + score + " · Best: " + hi;
          result.style.display = "block";
        }

        function tryHit(lane) {
          for (const n of notes) {
            if (n.hit || n.lane !== lane) continue;
            const dist = Math.abs(n.y - HIT_Y);
            if (dist < HIT_TOLERANCE) {
              n.hit = true;
              if (dist < 10) {
                score += 100 + combo * 5;
                perfectCount++;
              } else {
                score += 50 + combo * 2;
                goodCount++;
              }
              combo++;
              lastFlash[lane] = frame;
              return;
            }
          }
          // Miss tap = perde combo
          combo = 0;
        }

        function onKey(e) {
          if (!running) return;
          const idx = LANE_KEYS.indexOf(e.code);
          if (idx >= 0) {
            e.preventDefault();
            tryHit(idx);
          }
        }

        function loop() {
          if (!running) return;
          frame++;
          // Spawn notas em ritmo (~ a cada 30 frames = 0.5s a 60fps)
          if (frame % Math.max(20, 35 - Math.floor((60 - timeLeft) / 5)) === 0) {
            spawnNote();
          }
          // Move notas
          const speed = 5 + (60 - timeLeft) * 0.05;
          for (const n of notes) {
            if (!n.hit) n.y += speed;
          }
          // Notas que passaram = miss
          for (const n of notes) {
            if (!n.hit && n.y > HIT_Y + HIT_TOLERANCE + NOTE_R) {
              n.hit = "miss";
              missCount++;
              combo = 0;
            }
          }
          notes = notes.filter(function (n) {
            return n.y < H + NOTE_R;
          });

          // Render
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, W, H);
          // Lanes (linhas verticais)
          ctx.strokeStyle = "rgba(255,255,255,0.08)";
          ctx.lineWidth = 1;
          for (let l = 1; l < LANE_COUNT; l++) {
            ctx.beginPath();
            ctx.moveTo(l * LANE_W, 0);
            ctx.lineTo(l * LANE_W, H);
            ctx.stroke();
          }
          // Hit zone (linha lime)
          ctx.strokeStyle = "#D8FF2C";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(0, HIT_Y);
          ctx.lineTo(W, HIT_Y);
          ctx.stroke();
          // Hit zone tolerance area
          ctx.fillStyle = "rgba(216,255,44,0.08)";
          ctx.fillRect(0, HIT_Y - HIT_TOLERANCE, W, HIT_TOLERANCE * 2);
          // Botoes inferiores (lane labels)
          for (let l = 0; l < LANE_COUNT; l++) {
            const flash = (frame - lastFlash[l]) < 8;
            const cx = l * LANE_W + LANE_W / 2;
            ctx.fillStyle = flash ? LANE_COLORS[l] : "rgba(255,255,255,0.15)";
            ctx.fillRect(l * LANE_W + 5, H - 50, LANE_W - 10, 45);
            ctx.fillStyle = flash ? "#01002A" : LANE_COLORS[l];
            ctx.font = "bold 16px sans-serif";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(LANE_LABELS[l], cx, H - 28);
            ctx.fillStyle = flash ? "#01002A" : "#ffffff";
            ctx.font = "10px sans-serif";
            ctx.fillText(LANE_KEYS[l].replace("Key", ""), cx, H - 12);
          }
          // Notas
          for (const n of notes) {
            if (n.hit === true) continue;
            const cx = n.lane * LANE_W + LANE_W / 2;
            const color = n.hit === "miss" ? "rgba(218,41,28,0.4)" : LANE_COLORS[n.lane];
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(cx, n.y, NOTE_R, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 2;
            ctx.stroke();
          }
          // HUD top
          ctx.fillStyle = "#0057B8";
          ctx.font = "bold 24px sans-serif";
          ctx.textAlign = "left";
          ctx.textBaseline = "top";
          ctx.fillText("Score: " + score, 10, 8);
          ctx.fillStyle = timeLeft <= 10 ? "#DA291C" : "#D8FF2C";
          ctx.textAlign = "right";
          ctx.fillText(timeLeft + "s", W - 10, 8);
          if (combo > 2) {
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 22px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("COMBO x" + combo, W / 2, 10);
          }

          rafId = requestAnimationFrame(loop);
        }

        function startGame() {
          if (running) return;
          running = true;
          notes = [];
          score = 0;
          combo = 0;
          perfectCount = 0;
          goodCount = 0;
          missCount = 0;
          timeLeft = 60;
          frame = 0;
          overlay.style.display = "none";
          result.style.display = "none";
          window.addEventListener("keydown", onKey);
          timerInterval = setInterval(function () {
            timeLeft--;
            if (timeLeft <= 0) endGame();
          }, 1000);
          rafId = requestAnimationFrame(loop);
        }

        // Idle render
        function drawIdle() {
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, W, H);
          ctx.strokeStyle = "rgba(255,255,255,0.08)";
          for (let l = 1; l < LANE_COUNT; l++) {
            ctx.beginPath();
            ctx.moveTo(l * LANE_W, 0);
            ctx.lineTo(l * LANE_W, H);
            ctx.stroke();
          }
          ctx.strokeStyle = "#D8FF2C";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(0, HIT_Y);
          ctx.lineTo(W, HIT_Y);
          ctx.stroke();
          for (let l = 0; l < LANE_COUNT; l++) {
            const cx = l * LANE_W + LANE_W / 2;
            ctx.fillStyle = LANE_COLORS[l];
            ctx.font = "bold 16px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(LANE_LABELS[l], cx, H - 28);
          }
        }
        drawIdle();

        canvas.addEventListener("click", function (e) {
          if (!running) {
            startGame();
            return;
          }
          // Click na zona de uma lane = tap nessa lane
          const rect = canvas.getBoundingClientRect();
          const cx = ((e.clientX - rect.left) / rect.width) * W;
          const lane = Math.floor(cx / LANE_W);
          if (lane >= 0 && lane < LANE_COUNT) tryHit(lane);
        });
        canvas.addEventListener("touchstart", function (e) {
          if (!running) {
            e.preventDefault();
            startGame();
            return;
          }
          e.preventDefault();
          const t = e.touches[0];
          if (!t) return;
          const rect = canvas.getBoundingClientRect();
          const cx = ((t.clientX - rect.left) / rect.width) * W;
          const lane = Math.floor(cx / LANE_W);
          if (lane >= 0 && lane < LANE_COUNT) tryHit(lane);
        });
        if (restartBtn) restartBtn.addEventListener("click", function () {
          if (!running) startGame();
        });
      })();
    </script>
  </body>

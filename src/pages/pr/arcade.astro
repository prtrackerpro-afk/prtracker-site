---
export const prerender = false;
import "../../styles/global.css";
import BottomNav from "../../components/pr/BottomNav.astro";

const athlete = Astro.locals.athlete;
if (!athlete) return Astro.redirect("/pr/login");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Fliperama · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto">
      <a href="/pr/gym" class="text-sm text-navy-300 hover:text-white">← Voltar ao gym</a>
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mt-3">FLIPERAMA</div>
      <h1 class="font-display text-3xl tracking-tight text-white">Pega leve. É só diversão.</h1>
      <p class="text-sm text-navy-300">3 jogos fitness-themed. Score não conta XP no app.</p>
    </header>

    <main class="max-w-2xl mx-auto px-4 space-y-6">
      <section class="rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-4 shadow-lg shadow-brand-lime/5">
        <div class="mb-3">
          <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime">JOGO 1</div>
          <h2 class="font-display text-xl text-white">Barbell Bounce</h2>
          <p class="text-xs text-navy-300">Endless runner — pula barras, abaixa nas baixas.</p>
        </div>
        <div id="game-container" class="relative w-full" style="min-height: 280px;">
          <canvas
            id="bb-canvas"
            width="640"
            height="360"
            class="bg-navy-900 border-2 border-brand-lime/40 rounded-lg w-full block cursor-pointer"
            style="touch-action: none; image-rendering: pixelated;"
          ></canvas>
          <div id="bb-overlay" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none rounded-lg" style="background: rgba(0,0,0,0.5);">
            <div class="text-3xl sm:text-4xl font-display font-bold text-brand-lime mb-2">▶ TOQUE PRA JOGAR</div>
            <div class="text-xs text-white/80" id="bb-hi-display">Best: 0</div>
          </div>
        </div>
        <div class="text-xs text-navy-300 text-center mt-3 max-w-md mx-auto">
          <strong class="text-white">Como jogar:</strong> ESPAÇO ou ↑ pra pular ·
          ↓ pra abaixar · No celular: tap pula, swipe ↓ abaixa.
        </div>
        <div class="text-center mt-3" id="bb-result" style="display:none;">
          <div class="text-2xl font-display font-bold text-white" id="bb-final-score">Score: 0</div>
          <button id="bb-restart" type="button" class="mt-2 bg-brand-lime text-navy-900 font-display font-bold rounded-lg px-6 py-2.5 hover:opacity-90">
            ↻ JOGAR DE NOVO
          </button>
        </div>
      </section>

      <section class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4">
        <div class="text-[10px] uppercase tracking-[0.3em] text-navy-400">JOGO 2 — EM BREVE</div>
        <h2 class="font-display text-xl text-navy-300">Protein Shaker</h2>
        <p class="text-xs text-navy-400">Match-3 puzzle. Combine ingredientes pra montar shakes.</p>
      </section>

      <section class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4">
        <div class="text-[10px] uppercase tracking-[0.3em] text-navy-400">JOGO 3 — EM BREVE</div>
        <h2 class="font-display text-xl text-navy-300">WOD Sprint</h2>
        <p class="text-xs text-navy-400">Battle royale fitness 8 jogadores. Multiplayer real-time.</p>
      </section>
    </main>

    <BottomNav active="profile" />

    <script is:inline>
      // Vanilla JS Barbell Bounce — sem React, hidratacao garantida.
      (function () {
        const canvas = document.getElementById("bb-canvas");
        const overlay = document.getElementById("bb-overlay");
        const hiDisplay = document.getElementById("bb-hi-display");
        const result = document.getElementById("bb-result");
        const finalScoreEl = document.getElementById("bb-final-score");
        const restartBtn = document.getElementById("bb-restart");
        if (!canvas || !overlay) {
          console.error("[bb] canvas/overlay missing");
          return;
        }
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let hi = Number(localStorage.getItem("pr_bb_hi") || "0");
        if (hiDisplay) hiDisplay.textContent = "Best: " + hi;

        let running = false;
        let rafId = 0;

        function startGame() {
          if (running) return;
          running = true;
          overlay.style.display = "none";
          result.style.display = "none";

          const W = canvas.width;
          const H = canvas.height;
          const groundY = H - 60;

          const player = { x: 80, y: groundY, vy: 0, w: 38, h: 56 };
          const gravity = 0.85;
          const jumpV = -16;

          let obstacles = [];
          let frame = 0;
          let speed = 6;
          let scoreLocal = 0;
          let jumpHeld = false;
          let duckHeld = false;

          function spawn() {
            // 3 tipos: kettlebell (low jump), plate stack (medium jump), barbell rack (slide under)
            const r = Math.random();
            if (r < 0.4) {
              // Kettlebell — pequena no chao, precisa pular
              obstacles.push({ x: W + 20, y: groundY - 38, w: 36, h: 38, type: "kettlebell" });
            } else if (r < 0.75) {
              // Plate stack — anilhas empilhadas, precisa pular
              obstacles.push({ x: W + 20, y: groundY - 60, w: 32, h: 60, type: "plate" });
            } else {
              // Pull-up bar — alta, precisa abaixar
              obstacles.push({ x: W + 20, y: groundY - 130, w: 60, h: 14, type: "pullup" });
            }
          }

          function onKeyDown(e) {
            if (e.code === "Space" || e.code === "ArrowUp") {
              e.preventDefault();
              jumpHeld = true;
            }
            if (e.code === "ArrowDown") {
              e.preventDefault();
              duckHeld = true;
            }
          }
          function onKeyUp(e) {
            if (e.code === "Space" || e.code === "ArrowUp") jumpHeld = false;
            if (e.code === "ArrowDown") duckHeld = false;
          }
          window.addEventListener("keydown", onKeyDown);
          window.addEventListener("keyup", onKeyUp);

          let touchStartY = 0;
          function onPointerDown(e) {
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            touchStartY = e.clientY - rect.top;
            jumpHeld = true;
          }
          function onPointerMove(e) {
            if (!jumpHeld) return;
            const rect = canvas.getBoundingClientRect();
            const y = e.clientY - rect.top;
            if (y - touchStartY > 25) {
              duckHeld = true;
              jumpHeld = false;
            }
          }
          function onPointerUp() {
            jumpHeld = false;
            duckHeld = false;
          }
          canvas.addEventListener("pointerdown", onPointerDown);
          canvas.addEventListener("pointermove", onPointerMove);
          canvas.addEventListener("pointerup", onPointerUp);
          canvas.addEventListener("pointercancel", onPointerUp);

          function endGame() {
            running = false;
            cancelAnimationFrame(rafId);
            window.removeEventListener("keydown", onKeyDown);
            window.removeEventListener("keyup", onKeyUp);
            canvas.removeEventListener("pointerdown", onPointerDown);
            canvas.removeEventListener("pointermove", onPointerMove);
            canvas.removeEventListener("pointerup", onPointerUp);
            canvas.removeEventListener("pointercancel", onPointerUp);

            // Game over overlay no canvas
            ctx.fillStyle = "rgba(1,0,42,0.85)";
            ctx.fillRect(0, 0, W, H);
            ctx.fillStyle = "#DA291C";
            ctx.font = "bold 48px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("GAME OVER", W / 2, H / 2 - 10);
            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 28px sans-serif";
            ctx.fillText("Score: " + scoreLocal, W / 2, H / 2 + 30);

            if (scoreLocal > hi) {
              hi = scoreLocal;
              localStorage.setItem("pr_bb_hi", String(hi));
              if (hiDisplay) hiDisplay.textContent = "Best: " + hi;
            }
            if (scoreLocal > 50) {
              fetch("/api/pr/arcade/score", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ game_id: "barbell_bounce", score: scoreLocal }),
              }).catch(function () {});
            }

            finalScoreEl.textContent = "Score: " + scoreLocal + " · Best: " + hi;
            result.style.display = "block";
          }

          // === Athlete sprite (vanilla 2D drawing) ===
          function drawAthlete(ctx, px, py, ph, ducking, frame) {
            // Cabeça circular skin tone
            const skinColor = "#e0b18a";
            const headR = 8;
            const headX = px + 20;
            const headY = py + headR + 2;
            ctx.fillStyle = skinColor;
            ctx.beginPath();
            ctx.arc(headX, headY, headR, 0, Math.PI * 2);
            ctx.fill();
            // Cabelo (cap escuro)
            ctx.fillStyle = "#1a1410";
            ctx.beginPath();
            ctx.arc(headX, headY - 1, headR, Math.PI, 0);
            ctx.fill();
            // Olho
            ctx.fillStyle = "#01002A";
            ctx.fillRect(headX + 3, headY - 1, 2, 2);
            // Sorriso
            ctx.strokeStyle = "#01002A";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.arc(headX + 2, headY + 3, 2, 0, Math.PI);
            ctx.stroke();

            // Corpo (regata lime PR TRACKER)
            const torsoY = py + 14;
            const torsoH = ducking ? 10 : 22;
            ctx.fillStyle = "#D8FF2C";
            ctx.fillRect(px + 12, torsoY, 18, torsoH);
            // Logo PR no peito
            ctx.fillStyle = "#01002A";
            ctx.font = "bold 8px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("PR", px + 21, torsoY + 11);

            if (!ducking) {
              // Pernas (shorts navy + skin)
              const legBob = Math.sin(frame * 0.4) * 3;
              ctx.fillStyle = "#1e1b50";
              ctx.fillRect(px + 13, py + 36, 7, 8); // shorts esq
              ctx.fillRect(px + 22, py + 36, 7, 8); // shorts dir
              ctx.fillStyle = skinColor;
              ctx.fillRect(px + 14, py + 44 - legBob, 5, 8); // perna esq
              ctx.fillRect(px + 23, py + 44 + legBob, 5, 8); // perna dir
              ctx.fillStyle = "#0a0a14";
              ctx.fillRect(px + 13, py + 52 - legBob, 7, 4); // tenis esq
              ctx.fillRect(px + 22, py + 52 + legBob, 7, 4); // tenis dir
              // Sola lime
              ctx.fillStyle = "#D8FF2C";
              ctx.fillRect(px + 13, py + 55 - legBob, 7, 1);
              ctx.fillRect(px + 22, py + 55 + legBob, 7, 1);

              // Braço direito segurando barbell (mini)
              ctx.fillStyle = skinColor;
              ctx.fillRect(px + 30, py + 18, 4, 12);
              // Mini barbell na mao direita
              ctx.fillStyle = "#dfe2e8"; // chrome
              ctx.fillRect(px + 30, py + 14, 3, 3); // bar vertical
              // Plate vermelho topo
              ctx.fillStyle = "#DA291C";
              ctx.beginPath();
              ctx.arc(px + 31, py + 13, 4, 0, Math.PI * 2);
              ctx.fill();
              // Plate azul base
              ctx.fillStyle = "#0057B8";
              ctx.beginPath();
              ctx.arc(px + 31, py + 30, 4, 0, Math.PI * 2);
              ctx.fill();

              // Braço esquerdo
              ctx.fillStyle = skinColor;
              ctx.fillRect(px + 8, py + 18, 4, 14);
            } else {
              // Ducking: pernas dobradas + cabeça mais baixa
              ctx.fillStyle = "#1e1b50";
              ctx.fillRect(px + 13, py + 24, 16, 6);
              ctx.fillStyle = "#0a0a14";
              ctx.fillRect(px + 13, py + 28, 7, 2);
              ctx.fillRect(px + 22, py + 28, 7, 2);
            }
          }

          function drawObstacle(ctx, o) {
            if (o.type === "kettlebell") {
              // Kettlebell preta com handle metalico
              const cx = o.x + o.w / 2;
              const cy = o.y + 18;
              ctx.fillStyle = "#141420";
              ctx.beginPath();
              ctx.arc(cx, cy, 14, 0, Math.PI * 2);
              ctx.fill();
              // Handle metalico
              ctx.strokeStyle = "#dfe2e8";
              ctx.lineWidth = 4;
              ctx.beginPath();
              ctx.arc(cx, cy - 12, 7, Math.PI, 0);
              ctx.stroke();
              // Reflexo
              ctx.fillStyle = "rgba(255,255,255,0.15)";
              ctx.beginPath();
              ctx.arc(cx - 4, cy - 4, 4, 0, Math.PI * 2);
              ctx.fill();
              // Numero do peso
              ctx.fillStyle = "#D8FF2C";
              ctx.font = "bold 9px sans-serif";
              ctx.textAlign = "center";
              ctx.fillText("16", cx, cy + 3);
            } else if (o.type === "plate") {
              // Stack de plates IWF (vermelho-azul-amarelo)
              ctx.fillStyle = "#DA291C";
              ctx.fillRect(o.x, o.y, o.w, 16); // top plate
              ctx.fillStyle = "#0057B8";
              ctx.fillRect(o.x, o.y + 18, o.w, 16); // mid
              ctx.fillStyle = "#FFC72C";
              ctx.fillRect(o.x, o.y + 36, o.w, 16); // bottom
              // Hub central preto
              ctx.fillStyle = "#0a0a14";
              ctx.fillRect(o.x + o.w / 2 - 3, o.y, 6, o.h);
            } else if (o.type === "pullup") {
              // Pull-up bar — barra horizontal alta + 2 postes saindo
              ctx.fillStyle = "#dfe2e8";
              ctx.fillRect(o.x, o.y, o.w, 6); // bar chrome
              ctx.fillStyle = "#4a4d5a";
              ctx.fillRect(o.x, o.y + 6, 6, 8); // poste esq
              ctx.fillRect(o.x + o.w - 6, o.y + 6, 6, 8); // poste dir
              // Knurling lines
              ctx.strokeStyle = "#9aa3b0";
              ctx.lineWidth = 1;
              for (let i = 4; i < o.w - 4; i += 4) {
                ctx.beginPath();
                ctx.moveTo(o.x + i, o.y + 1);
                ctx.lineTo(o.x + i, o.y + 5);
                ctx.stroke();
              }
            }
          }

          function loop() {
            if (!running) return;
            frame++;

            if (jumpHeld && player.y >= groundY - 1) player.vy = jumpV;
            const ducking = duckHeld && player.y >= groundY - 1;
            player.vy += gravity;
            player.y += player.vy;
            if (player.y > groundY) {
              player.y = groundY;
              player.vy = 0;
            }

            const playerH = ducking ? 30 : player.h;
            const playerY = ducking ? groundY - 30 : player.y - player.h;

            if (frame % Math.max(50, 90 - Math.floor(scoreLocal / 100)) === 0) spawn();

            obstacles.forEach(function (o) {
              o.x -= speed;
            });
            obstacles = obstacles.filter(function (o) {
              return o.x + o.w > 0;
            });

            for (let i = 0; i < obstacles.length; i++) {
              const o = obstacles[i];
              if (
                player.x < o.x + o.w &&
                player.x + player.w > o.x &&
                playerY < o.y + o.h &&
                playerY + playerH > o.y
              ) {
                endGame();
                return;
              }
            }

            if (frame % 200 === 0 && speed < 14) speed += 0.5;
            scoreLocal = Math.floor(frame / 6);

            // Render
            ctx.fillStyle = "#01002A";
            ctx.fillRect(0, 0, W, H);

            ctx.strokeStyle = "rgba(216,255,44,0.1)";
            ctx.lineWidth = 1;
            for (let i = 0; i < 5; i++) {
              const x = (frame * speed * 0.3 + i * 100) % W;
              ctx.beginPath();
              ctx.moveTo(x, groundY);
              ctx.lineTo(x - 30, H);
              ctx.stroke();
            }

            ctx.fillStyle = "#0a0a14";
            ctx.fillRect(0, groundY, W, H - groundY);
            ctx.strokeStyle = "#D8FF2C";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, groundY);
            ctx.lineTo(W, groundY);
            ctx.stroke();

            // Player — atleta com barbell nas mãos (cycles 1-3 fitness visual)
            drawAthlete(ctx, player.x, playerY, playerH, ducking, frame);

            for (let i = 0; i < obstacles.length; i++) {
              const o = obstacles[i];
              drawObstacle(ctx, o);
            }

            ctx.fillStyle = "#D8FF2C";
            ctx.font = "bold 24px sans-serif";
            ctx.textAlign = "left";
            ctx.fillText("SCORE: " + scoreLocal, 16, 30);
            ctx.font = "14px sans-serif";
            ctx.fillStyle = "#9ca3af";
            ctx.fillText("HI: " + hi, 16, 50);

            rafId = requestAnimationFrame(loop);
          }
          rafId = requestAnimationFrame(loop);
        }

        // Tela inicial — desenha o "fundo" do jogo + atleta parado
        function drawIdle() {
          const W = canvas.width;
          const H = canvas.height;
          const groundY = H - 60;
          ctx.fillStyle = "#01002A";
          ctx.fillRect(0, 0, W, H);
          // Background gym silhuetas (rack, bench)
          ctx.fillStyle = "rgba(216,255,44,0.08)";
          // Power rack silhouette
          ctx.fillRect(W - 180, groundY - 90, 6, 90);
          ctx.fillRect(W - 100, groundY - 90, 6, 90);
          ctx.fillRect(W - 180, groundY - 90, 86, 4);
          // Bench silhouette
          ctx.fillRect(W - 350, groundY - 30, 100, 4);
          ctx.fillRect(W - 340, groundY - 30, 4, 30);
          ctx.fillRect(W - 260, groundY - 30, 4, 30);
          // Floor
          ctx.fillStyle = "#0a0a14";
          ctx.fillRect(0, groundY, W, 60);
          ctx.strokeStyle = "#D8FF2C";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(0, groundY);
          ctx.lineTo(W, groundY);
          ctx.stroke();
          // Player parado
          drawAthlete(ctx, 80, groundY - 56, 56, false, 0);

          function drawAthlete(ctx, px, py, ph, ducking, frame) {
            const skinColor = "#e0b18a";
            const headR = 8;
            const headX = px + 20;
            const headY = py + headR + 2;
            ctx.fillStyle = skinColor;
            ctx.beginPath();
            ctx.arc(headX, headY, headR, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = "#1a1410";
            ctx.beginPath();
            ctx.arc(headX, headY - 1, headR, Math.PI, 0);
            ctx.fill();
            ctx.fillStyle = "#01002A";
            ctx.fillRect(headX + 3, headY - 1, 2, 2);
            ctx.strokeStyle = "#01002A";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.arc(headX + 2, headY + 3, 2, 0, Math.PI);
            ctx.stroke();
            ctx.fillStyle = "#D8FF2C";
            ctx.fillRect(px + 12, py + 14, 18, 22);
            ctx.fillStyle = "#01002A";
            ctx.font = "bold 8px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("PR", px + 21, py + 25);
            ctx.fillStyle = "#1e1b50";
            ctx.fillRect(px + 13, py + 36, 7, 8);
            ctx.fillRect(px + 22, py + 36, 7, 8);
            ctx.fillStyle = skinColor;
            ctx.fillRect(px + 14, py + 44, 5, 8);
            ctx.fillRect(px + 23, py + 44, 5, 8);
            ctx.fillStyle = "#0a0a14";
            ctx.fillRect(px + 13, py + 52, 7, 4);
            ctx.fillRect(px + 22, py + 52, 7, 4);
            ctx.fillStyle = "#D8FF2C";
            ctx.fillRect(px + 13, py + 55, 7, 1);
            ctx.fillRect(px + 22, py + 55, 7, 1);
            // Bracos parado
            ctx.fillStyle = skinColor;
            ctx.fillRect(px + 8, py + 18, 4, 14);
            ctx.fillRect(px + 30, py + 18, 4, 14);
          }
        }
        drawIdle();

        // Click/keyboard pra iniciar
        canvas.addEventListener("click", function () {
          if (!running) startGame();
        });
        // Touch separadamente pra mobile
        canvas.addEventListener("touchstart", function (e) {
          if (!running) {
            e.preventDefault();
            startGame();
          }
        });
        window.addEventListener("keydown", function (e) {
          if (!running && e.code === "Space") {
            e.preventDefault();
            startGame();
          }
        });
        if (restartBtn) restartBtn.addEventListener("click", function () {
          if (!running) startGame();
        });
      })();
    </script>
  </body>
</html>

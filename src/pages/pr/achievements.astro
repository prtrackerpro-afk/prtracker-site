---
export const prerender = false;
import "../../styles/global.css";
import BottomNav from "../../components/pr/BottomNav.astro";
import { getServerSupabase } from "../../lib/supabase/server";

const athlete = Astro.locals.athlete;
if (!athlete) return Astro.redirect("/pr/login");

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

const { data: allAchievements = [] } = await supabase
  .from("pr_achievements")
  .select("id, name, description, icon, xp_reward")
  .order("xp_reward", { ascending: true });

const { data: unlockedRaw = [] } = await supabase
  .from("pr_athlete_achievements")
  .select("achievement_id, unlocked_at")
  .eq("user_id", athlete.userId);

type Ach = { id: string; name: string; description: string; icon: string; xp_reward: number };
const unlockedSet = new Set((unlockedRaw ?? []).map((u: { achievement_id: string }) => u.achievement_id));
const achievements = (allAchievements ?? []) as Ach[];
const unlockedCount = unlockedSet.size;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Conquistas · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto">
      <a href="/pr" class="text-sm text-navy-300 hover:text-white">← Voltar</a>
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mt-3">CONQUISTAS</div>
      <h1 class="font-display text-3xl tracking-tight text-white">Achievements</h1>
      <p class="text-sm text-navy-300">{unlockedCount}/{achievements.length} desbloqueadas</p>
    </header>

    <main class="max-w-2xl mx-auto px-4 grid grid-cols-2 sm:grid-cols-3 gap-3">
      {achievements.map((a) => {
        const unlocked = unlockedSet.has(a.id);
        return (
          <div class={`rounded-2xl border p-4 text-center ${unlocked ? "border-brand-lime/40 bg-brand-lime/5" : "border-navy-700 bg-navy-800/30 opacity-50"}`}>
            <div class="text-4xl mb-2">{unlocked ? a.icon : "🔒"}</div>
            <div class="text-sm font-display font-semibold mb-1">{a.name}</div>
            <div class="text-xs text-navy-300 mb-2">{a.description}</div>
            <div class="text-[10px] text-brand-lime uppercase tracking-wider">+{a.xp_reward} XP</div>
          </div>
        );
      })}
    </main>

    <BottomNav active="profile" />
  </body>
</html>

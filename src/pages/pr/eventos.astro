---
export const prerender = false;
import "../../styles/global.css";
import BottomNav from "../../components/pr/BottomNav.astro";
import { getServerSupabase } from "../../lib/supabase/server";

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});

const { data: events = [] } = await supabase
  .from("pr_events")
  .select("id, slug, name, description, modality, starts_at, city, state, status, fee_cents")
  .in("status", ["open", "closed"])
  .order("starts_at", { ascending: true })
  .limit(20);

type EventRow = {
  id: string;
  slug: string;
  name: string;
  description: string | null;
  modality: string | null;
  starts_at: string;
  city: string | null;
  state: string | null;
  status: string;
  fee_cents: number;
};
const list = (events ?? []) as EventRow[];

function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString("pt-BR", { day: "numeric", month: "short" });
}
function fmtFee(cents: number) {
  if (cents === 0) return "Grátis";
  return `R$ ${(cents / 100).toFixed(2).replace(".", ",")}`;
}
function isFree(cents: number) {
  return cents === 0;
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Eventos · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 max-w-2xl mx-auto">
      <a href="/pr" class="text-sm text-navy-300 hover:text-white">← Voltar</a>
      <div class="text-[10px] uppercase tracking-[0.3em] text-brand-lime mt-3">EVENTOS</div>
      <h1 class="font-display text-3xl tracking-tight text-white">Competições</h1>
      <p class="text-sm text-navy-300">Friendly fights, throwdowns e campeonatos parceiros.</p>
    </header>

    <main class="max-w-2xl mx-auto px-4">
      {list.length === 0 ? (
        <div class="rounded-2xl border-2 border-brand-lime/40 bg-brand-lime/5 p-6 text-center">
          <div class="text-3xl mb-2">🏆</div>
          <p class="text-sm text-white font-display mb-1">Nenhum evento ativo no momento.</p>
          <p class="text-xs text-navy-300">Em breve: organize teu próprio evento direto pelo app.</p>
        </div>
      ) : (
        <ul class="space-y-3">
          {list.map((e) => (
            <li class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4 hover:border-brand-lime/40 transition">
              <div class="flex items-start justify-between mb-2">
                <div>
                  <div class="text-[10px] uppercase tracking-wider text-brand-lime mb-0.5">
                    {e.modality?.toUpperCase() ?? "GERAL"}
                  </div>
                  <h2 class="font-display text-lg leading-tight">{e.name}</h2>
                </div>
                <div class="text-right">
                  <div class="text-sm font-display font-bold tabular-nums">{fmtDate(e.starts_at)}</div>
                  {isFree(e.fee_cents) ? (
                    <span class="inline-block text-[10px] uppercase tracking-wider rounded-full bg-brand-lime/15 text-brand-lime px-2 py-0.5 mt-0.5">Grátis</span>
                  ) : (
                    <div class="text-[10px] text-navy-400">{fmtFee(e.fee_cents)}</div>
                  )}
                </div>
              </div>
              {e.description && <p class="text-xs text-navy-300 mb-2">{e.description}</p>}
              <div class="flex items-center justify-between text-xs">
                <span class="text-navy-400">{e.city}{e.state ? `/${e.state}` : ""}</span>
                <a href={`/pr/eventos/${e.slug}`} class="text-brand-lime hover:underline">Ver detalhes →</a>
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>

    <BottomNav active="profile" />
  </body>
</html>

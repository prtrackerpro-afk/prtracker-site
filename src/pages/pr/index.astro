---
export const prerender = false;
import "../../styles/global.css";
import { getServerSupabase } from "../../lib/supabase/server";
import { listOwnRecords } from "../../lib/pr/db";
import { exerciseLabel } from "../../lib/pr/exercises";

const athlete = Astro.locals.athlete!; // gated by middleware

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});
const records = await listOwnRecords(supabase, athlete.userId, 50);

// Recent PRs (where is_personal_record = true) at the top
const personalRecords = records.filter((r) => r.is_personal_record);

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("pt-BR", { day: "2-digit", month: "short" });
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Meus PRs · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 flex items-center justify-between max-w-2xl mx-auto">
      <div>
        <div class="font-display text-xl tracking-tight text-brand-lime">PR Tracker</div>
        <div class="text-xs uppercase tracking-widest text-navy-300">
          {athlete.displayName ?? athlete.email}
        </div>
      </div>
      <form method="post" action="/api/pr/auth/logout">
        <button class="text-xs text-navy-300 hover:text-white">Sair</button>
      </form>
    </header>

    <main class="max-w-2xl mx-auto px-4">
      {!athlete.displayName && (
        <div class="rounded-xl border border-amber-400/30 bg-amber-400/5 px-4 py-3 mb-4 text-sm">
          Bem-vindo. Defina seu nome de exibição em <em>Perfil</em> antes de entrar em rankings de box.
          {/* TODO: profile editor screen */}
        </div>
      )}

      <section class="mb-6">
        <h1 class="text-2xl font-semibold tracking-tight">Meus PRs</h1>
        <p class="text-sm text-navy-300 mt-0.5">
          {records.length === 0
            ? "Você ainda não registrou nenhum PR."
            : `${personalRecords.length} recorde${personalRecords.length === 1 ? "" : "s"} pessoal${personalRecords.length === 1 ? "" : "is"}`}
        </p>
      </section>

      {records.length === 0 ? (
        <div class="rounded-2xl border border-navy-700 bg-navy-800/30 p-8 text-center">
          <p class="text-navy-300 mb-4">Comece registrando seu primeiro PR.</p>
          <a
            href="/pr/log"
            class="inline-block rounded-lg bg-brand-lime px-5 py-2.5 text-sm font-semibold text-navy-900 hover:opacity-90 transition"
          >
            Registrar PR
          </a>
        </div>
      ) : (
        <ul class="space-y-2">
          {records.map((r) => (
            <li class="rounded-xl border border-navy-700 bg-navy-800/30 p-4 flex items-center justify-between">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-semibold">{exerciseLabel(r.exercise as any)}</span>
                  {r.is_personal_record && (
                    <span class="text-[10px] uppercase tracking-wider rounded bg-brand-lime/15 text-brand-lime px-1.5 py-0.5">
                      PR
                    </span>
                  )}
                </div>
                <div class="text-xs text-navy-300">{fmtDate(r.performed_at)}</div>
              </div>
              <div class="text-right">
                <div class="font-display text-2xl tabular-nums">{r.weight_kg}</div>
                <div class="text-[10px] uppercase tracking-wider text-navy-300">kg</div>
              </div>
            </li>
          ))}
        </ul>
      )}

      {/* TODO: progression chart per exercise (Recharts island, like admin/TrendChart) */}
    </main>

    {/* Sticky add button */}
    <a
      href="/pr/log"
      class="fixed bottom-6 right-6 rounded-full bg-brand-lime text-navy-900 font-semibold w-14 h-14 grid place-items-center shadow-lg shadow-brand-lime/20 hover:scale-105 transition"
      aria-label="Registrar novo PR"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
    </a>
  </body>
</html>

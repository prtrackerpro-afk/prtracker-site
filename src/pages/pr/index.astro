---
export const prerender = false;
import "../../styles/global.css";
import { getServerSupabase } from "../../lib/supabase/server";
import { listOwnRecords, listBestLifts } from "../../lib/pr/db";
import { exerciseLabel, type ExerciseId } from "../../lib/pr/exercises";
import { summarize, tierLabel, tierColor } from "../../lib/pr/strength-score";
import PRProgressionChart from "../../components/pr/PRProgressionChart";

const athlete = Astro.locals.athlete!; // gated by middleware

const supabase = getServerSupabase({
  headers: Astro.request.headers,
  cookies: Astro.cookies,
});
const records = await listOwnRecords(supabase, athlete.userId, 100);

// Strength summary drives the tier pill in the header.
const bestLiftsRaw = await listBestLifts(supabase, athlete.userId);
const summary = summarize({
  bodyWeightKg: athlete.bodyWeightKg,
  sex: athlete.sex,
  bestLifts: bestLiftsRaw as Partial<Record<ExerciseId, number>>,
});

// Stats summary
const personalRecords = records.filter((r) => r.is_personal_record);
const totalPRs = personalRecords.length;

const lastRecord = records[0];
const daysSinceLast = lastRecord
  ? Math.floor(
      (Date.now() - new Date(lastRecord.performed_at + "T00:00:00").getTime()) / (1000 * 60 * 60 * 24)
    )
  : null;

// Top lift across all exercises (heaviest single weight)
const topLift = records.reduce<typeof records[number] | null>(
  (acc, r) => (acc === null || Number(r.weight_kg) > Number(acc.weight_kg) ? r : acc),
  null
);

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("pt-BR", { day: "2-digit", month: "short" });

// Chart data — pass labels along so the React island doesn't need the exercise map
const chartRecords = records.map((r) => ({
  exercise: r.exercise,
  exerciseLabel: exerciseLabel(r.exercise as ExerciseId),
  weight_kg: Number(r.weight_kg),
  performed_at: r.performed_at,
  is_personal_record: r.is_personal_record,
}));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Meus PRs · PR Tracker</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="manifest" href="/pr/manifest.webmanifest" />
    <meta name="theme-color" content="#01002A" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PR Tracker" />
  </head>
  <body class="min-h-screen bg-navy-900 text-white font-body pb-24">
    <header class="px-4 pt-6 pb-4 flex items-center justify-between max-w-2xl mx-auto">
      <a href="/pr/profile" class="flex items-center gap-3 min-w-0 hover:opacity-90 transition">
        <div class="min-w-0">
          <div class="font-display text-xl tracking-tight text-brand-lime">PR Tracker</div>
          <div class="text-xs uppercase tracking-widest text-navy-300 truncate">
            {athlete.displayName}
          </div>
        </div>
        {summary.hasBodyData && (
          <span
            class="inline-flex items-center text-[10px] uppercase tracking-widest font-display rounded-full px-2.5 py-1 border whitespace-nowrap"
            style={`color: ${tierColor(summary.overallTier)}; border-color: ${tierColor(summary.overallTier)}`}
          >
            {tierLabel(summary.overallTier)}
          </span>
        )}
      </a>
      <div class="flex items-center gap-3 flex-shrink-0">
        <a href="/pr/coach" class="text-xs text-navy-300 hover:text-white">Coach</a>
        <form method="post" action="/api/pr/auth/logout">
          <button class="text-xs text-navy-300 hover:text-white">Sair</button>
        </form>
      </div>
    </header>

    <main class="max-w-2xl mx-auto px-4">
      {/* Stats grid — only meaningful once you have at least 1 PR */}
      {records.length > 0 && (
        <section class="grid grid-cols-3 gap-2 mb-6">
          <div class="rounded-xl border border-navy-700 bg-navy-800/30 p-3">
            <div class="text-[10px] uppercase tracking-widest text-navy-300">PRs</div>
            <div class="font-display text-2xl tabular-nums">{totalPRs}</div>
          </div>
          <div class="rounded-xl border border-navy-700 bg-navy-800/30 p-3">
            <div class="text-[10px] uppercase tracking-widest text-navy-300">Última</div>
            <div class="font-display text-2xl tabular-nums">
              {daysSinceLast === 0 ? "hoje" : daysSinceLast === 1 ? "1d" : `${daysSinceLast}d`}
            </div>
          </div>
          <div class="rounded-xl border border-navy-700 bg-navy-800/30 p-3">
            <div class="text-[10px] uppercase tracking-widest text-navy-300">Maior</div>
            <div class="font-display text-2xl tabular-nums text-brand-lime">
              {topLift ? Number(topLift.weight_kg).toString() : "—"}
              <span class="text-xs text-navy-300 font-body">kg</span>
            </div>
          </div>
        </section>
      )}

      {/* Progression chart */}
      {records.length >= 2 && (
        <section class="rounded-2xl border border-navy-700 bg-navy-800/30 p-4 mb-6">
          <PRProgressionChart client:only="react" records={chartRecords} />
        </section>
      )}

      <section class="mb-3 flex items-baseline justify-between">
        <h1 class="text-xl font-semibold tracking-tight">Histórico</h1>
        {records.length > 0 && (
          <span class="text-xs text-navy-300">{records.length} registro{records.length === 1 ? "" : "s"}</span>
        )}
      </section>

      {records.length === 0 ? (
        <div class="rounded-2xl border border-navy-700 bg-navy-800/30 p-8 text-center">
          <p class="text-navy-300 mb-4">Comece registrando seu primeiro PR.</p>
          <a
            href="/pr/log"
            class="inline-block rounded-lg bg-brand-lime px-5 py-2.5 text-sm font-semibold text-navy-900 hover:opacity-90 transition"
          >
            Registrar PR
          </a>
        </div>
      ) : (
        <ul class="space-y-2">
          {records.map((r) => (
            <li class="rounded-xl border border-navy-700 bg-navy-800/30 p-4 flex items-center justify-between">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-semibold">{exerciseLabel(r.exercise as ExerciseId)}</span>
                  {r.is_personal_record && (
                    <span class="text-[10px] uppercase tracking-wider rounded bg-brand-lime/15 text-brand-lime px-1.5 py-0.5">
                      PR
                    </span>
                  )}
                </div>
                <div class="text-xs text-navy-300">{fmtDate(r.performed_at)}</div>
              </div>
              <div class="text-right">
                <div class="font-display text-2xl tabular-nums">{r.weight_kg}</div>
                <div class="text-[10px] uppercase tracking-wider text-navy-300">kg</div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>

    {/* Sticky add button */}
    <a
      href="/pr/log"
      class="fixed bottom-6 right-6 rounded-full bg-brand-lime text-navy-900 font-semibold w-14 h-14 grid place-items-center shadow-lg shadow-brand-lime/20 hover:scale-105 transition"
      aria-label="Registrar novo PR"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
    </a>
  </body>
</html>

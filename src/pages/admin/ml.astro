---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getConnectionStatus } from "../../lib/ml/oauth";

const url = new URL(Astro.request.url);
const flash = {
  ml: url.searchParams.get("ml"),
  msg: url.searchParams.get("msg"),
};

const status = await getConnectionStatus().catch(() => ({
  connected: false as const,
}));

function fmtDate(iso: string | null | undefined) {
  if (!iso) return "—";
  return new Date(iso).toLocaleString("pt-BR", {
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}
---

<AdminLayout title="Mercado Livre" active="ml" user={Astro.locals.admin}>
  <div class="px-4 md:px-8 py-6 max-w-7xl mx-auto space-y-6">
    <header class="flex items-baseline justify-between">
      <div>
        <h1 class="text-2xl font-display tracking-tight">Mercado Livre</h1>
        <p class="text-sm text-navy-300 mt-1">
          Sincronização de SKUs e produtos com Bling. Audit + correção em massa.
        </p>
      </div>
    </header>

    {flash.ml === "connected" && (
      <div class="rounded-lg border border-green-500/40 bg-green-500/10 px-4 py-3 text-sm text-green-200">
        ✅ Mercado Livre conectado. Audit e correções via API agora disponíveis.
      </div>
    )}
    {flash.ml === "denied" && (
      <div class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
        ⚠️ Autorização negada. {flash.msg && <><br/><code class="text-xs">{flash.msg}</code></>}
      </div>
    )}
    {flash.ml === "config_missing" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ Configuração incompleta — ML_CLIENT_ID/CLIENT_SECRET/REDIRECT_URI no Vercel.
        {flash.msg && <><br/><code class="text-xs">{flash.msg}</code></>}
      </div>
    )}
    {flash.ml === "token_failed" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ Falha ao trocar código por token.
        {flash.msg && <><br/><code class="text-xs">{flash.msg}</code></>}
      </div>
    )}
    {flash.ml === "state_mismatch" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ State CSRF inválido — tente conectar de novo.
      </div>
    )}
    {flash.ml === "missing_params" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ Mercado Livre não retornou code/state — tente de novo.
      </div>
    )}

    <section class="rounded-xl border border-navy-700 bg-navy-800/40 p-5">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <div class="text-xs uppercase tracking-[0.18em] text-navy-300">Status da conexão</div>
          <div class="mt-2 flex items-center gap-2 flex-wrap">
            {status.connected ? (
              <>
                <span class="inline-flex items-center rounded-full bg-green-500/20 text-green-300 px-2.5 py-1 text-xs font-medium">
                  ● Conectado
                </span>
                {status.nickname && (
                  <span class="text-sm text-navy-200">@{status.nickname}</span>
                )}
                {status.sellerId && (
                  <code class="text-xs text-navy-400">id {status.sellerId}</code>
                )}
              </>
            ) : (
              <span class="inline-flex items-center rounded-full bg-navy-700 text-navy-200 px-2.5 py-1 text-xs">
                ● Desconectado
              </span>
            )}
          </div>
          {status.connected && (
            <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-navy-300">
              <div>Access expira: <span class="text-navy-100">{fmtDate(status.accessExpiresAt)}</span></div>
              <div>Refresh expira: <span class="text-navy-100">{fmtDate(status.refreshExpiresAt)}</span></div>
            </div>
          )}
        </div>
        <a
          href="/api/admin/ml/connect"
          class="inline-flex items-center gap-2 rounded-lg bg-brand-lime text-navy-900 px-4 py-2 text-sm font-semibold hover:bg-brand-lime/90 transition"
        >
          {status.connected ? "Reconectar" : "Conectar Mercado Livre"}
        </a>
      </div>
    </section>

    <section class="rounded-xl border border-navy-700 bg-navy-800/40 p-5">
      <div class="text-xs uppercase tracking-[0.18em] text-navy-300">Auditoria de SKUs</div>
      <p class="text-sm text-navy-200 mt-2 mb-3">
        Lista todos items ativos do seller, classifica `seller_custom_field` como canonical/non-canonical/no-sku/duplicate. Sincronizar com Bling.
      </p>
      <div class="flex items-center gap-3">
        <button
          id="audit-btn"
          disabled={!status.connected}
          class="inline-flex items-center gap-2 rounded-lg bg-navy-700 text-white px-4 py-2 text-sm font-medium hover:bg-navy-600 transition disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Auditar items
        </button>
        {!status.connected && (
          <span class="text-xs text-navy-400">Conecte ML primeiro.</span>
        )}
      </div>
      <pre id="audit-output" class="mt-4 overflow-auto rounded-md bg-navy-950/40 p-3 text-[11px] text-navy-200 max-h-[480px] hidden"></pre>
    </section>

    <section class="rounded-xl border border-navy-700/50 bg-navy-800/20 p-5 text-sm text-navy-300">
      <div class="text-xs uppercase tracking-[0.18em] text-navy-300 mb-2">Setup pendente</div>
      <ul class="list-disc list-inside space-y-1.5">
        <li>Felipe: criar conta Mercado Livre PJ (CNPJ 59.947.215/0001-67)</li>
        <li>Felipe: criar app developer em <code class="text-xs">developers.mercadolivre.com.br/devcenter</code></li>
        <li>Felipe: adicionar env vars Vercel: <code class="text-xs">ML_CLIENT_ID</code>, <code class="text-xs">ML_CLIENT_SECRET</code></li>
        <li>Felipe: aplicar migração <code class="text-xs">0007_ml_oauth.sql</code> no Supabase</li>
        <li>Felipe: clicar "Conectar Mercado Livre" acima e autorizar app</li>
        <li>Detalhes em <code class="text-xs">docs/ML_SETUP.md</code></li>
      </ul>
    </section>
  </div>

  <script>
    const btn = document.getElementById("audit-btn");
    const out = document.getElementById("audit-output");
    if (btn && out) {
      btn.addEventListener("click", async () => {
        out.textContent = "Carregando...";
        out.classList.remove("hidden");
        try {
          const r = await fetch("/api/admin/ml/audit-products", { credentials: "include" });
          const j = await r.json();
          out.textContent = JSON.stringify(j, null, 2);
        } catch (e) {
          out.textContent = `Erro: ${(e as Error).message}`;
        }
      });
    }
  </script>
</AdminLayout>

---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminSupabase } from "../../lib/supabase/server";
import { getConnectionStatus, type ConnectionStatus } from "../../lib/bling/oauth";

const url = new URL(Astro.request.url);
const flash = {
  bling: url.searchParams.get("bling"),
  msg: url.searchParams.get("msg"),
};

const status: ConnectionStatus = await getConnectionStatus().catch(
  () => ({ connected: false, expires_at: null, scope: null }),
);
const sb = getAdminSupabase();

const { data: orders = [] } = await sb
  .from("bling_orders")
  .select(
    "id, mp_payment_id, external_reference, bling_pedido_id, bling_pedido_numero, status, error, attempt_count, created_at, synced_at, bling_nfe_id, bling_nfe_numero, bling_nfe_chave_acesso, nfe_status, nfe_error, nfe_emitted_at"
  )
  .order("created_at", { ascending: false })
  .limit(50);

const counts = (orders ?? []).reduce(
  (acc: Record<string, number>, r: any) => {
    acc[r.status] = (acc[r.status] ?? 0) + 1;
    return acc;
  },
  { synced: 0, failed: 0, pending: 0, skipped: 0 },
);

const nfeCounts = (orders ?? []).reduce(
  (acc: Record<string, number>, r: any) => {
    if (r.nfe_status) acc[r.nfe_status] = (acc[r.nfe_status] ?? 0) + 1;
    return acc;
  },
  { emitted: 0, failed: 0, pending: 0, skipped: 0 },
);

function fmtDate(iso: string | null) {
  if (!iso) return "—";
  return new Date(iso).toLocaleString("pt-BR", {
    day: "2-digit", month: "2-digit", year: "2-digit",
    hour: "2-digit", minute: "2-digit",
  });
}

// Multi-line / long Bling error texts get a collapsible <details>; short
// single-line errors render inline so the table stays compact.
function splitError(raw: string | null | undefined): { headline: string; rest: string[] | null } {
  if (!raw) return { headline: "—", rest: null };
  const lines = raw.split("\n").map((l) => l.trim()).filter(Boolean);
  if (lines.length === 0) return { headline: "—", rest: null };
  return { headline: lines[0], rest: lines.length > 1 ? lines.slice(1) : null };
}
---

<AdminLayout title="Bling" active="bling" user={Astro.locals.admin}>
  <div class="px-4 md:px-8 py-6 max-w-7xl mx-auto space-y-6">
    <header class="flex items-baseline justify-between">
      <div>
        <h1 class="text-2xl font-display tracking-tight">Bling ERP</h1>
        <p class="text-sm text-navy-300 mt-1">
          Sincronização automática de pedidos do site → Bling → NF-e.
        </p>
      </div>
    </header>

    {flash.bling === "connected" && (
      <div class="rounded-lg border border-green-500/40 bg-green-500/10 px-4 py-3 text-sm text-green-200">
        ✅ Bling conectado com sucesso. Próximas vendas vão ser sincronizadas automaticamente.
      </div>
    )}
    {flash.bling === "denied" && (
      <div class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
        ⚠️ Autorização negada. {flash.msg && <><br/><code class="text-xs">{flash.msg}</code></>}
      </div>
    )}
    {flash.bling === "config_missing" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ Configuração incompleta. {flash.msg && <><br/><code class="text-xs">{flash.msg}</code></>}
      </div>
    )}
    {flash.bling === "token_failed" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ Falha ao trocar código por token. {flash.msg && <><br/><code class="text-xs">{flash.msg}</code></>}
      </div>
    )}
    {flash.bling === "state_mismatch" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ State CSRF inválido — tente conectar de novo.
      </div>
    )}
    {flash.bling === "missing_params" && (
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        ❌ Bling não retornou code/state — tente de novo.
      </div>
    )}

    <section class="rounded-xl border border-navy-700 bg-navy-800/40 p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-xs uppercase tracking-[0.18em] text-navy-300">Status da conexão</div>
          <div class="mt-2 flex items-center gap-2">
            {status.connected ? (
              <>
                <span class="inline-flex items-center rounded-full bg-green-500/20 text-green-300 px-2.5 py-1 text-xs font-medium">
                  ● Conectado
                </span>
                {status.expires_at && (
                  <span class="text-xs text-navy-300">
                    Token válido até {fmtDate(status.expires_at)}
                  </span>
                )}
              </>
            ) : (
              <span class="inline-flex items-center rounded-full bg-red-500/20 text-red-300 px-2.5 py-1 text-xs font-medium">
                ● Desconectado
              </span>
            )}
          </div>
          {status.scope && (
            <div class="mt-1 text-[11px] text-navy-300/80">Escopos: {status.scope}</div>
          )}
        </div>
        <a
          href="/api/admin/bling/connect"
          class="inline-flex items-center rounded-lg bg-brand-lime text-navy-900 hover:bg-brand-lime/90 px-4 py-2 text-sm font-medium transition"
        >
          {status.connected ? "Reconectar" : "Conectar Bling"}
        </a>
      </div>
      {!status.connected && (
        <p class="mt-3 text-xs text-navy-300">
          Antes de conectar, cadastre o app em <a class="underline" href="https://www.bling.com.br/b/integradores" target="_blank" rel="noreferrer">bling.com.br/b/integradores</a> e configure as variáveis BLING_CLIENT_ID, BLING_CLIENT_SECRET e BLING_REDIRECT_URI no Vercel.
        </p>
      )}
    </section>

    {status.connected && (
      <section class="rounded-xl border border-navy-700 bg-navy-800/40 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="text-xs uppercase tracking-[0.18em] text-navy-300">Configuração fiscal — naturezas de operação</div>
            <p class="mt-1 text-sm text-navy-200">
              Lista direto do teu Bling. Copia o ID da natureza certa
              (ex: "Venda de mercadoria a não contribuinte") e cola em
              <code class="text-brand-lime">BLING_NATUREZA_OPERACAO_ID</code> nas
              env vars do Vercel pra ativar a auto-emissão de NF-e.
            </p>
          </div>
          <button
            id="load-naturezas"
            type="button"
            class="inline-flex items-center rounded-lg bg-brand-lime text-navy-900 hover:bg-brand-lime/90 px-4 py-2 text-sm font-medium transition disabled:opacity-50"
          >
            Carregar lista
          </button>
        </div>
        <div id="naturezas-result" class="mt-4 text-sm text-navy-300">
          <span class="text-navy-400">Clica em "Carregar lista" pra puxar do Bling.</span>
        </div>
      </section>
    )}

    {status.connected && (
      <section class="rounded-xl border border-navy-700 bg-navy-800/40 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="text-xs uppercase tracking-[0.18em] text-navy-300">Auditoria de produtos</div>
            <p class="mt-1 text-sm text-navy-200">
              Lista todos os produtos cadastrados no Bling, classifica
              (canônico do site / legado de marketplace / sem código) e
              mostra quem está sem imagem. Clica "Anexar imagem" pra subir
              automaticamente a hero do site via API (URL externa,
              <code class="text-brand-lime">midia.imagens.externas</code>).
            </p>
          </div>
          <button
            id="audit-products-btn"
            type="button"
            class="inline-flex items-center rounded-lg bg-brand-lime text-navy-900 hover:bg-brand-lime/90 px-4 py-2 text-sm font-medium transition disabled:opacity-50"
          >
            Auditar produtos
          </button>
        </div>
        <div id="audit-products-result" class="mt-4 text-sm text-navy-300">
          <span class="text-navy-400">Clica em "Auditar produtos" pra varrer o catálogo Bling.</span>
        </div>
      </section>
    )}

    {status.connected && (
      <section class="rounded-xl border border-navy-700 bg-navy-800/40 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="text-xs uppercase tracking-[0.18em] text-navy-300">Sincronização de preços</div>
            <p class="mt-1 text-sm text-navy-200">
              Compara o preço-base canônico do site
              (<code class="text-brand-lime">src/content/products/*.json</code> +
              <code class="text-brand-lime">catalog.PLATES</code>) com o preço cadastrado em
              cada produto Bling. Reajustes no site NÃO se propagam ao Bling
              automaticamente — use este botão sempre que mudar a tabela de preços.
            </p>
          </div>
          <div class="flex flex-col gap-2 items-end">
            <button
              id="audit-prices-btn"
              type="button"
              class="inline-flex items-center rounded-lg border border-brand-lime text-brand-lime hover:bg-brand-lime/10 px-4 py-2 text-sm font-medium transition disabled:opacity-50"
            >
              Auditar preços
            </button>
            <button
              id="sync-prices-btn"
              type="button"
              class="inline-flex items-center rounded-lg bg-brand-lime text-navy-900 hover:bg-brand-lime/90 px-4 py-2 text-sm font-medium transition disabled:opacity-50 hidden"
            >
              Aplicar no Bling
            </button>
          </div>
        </div>
        <div id="audit-prices-result" class="mt-4 text-sm text-navy-300">
          <span class="text-navy-400">Clica em "Auditar preços" pra ver divergências antes de aplicar.</span>
        </div>
      </section>
    )}

    <section class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">Sincronizados</div>
        <div class="mt-1 text-2xl font-display text-green-300">{counts.synced}</div>
      </div>
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">Falhas</div>
        <div class="mt-1 text-2xl font-display text-red-300">{counts.failed}</div>
      </div>
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">Aguardando</div>
        <div class="mt-1 text-2xl font-display text-amber-300">{counts.pending}</div>
      </div>
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">Pulados (dup)</div>
        <div class="mt-1 text-2xl font-display text-navy-300">{counts.skipped}</div>
      </div>
    </section>

    <section class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">NF-e emitidas</div>
        <div class="mt-1 text-2xl font-display text-green-300">{nfeCounts.emitted}</div>
      </div>
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">NF-e falhas</div>
        <div class="mt-1 text-2xl font-display text-red-300">{nfeCounts.failed}</div>
      </div>
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">NF-e em processo</div>
        <div class="mt-1 text-2xl font-display text-amber-300">{nfeCounts.pending}</div>
      </div>
      <div class="rounded-lg border border-navy-700 bg-navy-800/40 p-4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-navy-300">NF-e puladas</div>
        <div class="mt-1 text-2xl font-display text-navy-300">{nfeCounts.skipped}</div>
      </div>
    </section>

    <section class="rounded-xl border border-navy-700 bg-navy-800/40 overflow-hidden">
      <header class="px-5 py-3 border-b border-navy-700 flex items-baseline justify-between">
        <h2 class="text-sm font-medium uppercase tracking-[0.12em] text-navy-200">Últimos 50 pedidos</h2>
      </header>
      {(orders ?? []).length === 0 ? (
        <div class="px-5 py-10 text-center text-sm text-navy-300">
          Nenhum pedido sincronizado ainda. Faça uma compra de teste no site.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-navy-300 border-b border-navy-700">
              <tr>
                <th class="text-left px-4 py-2">Criado</th>
                <th class="text-left px-4 py-2">MP Payment</th>
                <th class="text-left px-4 py-2">Pedido Bling</th>
                <th class="text-left px-4 py-2">Status</th>
                <th class="text-left px-4 py-2">NF-e</th>
                <th class="text-left px-4 py-2">Tentativas</th>
                <th class="text-left px-4 py-2">Erro / Ação</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-700/60">
              {(orders ?? []).map((r: any) => (
                <tr>
                  <td class="px-4 py-2 text-navy-200 whitespace-nowrap">{fmtDate(r.created_at)}</td>
                  <td class="px-4 py-2 font-mono text-xs">{r.mp_payment_id}</td>
                  <td class="px-4 py-2 font-mono text-xs">
                    {r.bling_pedido_numero ? `#${r.bling_pedido_numero}` : r.bling_pedido_id ?? "—"}
                  </td>
                  <td class="px-4 py-2">
                    {r.status === "synced" && (
                      <span class="inline-flex items-center rounded-full bg-green-500/20 text-green-300 px-2 py-0.5 text-[11px]">synced</span>
                    )}
                    {r.status === "failed" && (
                      <span class="inline-flex items-center rounded-full bg-red-500/20 text-red-300 px-2 py-0.5 text-[11px]">failed</span>
                    )}
                    {r.status === "pending" && (
                      <span class="inline-flex items-center rounded-full bg-amber-500/20 text-amber-300 px-2 py-0.5 text-[11px]">pending</span>
                    )}
                    {r.status === "skipped" && (
                      <span class="inline-flex items-center rounded-full bg-navy-600 text-navy-200 px-2 py-0.5 text-[11px]">skipped</span>
                    )}
                  </td>
                  <td class="px-4 py-2 text-xs">
                    {r.nfe_status === "emitted" && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-green-500/20 text-green-300 px-2 py-0.5">
                        📄 {r.bling_nfe_numero ?? "—"}
                      </span>
                    )}
                    {r.nfe_status === "failed" && (
                      <span class="inline-flex items-center rounded-full bg-red-500/20 text-red-300 px-2 py-0.5" title={r.nfe_error ?? ""}>⚠ falhou</span>
                    )}
                    {r.nfe_status === "pending" && (
                      <span class="inline-flex items-center rounded-full bg-amber-500/20 text-amber-300 px-2 py-0.5">⏳ processando</span>
                    )}
                    {r.nfe_status === "skipped" && (
                      <span class="inline-flex items-center rounded-full bg-navy-600 text-navy-200 px-2 py-0.5" title={r.nfe_error ?? ""}>—</span>
                    )}
                    {!r.nfe_status && <span class="text-navy-400">—</span>}
                  </td>
                  <td class="px-4 py-2 text-navy-300">{r.attempt_count ?? 0}</td>
                  <td class="px-4 py-2 text-xs text-navy-300 max-w-xl">
                    {r.status === "failed" || r.status === "pending" ? (() => {
                      const e = splitError(r.error);
                      return (
                        <div class="flex items-start gap-2">
                          <div class="min-w-0 flex-1">
                            <div class="text-red-300/80 break-words">{e.headline}</div>
                            {e.rest && (
                              <details class="mt-1">
                                <summary class="cursor-pointer text-navy-400 hover:text-navy-200 text-[10px] uppercase tracking-wider">
                                  ver detalhes do erro ({e.rest.length})
                                </summary>
                                <pre class="mt-1 whitespace-pre-wrap text-[11px] text-red-200/70 bg-navy-900/40 rounded p-2">{e.rest.join("\n")}</pre>
                              </details>
                            )}
                          </div>
                          <button
                            type="button"
                            data-retry-mp-payment={r.mp_payment_id}
                            class="shrink-0 rounded bg-brand-lime/90 text-navy-900 px-2 py-1 text-[11px] font-medium hover:bg-brand-lime disabled:opacity-50 disabled:cursor-not-allowed"
                          >
                            Tentar de novo
                          </button>
                        </div>
                      );
                    })() : r.status === "synced" && (r.nfe_status === "failed" || r.nfe_status === "skipped" || !r.nfe_status) ? (() => {
                      const e = splitError(r.nfe_error);
                      return (
                        <div class="flex items-start gap-2">
                          <div class="min-w-0 flex-1">
                            <div class="text-red-300/80 break-words">{e.headline}</div>
                            {e.rest && (
                              <details class="mt-1">
                                <summary class="cursor-pointer text-navy-400 hover:text-navy-200 text-[10px] uppercase tracking-wider">
                                  ver detalhes SEFAZ ({e.rest.length})
                                </summary>
                                <pre class="mt-1 whitespace-pre-wrap text-[11px] text-red-200/70 bg-navy-900/40 rounded p-2">{e.rest.join("\n")}</pre>
                              </details>
                            )}
                          </div>
                          <button
                            type="button"
                            data-retry-nfe-payment={r.mp_payment_id}
                            class="shrink-0 rounded bg-amber-400/90 text-navy-900 px-2 py-1 text-[11px] font-medium hover:bg-amber-400 disabled:opacity-50 disabled:cursor-not-allowed"
                          >
                            Emitir NF-e
                          </button>
                        </div>
                      );
                    })() : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>

  <script>
    // POST via fetch with JSON content-type to bypass Astro's form CSRF check
    // (which only triggers for form-encoded content types). Endpoint redirects
    // to /admin/bling?bling=... — fetch follows the redirect, then we navigate
    // the window to that final URL so the operator sees the flash banner.
    function bindRetry(attr: string, endpointPrefix: string, busyLabel: string) {
      document.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute(attr) ?? "";
          if (!id) return;
          const originalText = btn.textContent;
          btn.disabled = true;
          btn.textContent = busyLabel;
          try {
            const res = await fetch(`${endpointPrefix}/${encodeURIComponent(id)}`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
            });
            window.location.href = res.url || "/admin/bling";
          } catch (e) {
            btn.disabled = false;
            btn.textContent = originalText;
            alert("Erro: " + (e instanceof Error ? e.message : String(e)));
          }
        });
      });
    }
    bindRetry("data-retry-mp-payment", "/api/admin/bling/retry", "Sincronizando…");
    bindRetry("data-retry-nfe-payment", "/api/admin/bling/retry-nfe", "Emitindo NF-e…");

    // Naturezas de operação loader — fetches Bling cadastros to expose IDs
    // (the Bling dashboard hides them from non-developer users).
    const loadBtn = document.getElementById("load-naturezas") as HTMLButtonElement | null;
    const result = document.getElementById("naturezas-result");
    if (loadBtn && result) {
      loadBtn.addEventListener("click", async () => {
        loadBtn.disabled = true;
        loadBtn.textContent = "Carregando…";
        result.innerHTML = '<span class="text-navy-400">Carregando do Bling…</span>';
        try {
          const res = await fetch("/api/admin/bling/naturezas", {
            headers: { Accept: "application/json" },
          });
          const data = await res.json();
          if (!res.ok) {
            result.innerHTML = `<span class="text-red-300">Erro: ${data.error ?? res.statusText}</span>`;
            return;
          }
          const items: Array<{ id: number; descricao?: string; cfop?: string; tipo?: number; situacao?: number }> = data.naturezas ?? [];
          if (items.length === 0) {
            result.innerHTML = '<span class="text-amber-300">Nenhuma natureza de operação encontrada no teu Bling.</span>';
            return;
          }
          const rows = items
            .map((n) => {
              const tipo = n.tipo === 1 ? "Saída" : n.tipo === 0 ? "Entrada" : "—";
              const ativa = n.situacao === 1 ? "Ativa" : "Inativa";
              const desc = (n.descricao ?? "").replace(/</g, "&lt;");
              const cfop = n.cfop ? `<span class="text-navy-400">CFOP ${n.cfop}</span>` : "";
              return `
                <tr class="hover:bg-navy-700/30">
                  <td class="px-3 py-2 font-mono text-brand-lime">${n.id}</td>
                  <td class="px-3 py-2">${desc}</td>
                  <td class="px-3 py-2 text-xs text-navy-300">${tipo}</td>
                  <td class="px-3 py-2 text-xs text-navy-300">${ativa}</td>
                  <td class="px-3 py-2 text-xs">${cfop}</td>
                  <td class="px-3 py-2"><button type="button" data-copy-id="${n.id}" class="rounded bg-brand-lime/20 hover:bg-brand-lime/40 text-brand-lime px-2 py-0.5 text-[11px]">Copiar ID</button></td>
                </tr>
              `;
            })
            .join("");
          result.innerHTML = `
            <div class="overflow-x-auto rounded border border-navy-700">
              <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wider text-navy-300 border-b border-navy-700">
                  <tr>
                    <th class="text-left px-3 py-2">ID</th>
                    <th class="text-left px-3 py-2">Descrição</th>
                    <th class="text-left px-3 py-2">Tipo</th>
                    <th class="text-left px-3 py-2">Situação</th>
                    <th class="text-left px-3 py-2">CFOP</th>
                    <th class="text-left px-3 py-2"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-navy-700/60">${rows}</tbody>
              </table>
            </div>
            <p class="mt-2 text-xs text-navy-400">Saídas ativas aparecem primeiro. Pega o ID da que tu usou na NF #19 da Thawant — geralmente "Venda de mercadoria a não contribuinte".</p>
          `;
          // Wire copy buttons
          result.querySelectorAll<HTMLButtonElement>("[data-copy-id]").forEach((b) => {
            b.addEventListener("click", async () => {
              const id = b.getAttribute("data-copy-id") ?? "";
              try {
                await navigator.clipboard.writeText(id);
                const orig = b.textContent;
                b.textContent = "Copiado ✓";
                setTimeout(() => (b.textContent = orig), 1500);
              } catch {
                window.prompt("Copia o ID:", id);
              }
            });
          });
        } catch (e) {
          result.innerHTML = `<span class="text-red-300">Falha: ${e instanceof Error ? e.message : String(e)}</span>`;
        } finally {
          loadBtn.disabled = false;
          loadBtn.textContent = "Carregar lista";
        }
      });
    }

    // Audit + repair de produtos Bling. Lista produtos do Bling, classifica
    // (canônico site / legado marketplace), e oferece botão de "Anexar
    // imagem" por linha que chama PUT /produtos/{id} via /api/admin/bling/repair-product.
    const auditBtn = document.getElementById("audit-products-btn") as HTMLButtonElement | null;
    const auditResult = document.getElementById("audit-products-result");
    if (auditBtn && auditResult) {
      type AuditedProduct = {
        id: number;
        codigo?: string;
        nome: string;
        preco?: number;
        situacao?: string;
        category: "canonical-site" | "marketplace-legacy" | "unknown";
        hasImage: boolean;
        imageCount: number;
        suggestedImageUrl: string | null;
        notes: string[];
      };

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"]/g, (c) =>
          c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : "&quot;",
        );
      }

      function badgeFor(category: AuditedProduct["category"]): string {
        switch (category) {
          case "canonical-site":
            return '<span class="rounded bg-green-500/20 text-green-300 px-1.5 py-0.5 text-[10px] uppercase tracking-wider">site</span>';
          case "marketplace-legacy":
            return '<span class="rounded bg-amber-500/20 text-amber-300 px-1.5 py-0.5 text-[10px] uppercase tracking-wider">legado</span>';
          default:
            return '<span class="rounded bg-navy-700 text-navy-300 px-1.5 py-0.5 text-[10px] uppercase tracking-wider">?</span>';
        }
      }

      function renderRow(p: AuditedProduct): string {
        const codigo = p.codigo ? `<span class="font-mono text-brand-lime">${escapeHtml(p.codigo)}</span>` : '<span class="text-navy-500">—</span>';
        const preco = p.preco != null ? `R$ ${p.preco.toFixed(2).replace(".", ",")}` : "—";
        const sit = p.situacao === "A" ? "Ativo" : p.situacao === "I" ? "Inativo" : (p.situacao ?? "—");
        const imgCell = p.hasImage
          ? `<span class="text-green-300">${p.imageCount}</span>`
          : `<span class="text-red-300">0</span>`;
        const action = !p.hasImage && p.suggestedImageUrl
          ? `<button type="button" data-attach-id="${p.id}" data-attach-url="${escapeHtml(p.suggestedImageUrl)}" class="rounded bg-brand-lime/20 hover:bg-brand-lime/40 text-brand-lime px-2 py-0.5 text-[11px]">Anexar imagem</button>`
          : p.suggestedImageUrl
          ? `<button type="button" data-attach-id="${p.id}" data-attach-url="${escapeHtml(p.suggestedImageUrl)}" class="rounded bg-navy-700 hover:bg-navy-600 text-navy-200 px-2 py-0.5 text-[11px]">+ outra</button>`
          : `<span class="text-navy-500 text-[11px]">sem sugestão</span>`;
        const notes = p.notes.length > 0
          ? `<div class="mt-1 text-[10px] text-navy-400">${p.notes.map(escapeHtml).join(" · ")}</div>`
          : "";
        return `
          <tr class="hover:bg-navy-700/30" data-product-row="${p.id}">
            <td class="px-3 py-2">${badgeFor(p.category)}</td>
            <td class="px-3 py-2">${codigo}</td>
            <td class="px-3 py-2">${escapeHtml(p.nome)}${notes}</td>
            <td class="px-3 py-2 text-right">${preco}</td>
            <td class="px-3 py-2 text-xs text-navy-300">${sit}</td>
            <td class="px-3 py-2 text-center">${imgCell}</td>
            <td class="px-3 py-2">${action}</td>
          </tr>
        `;
      }

      function wireAttachButtons(): void {
        auditResult!.querySelectorAll<HTMLButtonElement>("[data-attach-id]").forEach((b) => {
          b.addEventListener("click", async () => {
            const id = b.getAttribute("data-attach-id") ?? "";
            const url = b.getAttribute("data-attach-url") ?? "";
            const orig = b.textContent;
            b.disabled = true;
            b.textContent = "Anexando…";
            try {
              const res = await fetch(`/api/admin/bling/repair-product/${id}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ imageUrl: url }),
              });
              const data = await res.json().catch(() => ({}));
              if (!res.ok) {
                const errMsg = (data && (data.error || data.message)) ?? `HTTP ${res.status}`;
                b.textContent = "Falha";
                b.title = String(errMsg).slice(0, 400);
                b.classList.add("text-red-300");
                console.error("[repair]", id, errMsg, data);
                // Mostra detalhe inline em uma linha extra
                const row = auditResult!.querySelector(`[data-product-row="${id}"]`);
                const cell = row?.querySelector("td:nth-child(3)");
                if (cell && !cell.querySelector(".repair-err")) {
                  const div = document.createElement("div");
                  div.className = "repair-err mt-1 text-[10px] text-red-300";
                  div.textContent = `erro: ${String(errMsg).slice(0, 200)}`;
                  cell.appendChild(div);
                }
                setTimeout(() => {
                  b.textContent = orig;
                  b.classList.remove("text-red-300");
                  b.disabled = false;
                }, 2500);
                return;
              }
              b.textContent = `OK (${data.imageCount})`;
              b.classList.remove("bg-brand-lime/20", "hover:bg-brand-lime/40", "text-brand-lime");
              b.classList.add("bg-green-500/30", "text-green-200");
            } catch (err) {
              b.textContent = "Erro";
              b.classList.add("text-red-300");
              console.error("[repair]", err);
              setTimeout(() => {
                b.textContent = orig;
                b.classList.remove("text-red-300");
                b.disabled = false;
              }, 2500);
            }
          });
        });
      }

      auditBtn.addEventListener("click", async () => {
        auditBtn.disabled = true;
        auditBtn.textContent = "Auditando…";
        auditResult.innerHTML = '<span class="text-navy-400">Lendo catálogo do Bling (pode levar 5-10s)…</span>';
        try {
          const res = await fetch("/api/admin/bling/audit-products", {
            headers: { Accept: "application/json" },
          });
          const data = await res.json();
          if (!res.ok) {
            auditResult.innerHTML = `<span class="text-red-300">Erro: ${data.error ?? res.statusText}</span>`;
            return;
          }
          const products: AuditedProduct[] = data.products ?? [];
          const summary = data.summary ?? {};
          if (products.length === 0) {
            auditResult.innerHTML = '<span class="text-amber-300">Nenhum produto cadastrado no Bling.</span>';
            return;
          }
          const rows = products.map(renderRow).join("");
          auditResult.innerHTML = `
            <div class="mb-3 flex flex-wrap gap-2 text-[11px]">
              <span class="rounded bg-navy-700 px-2 py-0.5">${summary.total ?? products.length} total</span>
              <span class="rounded bg-green-500/20 text-green-300 px-2 py-0.5">${summary.canonical_site ?? 0} canônicos</span>
              <span class="rounded bg-amber-500/20 text-amber-300 px-2 py-0.5">${summary.marketplace_legacy ?? 0} legados</span>
              <span class="rounded bg-red-500/20 text-red-300 px-2 py-0.5">${summary.missing_image ?? 0} sem imagem</span>
            </div>
            <div class="overflow-x-auto rounded border border-navy-700">
              <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wider text-navy-300 border-b border-navy-700">
                  <tr>
                    <th class="text-left px-3 py-2">Cat</th>
                    <th class="text-left px-3 py-2">SKU</th>
                    <th class="text-left px-3 py-2">Nome</th>
                    <th class="text-right px-3 py-2">Preço</th>
                    <th class="text-left px-3 py-2">Sit.</th>
                    <th class="text-center px-3 py-2">Imgs</th>
                    <th class="text-left px-3 py-2"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-navy-700/60">${rows}</tbody>
              </table>
            </div>
            <p class="mt-2 text-xs text-navy-400">Botão "Anexar imagem" usa PUT /produtos/{id} no Bling com URL pública do site (Bling baixa e armazena).</p>
          `;
          wireAttachButtons();
        } catch (e) {
          auditResult.innerHTML = `<span class="text-red-300">Falha: ${e instanceof Error ? e.message : String(e)}</span>`;
        } finally {
          auditBtn.disabled = false;
          auditBtn.textContent = "Auditar produtos";
        }
      });
    }

    // ============================================================
    // Sincronização de preços site → Bling (audit + apply)
    // ============================================================
    const auditPricesBtn = document.getElementById("audit-prices-btn") as HTMLButtonElement | null;
    const syncPricesBtn = document.getElementById("sync-prices-btn") as HTMLButtonElement | null;
    const pricesResult = document.getElementById("audit-prices-result");

    if (auditPricesBtn && syncPricesBtn && pricesResult) {
      type PriceRow = {
        blingId: number;
        codigo: string;
        nome: string;
        sourceLabel: string;
        sitePriceBRL: number;
        blingPriceBRL: number | null;
        drifted: boolean;
        diffBRL: number | null;
      };

      function escapeHtml2(s: string): string {
        return s.replace(/[&<>"]/g, (c) =>
          c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : "&quot;",
        );
      }
      function fmtBRL(n: number | null | undefined): string {
        if (n == null) return "—";
        return `R$ ${n.toFixed(2).replace(".", ",")}`;
      }
      function fmtDiff(n: number | null): string {
        if (n == null) return "—";
        const sign = n > 0 ? "+" : "";
        const cls = n > 0 ? "text-green-300" : n < 0 ? "text-red-300" : "text-navy-300";
        return `<span class="${cls}">${sign}${fmtBRL(n)}</span>`;
      }
      function renderPricesTable(rows: PriceRow[], missingInBling: string[]): string {
        const rowsHtml = rows.map((r) => {
          const driftBadge = r.drifted
            ? '<span class="rounded bg-amber-500/20 text-amber-300 px-1.5 py-0.5 text-[10px] uppercase tracking-wider">drift</span>'
            : '<span class="rounded bg-green-500/20 text-green-300 px-1.5 py-0.5 text-[10px] uppercase tracking-wider">ok</span>';
          return `
            <tr class="hover:bg-navy-700/30">
              <td class="px-3 py-2">${driftBadge}</td>
              <td class="px-3 py-2"><span class="font-mono text-brand-lime">${escapeHtml2(r.codigo)}</span></td>
              <td class="px-3 py-2 text-navy-200">${escapeHtml2(r.nome)}<div class="mt-0.5 text-[10px] text-navy-500 font-mono">${escapeHtml2(r.sourceLabel)}</div></td>
              <td class="px-3 py-2 text-right text-navy-300">${fmtBRL(r.blingPriceBRL)}</td>
              <td class="px-3 py-2 text-right font-medium">${fmtBRL(r.sitePriceBRL)}</td>
              <td class="px-3 py-2 text-right">${fmtDiff(r.diffBRL)}</td>
            </tr>
          `;
        }).join("");
        const missingHtml = missingInBling.length > 0
          ? `<p class="mt-3 text-xs text-amber-300">⚠️ SKUs canônicos que ainda não existem no Bling (nunca foram vendidos): <code class="font-mono">${missingInBling.map(escapeHtml2).join(", ")}</code></p>`
          : "";
        return `
          <div class="overflow-x-auto rounded border border-navy-700">
            <table class="w-full text-sm">
              <thead class="text-[11px] uppercase tracking-wider text-navy-300 border-b border-navy-700">
                <tr>
                  <th class="text-left px-3 py-2">Status</th>
                  <th class="text-left px-3 py-2">SKU</th>
                  <th class="text-left px-3 py-2">Nome / Fonte</th>
                  <th class="text-right px-3 py-2">Bling agora</th>
                  <th class="text-right px-3 py-2">Site (alvo)</th>
                  <th class="text-right px-3 py-2">Δ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-navy-700/60">${rowsHtml}</tbody>
            </table>
          </div>
          ${missingHtml}
        `;
      }

      auditPricesBtn.addEventListener("click", async () => {
        auditPricesBtn.disabled = true;
        auditPricesBtn.textContent = "Auditando…";
        pricesResult.innerHTML = '<span class="text-navy-400">Buscando todos os produtos do Bling…</span>';
        syncPricesBtn.classList.add("hidden");
        try {
          const res = await fetch("/api/admin/bling/audit-prices");
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            pricesResult.innerHTML = `<span class="text-red-300">Erro: ${escapeHtml2(data.error ?? res.statusText)}</span>`;
            return;
          }
          const rows: PriceRow[] = data.rows ?? [];
          const summary = data.summary ?? {};
          const missing: string[] = data.missingInBling ?? [];
          if (rows.length === 0) {
            pricesResult.innerHTML = '<span class="text-amber-300">Nenhum produto canônico encontrado no Bling.</span>';
            return;
          }
          pricesResult.innerHTML = `
            <div class="mb-3 flex flex-wrap gap-2 text-[11px]">
              <span class="rounded bg-navy-700 px-2 py-0.5">${summary.total_canonical ?? rows.length} canônicos</span>
              <span class="rounded bg-amber-500/20 text-amber-300 px-2 py-0.5">${summary.drifted ?? 0} com drift</span>
              <span class="rounded bg-green-500/20 text-green-300 px-2 py-0.5">${summary.aligned ?? 0} alinhados</span>
              ${missing.length ? `<span class="rounded bg-navy-700 text-navy-300 px-2 py-0.5">${missing.length} ainda não no Bling</span>` : ""}
            </div>
            ${renderPricesTable(rows, missing)}
          `;
          const driftedCount = summary.drifted ?? 0;
          if (driftedCount > 0) {
            syncPricesBtn.classList.remove("hidden");
            syncPricesBtn.textContent = `Aplicar ${driftedCount} preço${driftedCount === 1 ? "" : "s"} no Bling`;
          }
        } catch (e) {
          pricesResult.innerHTML = `<span class="text-red-300">Falha: ${escapeHtml2(e instanceof Error ? e.message : String(e))}</span>`;
        } finally {
          auditPricesBtn.disabled = false;
          auditPricesBtn.textContent = "Auditar preços";
        }
      });

      syncPricesBtn.addEventListener("click", async () => {
        const proceed = window.confirm(
          "Vai atualizar o preço cadastrado dos produtos drifted no Bling.\nIsso pode propagar pra marketplaces integrados via Bling.\nConfirma?"
        );
        if (!proceed) return;
        syncPricesBtn.disabled = true;
        const orig = syncPricesBtn.textContent;
        syncPricesBtn.textContent = "Aplicando…";
        try {
          const res = await fetch("/api/admin/bling/sync-prices", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({}),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            pricesResult.innerHTML = `<span class="text-red-300">Erro: ${escapeHtml2(data.error ?? res.statusText)}</span>` + (pricesResult.innerHTML || "");
            return;
          }
          const applied = data.applied?.length ?? 0;
          const errors = data.errors?.length ?? 0;
          const summary = errors === 0
            ? `<div class="rounded-lg border border-green-500/40 bg-green-500/10 px-4 py-3 mb-3 text-sm text-green-200">✅ ${applied} preço${applied === 1 ? "" : "s"} sincronizado${applied === 1 ? "" : "s"} no Bling. Rode "Auditar preços" de novo pra confirmar.</div>`
            : `<div class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 mb-3 text-sm text-amber-200">⚠️ ${applied} aplicado(s), ${errors} erro(s): <code>${escapeHtml2(JSON.stringify(data.errors))}</code></div>`;
          pricesResult.innerHTML = summary + pricesResult.innerHTML;
          syncPricesBtn.classList.add("hidden");
        } catch (e) {
          pricesResult.innerHTML = `<span class="text-red-300">Falha: ${escapeHtml2(e instanceof Error ? e.message : String(e))}</span>`;
        } finally {
          syncPricesBtn.disabled = false;
          syncPricesBtn.textContent = orig ?? "Aplicar no Bling";
        }
      });
    }
  </script>
</AdminLayout>

---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Check from "@lucide/astro/icons/check";
import ArrowRight from "@lucide/astro/icons/arrow-right";
---

<BaseLayout
  title="Obrigado! — PR Tracker"
  description="Seu pedido foi confirmado. Em breve você receberá atualizações sobre a produção e o envio."
  noindex
>
  <section class="thanks">
    <div class="container-page thanks__inner">
      <div class="thanks__badge" aria-hidden="true">
        <Check size={48} />
      </div>
      <h1 class="thanks__title" data-thanks-title>Pedido confirmado!</h1>
      <p class="thanks__lead" data-thanks-message>
        Sua compra foi processada com sucesso. Em breve você receberá um e-mail com os detalhes e o link de rastreio quando o produto for enviado.
      </p>

      <div class="thanks__card">
        <h2 class="thanks__card-title">Próximos passos</h2>
        <ol class="thanks__steps">
          <li><strong>Despacho</strong> — em até 2 dias úteis. Estoque a pronta entrega, sem espera de produção.</li>
          <li><strong>Entrega</strong> — enviamos via Correios com código de rastreio. Mandamos por email assim que postarmos.</li>
          <li><strong>Celebre</strong> — receba em casa, desempacote com a adrenalina de um PR, exponha.</li>
        </ol>
      </div>

      <div class="thanks__cta">
        <a href="/" class="btn btn-primary">
          Voltar para a loja
          <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a href="https://wa.me/5551982061914" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Falar no WhatsApp</a>
      </div>

      <p class="thanks__faq">
        Dúvidas sobre prazo, troca ou cuidados com a peça? Veja as <a href="/faq">perguntas frequentes</a>.
      </p>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status");
    const paymentId =
      params.get("payment_id") ?? params.get("collection_id") ?? params.get("p");
    const titleEl = document.querySelector("[data-thanks-title]");
    const msgEl = document.querySelector("[data-thanks-message]");

    function markPending() {
      if (titleEl) titleEl.textContent = "Pagamento em processamento";
      if (msgEl)
        msgEl.textContent =
          "Confirmando seu pagamento com o Mercado Pago. Essa página atualiza sozinha quando tudo for aprovado.";
    }

    function markApproved() {
      if (titleEl) titleEl.textContent = "Pedido confirmado!";
      if (msgEl)
        msgEl.textContent =
          "Sua compra foi processada com sucesso. Em breve você receberá um e-mail com os detalhes e o link de rastreio quando o produto for enviado.";
      attributeTrophyIfPRConversion();
      fireBrowserPurchase();
    }

    // Browser-side Purchase pixel — dispara só quando temos confirmação
    // approved. eventID = payment_id pra Meta deduplicar contra o CAPI
    // (que usa o mesmo String(payment.id) como event_id). sessionStorage
    // guarda o id já disparado pra não duplicar em refresh.
    //
    // Por que browser-side se já tem CAPI? Robustez: se CAPI falhar (timeout,
    // outage), Pixel pega; se Pixel for bloqueado (adblock), CAPI pega.
    // Meta dedup garante que não conta 2x quando ambos chegam.
    let purchaseFired = false;
    function fireBrowserPurchase() {
      if (purchaseFired || !paymentId) return;
      try {
        const key = `pr_purchase_fired_${paymentId}`;
        if (sessionStorage.getItem(key)) {
          purchaseFired = true;
          return;
        }
        sessionStorage.setItem(key, "1");
      } catch {}
      purchaseFired = true;

      const w = window as typeof window & {
        fbq?: (...args: unknown[]) => void;
      };

      fetch(`/api/payment-status?p=${encodeURIComponent(paymentId)}`, {
        cache: "no-store",
      })
        .then((r) => (r.ok ? r.json() : null))
        .then((data: {
          amount?: number;
          content_ids?: string[];
          num_items?: number;
        } | null) => {
          if (!data || typeof data.amount !== "number") return;
          const run = () => {
            if (typeof w.fbq !== "function") return;
            try {
              w.fbq(
                "track",
                "Purchase",
                {
                  value: data.amount,
                  currency: "BRL",
                  content_type: "product",
                  content_ids: data.content_ids ?? [],
                  num_items: data.num_items ?? 1,
                },
                { eventID: String(paymentId) },
              );
            } catch {}
          };
          if (typeof w.fbq === "function") {
            run();
          } else if (typeof window.requestIdleCallback === "function") {
            window.requestIdleCallback(run, { timeout: 5000 });
          } else {
            setTimeout(run, 3500);
          }
        })
        .catch(() => {});
    }

    // Trophy attribution: when the checkout originated from /pr/celebrate,
    // the BarbellConfigurator stashed the pr_records.id in sessionStorage.
    // Stamp it on the record so we can measure PR→trophy conversion.
    let attributionDone = false;
    function attributeTrophyIfPRConversion() {
      if (attributionDone) return;
      let prId: string | null = null;
      try {
        prId = sessionStorage.getItem("pr-trophy-prId");
      } catch {
        return;
      }
      if (!prId || !paymentId) return;
      attributionDone = true;
      fetch(`/api/pr/records/${encodeURIComponent(prId)}/trophy-purchase`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ purchase_id: paymentId, source: "obrigado" }),
        keepalive: true,
      })
        .catch(() => {
          // Network blip — sessionStorage stays so a refresh can retry.
        })
        .finally(() => {
          try {
            sessionStorage.removeItem("pr-trophy-prId");
          } catch {}
        });
    }

    // Approved-on-arrival path: no polling, but we still need to attribute
    // and fire the browser Purchase pixel (dedup w/ CAPI via eventID).
    if (status === "approved" && paymentId) {
      attributeTrophyIfPRConversion();
      fireBrowserPurchase();
    }

    // Se chegamos aqui com status != approved e com um payment_id, fazemos
    // polling. Útil pro caso: cliente pagou Pix, veio pra cá via "Voltar à
    // loja" antes da webhook chegar. A gente confirma na cara.
    if (paymentId && /^\d{6,20}$/.test(paymentId) && status !== "approved") {
      markPending();
      let stopped = false;
      let pollTimer: ReturnType<typeof setInterval> | null = null;

      const poll = async () => {
        try {
          const res = await fetch(
            `/api/payment-status?p=${encodeURIComponent(paymentId)}`,
            { cache: "no-store" },
          );
          const data = await res.json().catch(() => null);
          if (!data) return;
          if (data.status === "approved") {
            stopped = true;
            if (pollTimer) clearInterval(pollTimer);
            markApproved();
            try {
              (window as typeof window & { PRCart?: { clear: () => void } }).PRCart?.clear();
            } catch {}
          } else if (data.status === "rejected" || data.status === "cancelled") {
            stopped = true;
            if (pollTimer) clearInterval(pollTimer);
            if (titleEl) titleEl.textContent = "Pagamento não concluído";
            if (msgEl)
              msgEl.textContent =
                "Seu pagamento não foi aprovado. Tente novamente ou fale com a gente pelo WhatsApp.";
          }
        } catch {
          // Rede instável — tenta de novo no próximo tick.
        }
      };

      poll();
      pollTimer = setInterval(() => {
        if (stopped && pollTimer) {
          clearInterval(pollTimer);
          return;
        }
        poll();
      }, 4000);
    }
  </script>
</BaseLayout>

<style>
  .thanks { padding: 4rem 0 6rem; }
  .thanks__inner {
    max-width: 40rem;
    text-align: center;
  }
  .thanks__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 9999px;
    background: var(--color-brand-lime);
    color: var(--color-brand-navy);
    margin: 0 auto 1.5rem;
    box-shadow: var(--shadow-lime);
    animation: pop 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes pop {
    0% { transform: scale(0.4); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks__badge { animation: none; }
  }
  .thanks__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 2.5vw + 1rem, 3rem);
  }
  .thanks__lead {
    color: var(--color-brand-gray);
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }

  .thanks__card {
    background: var(--color-brand-white);
    border: 1px solid rgb(1 0 42 / 0.08);
    border-radius: var(--radius-card);
    padding: 2rem;
    text-align: left;
    margin: 0 auto 2rem;
    max-width: 32rem;
  }
  .thanks__card-title {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .thanks__steps {
    margin: 0;
    padding: 0 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--color-brand-gray);
    line-height: 1.6;
  }
  .thanks__steps strong { color: var(--color-brand-navy); }

  .thanks__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .thanks__faq {
    margin: 1.75rem auto 0;
    max-width: 32rem;
    color: var(--color-brand-gray);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .thanks__faq a {
    color: var(--color-brand-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-brand-lime);
    text-underline-offset: 3px;
    font-weight: 600;
  }
</style>
